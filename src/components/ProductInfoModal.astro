---
// Generic "plan details" popup for the /hair-loss, /sexual-wellness and
// /longevity product showcases. Replaces the old approach of stuffing
// non-photo "info slides" (What's Included, Clinical Timeline, Discreet
// Shipping, Peptide Therapy Advantages, ...) into the product-photo
// carousel as extra virtual slides sharing its dots/prev/next/thumbnails.
// That worked but meant a photo gallery that intermittently *wasn't*
// photos, and thumbnail strips with mismatched text-label chips mixed in
// among real image thumbs.
//
// This renders both the trigger button and the <dialog> itself so a page
// only has to do <ProductInfoModal sections={...} idSuffix="..." />.
// Built on <dialog>/showModal() rather than a div+z-index, same reasoning
// as QuizModal.astro: top-layer stacking, ::backdrop, Escape-to-close and
// focus-trapping all come free from the platform.
//
// Deliberately NOT a re-skin of .wl-prod__info's plain checklist look —
// this is a tabbed panel (icon-led segmented control across the top,
// content grid below) so it reads as its own distinct surface instead of
// "the carousel slide, but in a box".

export interface InfoItem {
  title: string;
  desc: string;
  /** e.g. hair-loss's Clinical Timeline range chips ("Month 1–2"). When
   *  omitted the item renders the checkmark-tick used by every other
   *  item type instead. */
  badge?: string;
}

export interface InfoSection {
  /** Stable key, also used to look up a default tab icon (see ICONS_BY_ID
   *  below) — pass `icon` to override for any id. */
  id: string;
  /** Short tab label, e.g. "Timeline". */
  label: string;
  /** Section heading shown above its item grid, e.g. "Clinical Timeline". */
  eyebrow: string;
  /** Inline SVG markup (viewBox 0 0 20 20, strokes `currentColor`). Falls
   *  back to a per-id default, then a generic star icon. */
  icon?: string;
  items: InfoItem[];
  /** Optional small print under the item grid (e.g. a results disclaimer). */
  note?: string;
}

interface Props {
  sections: InfoSection[];
  /** Keeps ids unique per page — defensive, even though each page only
   *  ever renders one of these. */
  idSuffix: string;
  triggerLabel?: string;
}

const { sections, idSuffix, triggerLabel = "Plan Details & Shipping" } = Astro.props;

const ICON_INCLUDED =
  '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="10" height="14" rx="2"/><path d="M8 3.5V3a2 2 0 0 1 4 0v.5"/><path d="M7.2 10.6l1.8 1.8 3.8-3.9"/></svg>';
const ICON_TIMELINE =
  '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10.5" r="7"/><path d="M10 6.5V10.5L12.6 12.6"/><path d="M7.5 2h5"/></svg>';
const ICON_SHIPPING =
  '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6.5" width="9" height="7.5"/><path d="M11 8.7h3.1L17 11.4v2.6h-2.4"/><circle cx="6" cy="15.3" r="1.4"/><circle cx="14" cy="15.3" r="1.4"/></svg>';
const ICON_BENEFITS =
  '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5c.5 3 2 4.5 5 5-3 .5-4.5 2-5 5-.5-3-2-4.5-5-5 3-.5 4.5-2 5-5Z"/><path d="M16 13.5c.2 1 .8 1.6 1.8 1.8-1 .2-1.6.8-1.8 1.8-.2-1-.8-1.6-1.8-1.8 1-.2 1.6-.8 1.8-1.8Z"/></svg>';
const DEFAULT_ICON =
  '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.3l1.9 4.6 5 .5-3.8 3.3 1.1 4.9-4.2-2.6-4.2 2.6 1.1-4.9-3.8-3.3 5-.5Z"/></svg>';

// Per-id fallbacks so page frontmatter doesn't have to hand-roll the same
// handful of icons for every section — still fully overridable via
// section.icon.
const ICONS_BY_ID: Record<string, string> = {
  included: ICON_INCLUDED,
  expectedResults: ICON_TIMELINE,
  timeline: ICON_TIMELINE,
  shipping: ICON_SHIPPING,
  benefits: ICON_BENEFITS,
  keyBenefits: ICON_BENEFITS,
};

const dialogId = `pimDialog${idSuffix}`;
const titleId = `pimTitle${idSuffix}`;
---

<div class="pim" data-pim>
  <button
    type="button"
    class="pim__trigger"
    data-pim-open
    aria-haspopup="dialog"
    aria-controls={dialogId}
  >
    <span class="pim__trigger-icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.25"/><path d="M10 9.3v4.1M10 6.7h.01"/></svg>
    </span>
    {triggerLabel}
  </button>

  <dialog class="pim__dialog" id={dialogId} aria-labelledby={titleId} data-pim-dialog>
    <button type="button" class="pim__close" data-pim-close aria-label="Close plan details">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>

    <div class="pim__head">
      <span class="pim__eyebrow">Plan Details</span>
      <h3 id={titleId} class="pim__title">Everything included with your plan</h3>
    </div>

    <div class="pim__tabs" role="tablist">
      {sections.map((s, i) => (
        <button
          type="button"
          class="pim__tab"
          role="tab"
          data-pim-tab={s.id}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`${dialogId}-panel-${s.id}`}
          id={`${dialogId}-tab-${s.id}`}
        >
          <span class="pim__tab-icon" aria-hidden="true" set:html={s.icon || ICONS_BY_ID[s.id] || DEFAULT_ICON} />
          <span>{s.label}</span>
        </button>
      ))}
    </div>

    <div class="pim__panels">
      {sections.map((s, i) => (
        <div
          class="pim__panel"
          data-pim-panel={s.id}
          role="tabpanel"
          id={`${dialogId}-panel-${s.id}`}
          aria-labelledby={`${dialogId}-tab-${s.id}`}
          hidden={i !== 0}
        >
          <span class="pim__panel-eyebrow">{s.eyebrow}</span>
          <div class="pim__list">
            {s.items.map((item) => (
              <div class="pim__item">
                {item.badge ? (
                  <span class="pim__badge">{item.badge}</span>
                ) : (
                  <span class="pim__tick" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  </span>
                )}
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
          {s.note && <p class="pim__note">{s.note}</p>}
        </div>
      ))}
    </div>
  </dialog>
</div>

<style>
  /* ── Trigger ──────────────────────────────────────────────── */
  .pim { margin-top: 14px; }
  .pim__trigger {
    display: inline-flex; align-items: center; gap: 9px;
    background: #fff; border: 1px solid var(--line); border-radius: 999px;
    padding: 11px 20px 11px 14px; font-family: var(--font-sans); font-size: 13.5px; font-weight: 600;
    color: var(--brand); cursor: pointer; text-align: left;
    transition: border-color .15s, background .15s, transform .15s;
  }
  .pim__trigger:hover { border-color: var(--brand); background: rgba(15,107,69,.05); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .pim__trigger:hover { transform: translateY(-1px); } }
  .pim__trigger-icon { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: rgba(15,107,69,.1); color: var(--brand); flex: none; }
  .pim__trigger-icon svg { width: 14px; height: 14px; }
  .pim__trigger:focus-visible,
  .pim__tab:focus-visible,
  .pim__close:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }

  /* ── Dialog shell ─────────────────────────────────────────── */
  .pim__dialog {
    width: min(600px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    margin: auto; padding: 0; border: 0; border-radius: 26px; overflow: hidden;
    background: #fff; color: var(--ink);
    box-shadow: 0 30px 80px rgba(0,0,0,.32);
  }
  /* display must stay scoped to [open] — an unconditional `display: flex`
     would override the UA default `dialog:not([open]) { display: none }`
     (author styles beat UA styles), rendering the closed dialog inline at
     the end of the page instead of hidden until showModal(). */
  .pim__dialog[open] { display: flex; flex-direction: column; }
  .pim__dialog::backdrop { background: rgba(18,60,44,.5); }
  .pim__dialog[open] { animation: pimIn .3s cubic-bezier(.22,.61,.36,1); }
  @keyframes pimIn { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pim__dialog[open] { animation: none; } }
  html:has(dialog.pim__dialog[open]) { overflow: hidden; }

  .pim__close {
    position: absolute; top: 16px; right: 16px; z-index: 2;
    display: grid; place-items: center; width: 34px; height: 34px;
    border: 1px solid var(--line); border-radius: 999px;
    background: rgba(255,255,255,.9); color: var(--ink); cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  .pim__close:hover { background: #fff; border-color: var(--brand); color: var(--brand); }

  /* ── Head ─────────────────────────────────────────────────── */
  .pim__head { flex: none; padding: 30px 56px 18px 30px; background: linear-gradient(180deg, var(--card), #fff); }
  .pim__eyebrow { display: block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--brand); margin-bottom: 8px; }
  .pim__title { font-family: var(--font-serif); font-weight: 600; font-size: 1.35rem; line-height: 1.2; margin: 0; color: var(--ink); }

  /* ── Tabs — icon-led segmented control ───────────────────── */
  .pim__tabs { flex: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0 24px; margin-top: -6px; position: relative; z-index: 1; }
  .pim__tab {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--cream); border: 1px solid transparent; border-radius: 999px;
    padding: 9px 16px 9px 10px; font-family: var(--font-sans); font-size: 13px; font-weight: 600;
    color: var(--muted); cursor: pointer; transition: background .18s, color .18s, box-shadow .18s;
  }
  .pim__tab-icon { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: none; }
  .pim__tab-icon svg { width: 14px; height: 14px; }
  .pim__tab[aria-selected="true"] { background: var(--brand); color: #fff; box-shadow: 0 8px 18px rgba(15,107,69,.25); }
  .pim__tab:not([aria-selected="true"]):hover { background: var(--card); color: var(--ink); }

  /* ── Panels ───────────────────────────────────────────────── */
  .pim__panels { flex: 1 1 auto; overflow-y: auto; padding: 22px 30px 28px; }
  .pim__panel-eyebrow { display: block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
  .pim__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 12px; }
  .pim__item {
    display: flex; align-items: flex-start; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 14px;
    transition: border-color .15s, box-shadow .15s, transform .15s;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pim__item:hover { border-color: var(--brand); box-shadow: 0 10px 24px rgba(15,107,69,.1); transform: translateY(-2px); }
  }
  .pim__tick { flex: none; margin-top: 1px; width: 24px; height: 24px; border-radius: 999px; background: var(--brand); display: grid; place-items: center; }
  .pim__badge {
    flex: none; height: 23px; margin-top: 1px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--gold); color: #fff; font-family: var(--font-condensed); font-size: 10.5px; font-weight: 700;
    letter-spacing: .02em; padding: 0 10px; border-radius: 999px; white-space: nowrap;
  }
  .pim__item h4 { font-size: 13.5px; font-weight: 600; margin: 0 0 3px; color: var(--ink); }
  .pim__item p { font-size: 12.5px; color: var(--muted); margin: 0; line-height: 1.4; }
  .pim__note { font-size: 11.5px; color: var(--muted); margin: 14px 0 0; }

  @media (max-width: 480px) {
    .pim__head { padding: 24px 50px 16px 20px; }
    .pim__title { font-size: 1.15rem; }
    .pim__tabs { padding: 0 16px; }
    .pim__panels { padding: 18px 20px 22px; }
    .pim__list { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Delegated setup so every .pim on a page (defensively — each page only
  // ever renders one) wires itself up independently: open/close, tab
  // switching, and backdrop-click dismissal.
  document.querySelectorAll<HTMLElement>("[data-pim]").forEach((root) => {
    const openBtn = root.querySelector<HTMLButtonElement>("[data-pim-open]");
    const dlg = root.querySelector<HTMLDialogElement>("[data-pim-dialog]");
    if (!openBtn || !dlg || typeof dlg.showModal !== "function") return;

    const closeBtn = root.querySelector<HTMLButtonElement>("[data-pim-close]");
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-pim-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-pim-panel]");

    function selectTab(id: string | null) {
      tabs.forEach((t) => {
        t.setAttribute("aria-selected", t.getAttribute("data-pim-tab") === id ? "true" : "false");
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-pim-panel") !== id;
      });
      dlg.querySelector(".pim__panels")?.scrollTo({ top: 0 });
    }

    tabs.forEach((t) => {
      t.addEventListener("click", () => selectTab(t.getAttribute("data-pim-tab")));
    });

    openBtn.addEventListener("click", () => dlg.showModal());
    closeBtn?.addEventListener("click", () => dlg.close());
    // Clicks land on the dialog element itself only when they hit the
    // backdrop (the dialog's own content never bubbles a click target of
    // `dlg` — it bubbles the element actually clicked).
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>
