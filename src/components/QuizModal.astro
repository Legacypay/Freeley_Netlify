---
// The free-assessment quiz in a modal, ported from index.astro's #quiz--modal.
//
// It is a component because two standalone pages need it (/preview and
// /compare) and neither loads public/global.css, where the original modal's
// styles live.
//
// Built on <dialog>, not a div with a z-index: showModal() gives the top layer,
// ::backdrop, Escape-to-close, focus trapping and inert background content for
// free. The original hand-rolled all of that except the focus trap, which it
// simply did not have.
//
// Progressive enhancement on purpose: the CTAs stay real <a href="/assessment-
// quiz"> links and the script intercepts the click. With JS broken the visitor
// still reaches the quiz page instead of pressing a dead button — which is what
// would happen had these been <button>s.
---

<dialog class="qm" id="quizModal" aria-label="Free assessment">
  <button type="button" class="qm__close" aria-label="Close assessment">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <div class="qm__loader" aria-hidden="true"></div>
  <div class="qm__frame"></div>
</dialog>

<style is:inline>
  /* Namespaced rather than scoped: the iframe is created at runtime, so it would
     never carry Astro's scoping attribute and .qm iframe would silently miss. */
  .qm {
    /* 760, not 940: the quiz page lays out to about 710px, so a wider dialog just
       added white gutters either side of it. */
    width: min(760px, calc(100vw - 28px));
    /* Without this cap the dialog grows to the iframe's full height, the
       browser centers the oversized box on the page, and it overflows both
       top and bottom of the viewport — dragging the close button (anchored
       to the dialog's own top edge) off-screen above the fold. Capping here
       and letting .qm__frame scroll internally keeps the whole dialog,
       close button included, inside the visible viewport at all times. */
    max-height: calc(100vh - 32px);
    /* Restores the UA default centering technique (dialog:modal { inset:0;
       margin:auto }): pages that load Tailwind (src/styles/tailwind.css,
       via Layout.astro) get its Preflight reset — `*, ::backdrop { margin:
       0 }` — which zeroes this out. Author styles always beat UA styles
       regardless of specificity, so without restating it here the dialog
       pins to the top-left instead of centering. /prototype and /compare
       don't load Layout.astro/Tailwind, so they never hit this — only the
       pages that do (weight-loss, hair-loss, etc.) showed it. */
    margin: auto;
    padding: 0; border: 0; border-radius: 22px; overflow: hidden;
    background: #fff; color: inherit;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .32);
  }
  /* display must stay scoped to [open]: an unconditional `display: flex` on
     .qm would override the UA default `dialog:not([open]) { display: none }`
     (author styles always win over UA styles) — the closed dialog would then
     render in normal flow at the end of <body>, i.e. sitting visibly right
     after the footer instead of staying hidden until showModal(). */
  .qm[open] { display: flex; flex-direction: column; }
  .qm::backdrop { background: rgba(18, 60, 44, .55); }
  .qm[open] { animation: qmIn .28s cubic-bezier(.22, .61, .36, 1); }
  @keyframes qmIn { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .qm[open] { animation: none; } }

  .qm__close {
    position: absolute; top: 14px; right: 14px; z-index: 2;
    display: grid; place-items: center; width: 34px; height: 34px;
    border: 1px solid rgba(0, 0, 0, .12); border-radius: 999px;
    background: rgba(255, 255, 255, .92); color: #1a1c1a; cursor: pointer;
  }
  .qm__close:hover { background: #fff; border-color: rgba(0, 0, 0, .28); }
  .qm__close:focus-visible { outline: 2px solid var(--focus, #0f6b45); outline-offset: 2px; }

  /* No fixed height here on purpose: the quiz used to load in an <iframe>,
     an isolated document whose content height the parent can't see — hence
     the old hardcoded height guess. It's injected directly into this DOM
     now (see the script below), so it gets real, auto-sizing layout height;
     .qm's own max-height + this overflow-y:auto are what cap it. */
  .qm__frame { flex: 1 1 auto; overflow-y: auto; min-height: 320px; }
  /* .quiz-popup (public/style/quizstyle.css) is authored for the standalone
     /assessment-quiz page: max-width:750px + margin:0 auto centers it in an
     otherwise-unconstrained <body>. Cloned into this ~760px-wide dialog
     (background #fff) that gap becomes a visible white seam against the
     quiz's own cream hero background — invisible on the standalone page,
     obvious here. Fill the frame exactly instead of centering with a gap. */
  .qm__frame .quiz-popup { max-width: none; margin: 0; }

  .qm__loader {
    position: absolute; top: 50%; left: 50%; width: 34px; height: 34px;
    margin: -17px 0 0 -17px;
    border: 2.5px solid rgba(15, 107, 69, .18);
    border-top-color: var(--brand, #0f6b45);
    border-radius: 50%;
    animation: qmSpin .8s linear infinite;
  }
  .qm__loader[hidden] { display: none; }
  @keyframes qmSpin { to { transform: rotate(360deg); } }

  /* showModal() makes the page behind inert but does not stop it scrolling. */
  html.qm-open, html.qm-open body { overflow: hidden; }
</style>

<script is:inline>
  (function () {
    var dlg = document.getElementById('quizModal');
    if (!dlg || typeof dlg.showModal !== 'function') return;

    var frame = dlg.querySelector('.qm__frame');
    var loader = dlg.querySelector('.qm__loader');
    // Fetched and parsed once, then cloned into the frame on every open —
    // the markup is static, no need to refetch it each time. Replaces the
    // old <iframe src="/assessment-quiz?t="+Date.now()>: that forced a fresh
    // iframe realm (and a network round-trip) on every open purely to reset
    // state, which asw.js's initFreeleyQuiz() now does explicitly instead.
    var quizTemplate = null;

    function addStylesheetOnce(href) {
      if (document.querySelector('link[href="' + href + '"]')) return;
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    }

    function destroy() {
      // Only the cloned markup is removed — never the asw.js <script> tag or
      // the stylesheets. asw.js declares top-level const/let (PRODUCTS,
      // selectedProducts, ...); a classic script parsed twice in the same
      // document throws "Identifier already declared", so it's loaded once
      // per page and its exposed window.initFreeleyQuiz() is what re-runs
      // setup on every subsequent open instead.
      frame.replaceChildren();
    }

    function runQuiz() {
      var clone = quizTemplate.cloneNode(true);
      frame.appendChild(clone);
      if (window.initFreeleyQuiz) {
        window.initFreeleyQuiz();
      } else {
        // No 'load' listener here: asw.js self-invokes initFreeleyQuiz() at its
        // own bottom once document.readyState isn't 'loading' — which it never
        // is by the time this dynamically-injected script runs. Calling it
        // again here double-bound every .option--item's click listener, so a
        // multi-select toggle click fired twice and canceled itself out.
        var script = document.createElement('script');
        script.src = '/quiz-scripts/asw.js';
        document.body.appendChild(script);
      }
      loader.hidden = true;
    }

    function open() {
      destroy();
      loader.hidden = false;
      addStylesheetOnce('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');
      addStylesheetOnce('/style/quizstyle.css');

      if (quizTemplate) {
        runQuiz();
      } else {
        fetch('/assessment-quiz')
          .then(function (res) { return res.text(); })
          .then(function (html) {
            // DOMParser-created documents have base URI about:blank, not this
            // page's origin — root-relative src="/assets/..." attributes
            // (the badge images, product placeholder) fail to resolve
            // against it and ship as broken images. Rewrite them to
            // absolute URLs against the real origin before cloning.
            var doc = new DOMParser().parseFromString(html, 'text/html');
            quizTemplate = doc.querySelector('.quiz-popup');
            quizTemplate.querySelectorAll('img[src^="/"]').forEach(function (img) {
              img.setAttribute('src', location.origin + img.getAttribute('src'));
            });

            // asw.js's saveLeadToSupabase() reads window.supabase /
            // window.__SUPABASE_URL__ / window.__SUPABASE_ANON_KEY__, set by
            // two <script> tags in assessment-quiz.astro's own <head> — not
            // part of .quiz-popup, so cloning only that div never carries
            // them over. Without this, every quiz save silently no-ops
            // (getSupabaseClient() returns null) on every page that opens
            // the quiz through this modal instead of the standalone page.
            // Copied from this same fetch response rather than hardcoding
            // the values a second time.
            if (!window.__SUPABASE_URL__) {
              doc.querySelectorAll('script').forEach(function (tag) {
                var src = tag.getAttribute('src') || '';
                var isSdk = src.indexOf('supabase-js') !== -1;
                var isConfig = tag.textContent.indexOf('__SUPABASE_URL__') !== -1;
                if (!isSdk && !isConfig) return;
                var clone = document.createElement('script');
                if (isSdk) clone.src = src;
                else clone.textContent = tag.textContent;
                document.head.appendChild(clone);
              });
            }

            runQuiz();
          });
      }

      dlg.showModal();
      document.documentElement.classList.add('qm-open');
    }

    dlg.addEventListener('close', function () {
      destroy();
      loader.hidden = true;
      document.documentElement.classList.remove('qm-open');
    });
    dlg.querySelector('.qm__close').addEventListener('click', function () { dlg.close(); });
    // Clicks land on the dialog element itself only when they hit the backdrop.
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });

    // Delegated, not one listener per link. querySelectorAll() only ever saw
    // the links present at load, so any CTA rendered later via innerHTML
    // (the /hub panels do exactly that) kept its real href and navigated
    // away instead of opening the modal. Delegation covers both.
    document.addEventListener('click', function (e) {
      // Both forms: under /preview/* the preview-aware scripts (Header.astro,
      // Layout.astro) rewrite nav hrefs to "/preview/assessment-quiz", which
      // the bare prefix selector no longer matched — so on preview pages the
      // nav CTA did a real navigation instead of opening this modal.
      var a = e.target && e.target.closest && e.target.closest('a[href^="/assessment-quiz"], a[href^="/preview/assessment-quiz"]');
      if (!a) return;
      // Leave modified clicks alone so "open in new tab" still works.
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open();
    });

    // The shared header CTA (src/components/Header.astro) stays a <button>
    // rather than an <a> — it's shared with pages that still run their own
    // legacy #quiz--modal (e.g. index.astro) and turning it into a real link
    // would fire that page's un-guarded click handler AND a real navigation.
    // Wire it here instead, only on pages that render this component.
    var headerCta = document.getElementById('start-assessment-header');
    if (headerCta) headerCta.addEventListener('click', function () { open(); });
  })();
</script>
