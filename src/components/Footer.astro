---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/freeley_logo_transparent_white.webp';

// Mirrors /prototype's <footer class="foot"> exactly (the Impeccable
// direction's site-wide chrome source of truth) instead of the older,
// differently-structured footer this component used to render.
const currentYear = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <Image src={logoWhite} alt="Freeley" class="foot__logo" />
      <p>Physician-prescribed, doctor-guided care — compounded by licensed U.S. pharmacies and delivered to your door.</p>
    </div>
    <div class="foot__col">
      <h3>Treatments</h3>
      <a href="/weight-loss">GLP-1 Weight Loss</a>
      <a href="/sexual-wellness">Sexual Wellness</a>
      <a href="/hair-loss">Hair Loss</a>
      <a href="/longevity">Longevity &amp; Peptides</a>
    </div>
    <div class="foot__col">
      <h3>Company</h3>
      <a href="/how-it-works">How It Works</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About Us</a>
      <a href="/partner-pharmacies">Partner Pharmacies</a>
    </div>
    <div class="foot__col">
      <h3>Legal</h3>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="/hipaa">HIPAA Notice</a>
      <a href="/telehealth-consent">Telehealth Consent</a>
    </div>
  </div>
  <div class="wrap foot__bottom">
    <span>© {currentYear} Freeley. All rights reserved.</span>
    <span class="disc">Freeley does not manufacture compounded medications. Product images are illustrative; actual medication appearance and labeling will differ.</span>
  </div>
</footer>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
  .foot { background: var(--green-deep); color: rgba(255, 255, 255, .75); }
  .foot__grid { display: grid; gap: 34px; grid-template-columns: 1fr; padding-top: 56px; padding-bottom: 34px; }
  @media (min-width: 780px) { .foot__grid { grid-template-columns: 1.7fr 1fr 1fr 1fr; } }
  .foot__logo { height: 30px; width: auto; opacity: .95; }
  /* global.css's unlayered `p { color: #17222A }` directly matches this p,
     so it beats .foot's inherited rgba(255,255,255,.75) — inheritance
     always loses to any directly-matching declaration, no matter how weak
     its specificity. Restated here unlayered, same fix already used for
     .footer--header p elsewhere in the codebase. */
  .foot__brand p { color: rgba(255, 255, 255, .75); font-size: 14px; max-width: 260px; margin: 16px 0 0; line-height: 1.6; }
  .foot__col h3 { color: #fff; font-size: 13px; font-weight: 600; letter-spacing: .04em; margin: 0 0 14px; }
  .foot__col a { display: block; color: rgba(255, 255, 255, .7); text-decoration: none; font-size: 14px; padding: 6px 0; }
  .foot__col a:hover { color: #fff; }
  .foot__bottom { border-top: 1px solid rgba(255, 255, 255, .12); padding-top: 22px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 10px 32px; justify-content: space-between; }
  .foot__bottom span { font-size: 12px; color: rgba(255, 255, 255, .55); }
  .foot__bottom .disc { max-width: 640px; font-family: var(--font-condensed); letter-spacing: 0.015em; }
</style>
