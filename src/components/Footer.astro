---
import { Image } from 'astro:assets';
import trustPilot from '../assets/badges/trust_pilot.png';
import legitScript from '../assets/badges/49921676.png';
import hipaaBadge from '../assets/badges/hipaa_badge.png';
import usaBadge from '../assets/badges/usa_badge.png';
import logoWhite from '../assets/brand/freeley_logo_transparent_white.webp';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-fluid">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-6 mb-6">
      <div class="md:col-span-6 lg:col-span-3">
        <a href="/" aria-label="Freeley home">
          <Image src={logoWhite} alt="Freeley" width={160} class="mb-4" loading="lazy" />
        </a>
        <p class="footer-header-text">
          Healthcare technology connecting patients to licensed physicians and compounding pharmacies — on your terms.
        </p>
        <div class="footer-company-info">
          <p class="mb-2"><strong>Freeley Health LLC</strong></p>
          <p class="mb-2">7700 Camino Real, Suite 400</p>
          <p class="mb-2">Boca Raton, FL 33433</p>
          <p class="mb-2">Email: support@freeley.com</p>
          <p class="mb-2">Phone: +1 (954) 686-6960</p>
        </div>
      </div>
      <div class="md:col-span-6 lg:col-span-6 lg:col-start-4 px-0 md:px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-6">
          <div>
            <div class="footer-column-title">Treatments</div>
            <div class="footer-column-links">
              <a href="/weight-loss" class="footer-link">GLP-1 Weight Loss</a>
              <a href="/hair-loss" class="footer-link">Hair Loss</a>
              <a href="/sexual-wellness" class="footer-link">Sexual Wellness</a>
              <a href="/longevity" class="footer-link">Longevity & Peptides</a>
              <a href="/pricing" class="footer-link">Pricing</a>
            </div>
          </div>
          <div>
            <div class="footer-column-title">Company</div>
            <div class="footer-column-links">
              <a href="/how-it-works" class="footer-link">How it Works</a>
              <a href="/about" class="footer-link">About Freeley</a>
              <a href="/quality-trust" class="footer-link">Quality & Trust</a>
              <a href="/partner-pharmacies" class="footer-link">Partner Pharmacies</a>
              <a href="/blogs" class="footer-link">Blog & Insights</a>
              <a href="/faqs" class="footer-link">FAQ</a>
              <a href="mailto:support@freeley.com" class="footer-link">Contact Us</a>
            </div>
          </div>
        </div>
      </div>
      <div class="md:col-span-6 lg:col-span-3 flex items-end footer-social">
        <button type="button" class="footer-social-icon" aria-label="Instagram">
