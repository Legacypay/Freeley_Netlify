        </button>
        <button type="button" class="footer-social-icon" aria-label="Social media link 5">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path
              d="M12.002 22C6.4791 22 2.00195 17.5228 2.00195 12C2.00195 6.47715 6.4791 2 12.002 2C17.5248 2 22.002 6.47715 22.002 12C22.002 17.5228 17.5248 22 12.002 22ZM18.672 12C18.651 11.425 18.2942 10.916 17.7608 10.7C17.2275 10.4841 16.6171 10.6016 16.202 11C15.0644 10.2267 13.7272 9.7995 12.352 9.77L13.002 6.65L15.142 7.1C15.1945 7.58851 15.5942 7.96647 16.0849 7.99172C16.5755 8.01696 17.0119 7.68201 17.1143 7.20147C17.2167 6.72094 16.9548 6.23719 16.4965 6.06019C16.0382 5.88318 15.5191 6.06536 15.272 6.49L12.822 6C12.741 5.98224 12.6564 5.99763 12.5868 6.04272C12.5173 6.08781 12.4688 6.15886 12.452 6.24L11.712 9.71C10.3199 9.73099 8.96422 10.1585 7.81195 10.94C7.39069 10.5436 6.77515 10.4333 6.24247 10.6588C5.70979 10.8842 5.36041 11.4028 5.35164 11.9812C5.34287 12.5595 5.67635 13.0885 6.20195 13.33C6.19069 13.4765 6.19069 13.6235 6.20195 13.77C6.20195 16.01 8.81195 17.83 12.032 17.83C15.252 17.83 17.862 16.01 17.862 13.77C17.8732 13.6235 17.8732 13.4765 17.862 13.33C18.3656 13.0797 18.6807 12.5623 18.672 12Z"
              fill="white"
            /></svg>
        </button>
      </div>
      <div class="md:col-span-6 lg:col-span-4 lg:col-start-6">
        <div class="footer-verified">
          <div class="footer-verified-title">Verified & Certified</div>
          <div class="footer-badges">
            <Image src={trustPilot} alt="Trustpilot rating" class="footer-badge" loading="lazy" /><Image src={legitScript} alt="LegitScript certification badge" class="footer-badge footer-badge--lg" loading="lazy" /><Image src={hipaaBadge} alt="HIPAA compliance badge" class="footer-badge" loading="lazy" /><Image src={usaBadge}
              alt="USA-based badge" class="footer-badge" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-4">
      <div class="lg:col-span-6">
        <p class="footer-disclaimer-text">
          Freeley is a healthcare technology platform that facilitates connections between patients and independently licensed (telemedicine) providers through our clinical partner, MD Integrations, and PCAB-accredited 503A compounding pharmacies,
          including Strive Pharmacy, available nationwide across all 50 U.S. states. Freeley does not practice medicine, employ physicians, or dispense medications. All treatment decisions and prescriptions are made solely by an independent,
          licensed healthcare provider. Compounded medications are not FDA-approved and are the responsibility of any healthcare providers. Results vary. Freeley eligibility varies.
        </p>
        <div class="footer-legal-links">
          <button type="button" class="footer-legal-link">Privacy Policy</button><span class="footer-legal-sep">·</span><button type="button" class="footer-legal-link">Terms of Service</button><span class="footer-legal-sep">·</span><button type="button" class="footer-legal-link">HIPAA Notice</button><span class="footer-legal-sep">·</span><button type="button" class="footer-legal-link">Telehealth Consent</button>
        </div>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="text-right p-0 md:p-4">
          <p class="footer-disclaimer-text text-left md:text-center">
            © {currentYear} Freeley Health LLC (DBA Freeley) · LegitScript Certified
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
