---
// Secure messaging chat widget (2FA verify -> code -> chat flow). All
// behavior lives in src/lib/hub/chat.ts; this component just renders the
// static chrome and calls initChat() once to wire its own controls.
---

<div id="chatOverlay" class="hub-chat-overlay">
  <div class="hub-chat-drawer">
    <div class="hub-chat-header">
      <div class="hub-chat-header__left">
        <div class="hub-chat-avatar">
          <img id="chatAvatarImg" src="" alt="" style="display:none;" />
          <span id="chatAvatarFallback"><i class="ri-stethoscope-line" aria-hidden="true"></i></span>
        </div>
        <div>
          <div class="hub-chat-name" id="chatHeaderName">Your Care Team</div>
          <div class="hub-chat-role" id="chatHeaderRole">Secure messaging</div>
        </div>
      </div>
      <button type="button" class="hub-chat-close" id="chatCloseBtn" aria-label="Close chat"><i class="ri-close-line" aria-hidden="true"></i></button>
    </div>
    <div class="hub-chat-body" id="chatBody">
      <div class="hub-chat-loading"><i class="ri-loader-4-line" aria-hidden="true"></i> Loading messages...</div>
    </div>
    <div class="hub-chat-footer" id="chatFooter">
      <textarea class="hub-chat-input" id="chatInput" rows="1" placeholder="Type your message..."></textarea>
      <button type="button" class="hub-chat-send" id="chatSendBtn" aria-label="Send message"><i class="ri-send-plane-2-fill" aria-hidden="true"></i></button>
    </div>
  </div>
</div>

<style is:global>
  /* is:global, deliberately: everything inside #chatBody past the initial
     render (verification screens, message bubbles) is rendered via
     innerHTML from src/lib/hub/chat.ts, not by this component's own
     template — Astro's scoped-style attribute only ever reaches elements
     the compiler sees at build time, so a scoped <style> here would
     silently fail to style that injected markup. */
  .hub-chat-overlay { display: none; position: fixed; inset: 0; z-index: 10000; background: rgba(0,0,0,.4); backdrop-filter: blur(2px); opacity: 0; transition: opacity .25s ease; }
  .hub-chat-overlay.is-open { display: flex; justify-content: flex-end; opacity: 1; }
  .hub-chat-drawer { width: 420px; max-width: 100vw; height: 100%; background: #fff; display: flex; flex-direction: column; box-shadow: -4px 0 24px rgba(0,0,0,.18); transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1); }
  .hub-chat-overlay.is-open .hub-chat-drawer { transform: translateX(0); }
  @media (max-width: 480px) { .hub-chat-drawer { width: 100vw; } }
  .hub-chat-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid var(--line); background: var(--green); }
  .hub-chat-header__left { display: flex; align-items: center; gap: 12px; }
  .hub-chat-avatar { width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; flex-shrink: 0; box-shadow: 0 0 0 2px rgba(255,255,255,.28); }
  .hub-chat-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .hub-chat-name { font-family: var(--font-serif); font-weight: 600; font-size: 15px; color: #fff; }
  .hub-chat-role { font-family: var(--font-condensed); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.72); margin-top: 1px; }
  .hub-chat-close { background: none; border: none; font-size: 22px; color: rgba(255,255,255,.8); cursor: pointer; padding: 4px; border-radius: 6px; }
  .hub-chat-close:hover { background: rgba(255,255,255,.14); color: #fff; }
  .hub-chat-body { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .hub-chat-msg { max-width: 82%; padding: 12px 16px; border-radius: 18px; font-size: 13.5px; line-height: 1.55; word-wrap: break-word; }
  .hub-chat-msg--in { align-self: flex-start; background: var(--cream); color: var(--ink); border-bottom-left-radius: 4px; }
  .hub-chat-msg--out { align-self: flex-end; background: var(--brand); color: #fff; border-bottom-right-radius: 4px; }
  .hub-chat-msg-meta { font-size: 10.5px; color: var(--muted); margin-top: 4px; }
  .hub-chat-msg--out .hub-chat-msg-meta { color: rgba(255,255,255,.75); text-align: right; }
  .hub-chat-msg-sender { font-size: 11.5px; font-weight: 700; margin-bottom: 4px; color: var(--ink); }
  .hub-chat-empty, .hub-chat-loading { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: var(--muted); gap: 8px; padding: 40px 20px; font-size: 13.5px; }
  .hub-chat-empty i { font-size: 38px; opacity: .4; }
  /* Every other loading state on this page (Overview/Records/Billing, all
     in src/styles/hub.css) uses the branded .hub-spinner, which actually
     rotates. This drawer's loading icon was a static ri-loader-4-line
     glyph — same icon a spinner uses everywhere else, but not spinning, so
     it read as a stalled/broken state instead of "loading". Reuses
     hub.css's own hubSpin keyframe (global scope, same as this is:global
     block) instead of redefining it. */
  .hub-chat-loading i { font-size: 18px; animation: hubSpin .8s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .hub-chat-loading i { animation: none; } }
  .hub-chat-footer { border-top: 1px solid var(--line); padding: 14px 16px; display: none; gap: 10px; align-items: flex-end; background: #fff; }
  .hub-chat-input { flex: 1; border: 1px solid var(--line); border-radius: 20px; padding: 10px 16px; font-size: 13.5px; font-family: var(--font-sans); resize: none; outline: none; max-height: 120px; line-height: 1.45; }
  .hub-chat-input:focus { border-color: var(--brand); }
  .hub-chat-send { width: 40px; height: 40px; border: none; border-radius: 50%; background: var(--brand); color: #fff; font-size: 17px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .hub-chat-send:hover { background: var(--green-deep); }
  .hub-chat-send:disabled { background: var(--line); cursor: not-allowed; }
  .hub-chat-verify { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 28px; text-align: center; gap: 14px; }
  .hub-chat-verify i { font-size: 42px; color: var(--brand); margin-bottom: 4px; }
  .hub-chat-verify h3 { font-size: 16.5px; font-weight: 700; color: var(--ink); margin: 0; font-family: var(--font-sans); }
  .hub-chat-verify p { font-size: 13px; color: var(--muted); line-height: 1.55; margin: 0; }
  .hub-chat-code-input { width: 200px; padding: 12px 16px; border: 2px solid var(--line); border-radius: 12px; font-size: 20px; font-family: var(--font-sans); text-align: center; letter-spacing: 4px; outline: none; }
  .hub-chat-code-input:focus { border-color: var(--brand); }
  .hub-chat-verify-error { font-size: 12.5px; color: #c62828; margin: 0; }
  .hub-chat-verify-resend { font-size: 12px; color: var(--muted); background: none; border: none; cursor: pointer; text-decoration: underline; padding: 4px; }
  .hub-chat-verify-resend:hover { color: var(--ink); }
</style>

<script>
  import { initChat } from '../../lib/hub/chat';
  initChat();
</script>
