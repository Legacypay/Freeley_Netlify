---
// Sign-in / sign-up form, Google OAuth button, forgot-password link.
// Its own script owns only this screen's DOM — hiding this screen and
// showing the dashboard on successful sign-in is page-level orchestration
// (hub.astro listens for the `hub:auth` event dispatched by
// src/lib/hub/supabase.ts), not this component's concern.
---

<div id="auth-screen" class="hub-auth">
  <div class="hub-auth__card">
    <img src="/assets/brand/freeley_logo_transparent_green.png" alt="Freeley" class="hub-auth__logo" loading="lazy" decoding="async" />
    <h1 class="hub-auth__title" id="authTitle">Welcome back.</h1>
    <p class="hub-auth__sub" id="authSubtitle">Sign in to the Freeley Health Hub to view your medical records, active treatments, and messages.</p>

    <div class="hub-auth__error" id="authError"></div>

    <button type="button" class="hub-google-btn" id="googleBtn">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
      Continue with Google
    </button>

    <div class="hub-auth__divider">or</div>

    <form id="authForm">
      <input type="text" class="hub-input hub-toggle-field" placeholder="Full name" id="authName" />
      <input type="email" class="hub-input" placeholder="Email address" id="loginEmail" required />
      <input type="password" class="hub-input" placeholder="Password (min 6 characters)" id="loginPassword" required minlength="6" />
      <button type="submit" class="hub-auth__submit" id="authBtn">Sign In to Hub</button>
    </form>

    <div class="hub-auth__links">
      <span id="authToggleText">Don't have an account?</span> <button type="button" class="hub-textlink" id="authToggleLink">Create one</button><br />
      <span id="forgotLink">Forgot password? <button type="button" class="hub-textlink" id="forgotPasswordLink">Reset it here</button></span>
    </div>
  </div>
</div>

<style>
  .hub-auth { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--green-deep); padding: 40px 20px; }
  .hub-auth__card { background: #fff; width: 100%; max-width: 440px; border-radius: 24px; padding: 44px 40px; box-shadow: 0 20px 50px rgba(0,0,0,.25); text-align: center; }
  .hub-auth__logo { height: 40px; margin-bottom: 24px; }
  .hub-auth__title { font-family: var(--font-serif); font-weight: 600; font-size: 30px; color: var(--ink); margin-bottom: 8px; }
  .hub-auth__sub { font-size: 14.5px; color: var(--muted); margin-bottom: 28px; line-height: 1.5; }
  .hub-auth__error { display: none; background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; text-align: left; }
  .hub-google-btn { width: 100%; padding: 13px; background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; font-family: var(--font-sans); font-size: 14.5px; font-weight: 600; cursor: pointer; transition: all .2s; display: flex; align-items: center; justify-content: center; gap: 10px; }
  .hub-google-btn:hover { background: var(--card); border-color: var(--brand); }
  .hub-google-btn:disabled { opacity: .6; cursor: default; }
  .hub-auth__divider { display: flex; align-items: center; gap: 16px; margin: 20px 0; color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: 1px; }
  .hub-auth__divider::before, .hub-auth__divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .hub-input { width: 100%; padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px; font-family: var(--font-sans); font-size: 14.5px; margin-bottom: 14px; outline: none; transition: border-color .2s; }
  .hub-input:focus { border-color: var(--brand); }
  .hub-toggle-field { display: none; }
  .hub-auth__submit { width: 100%; padding: 15px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; cursor: pointer; transition: background .2s; margin: 4px 0 22px; }
  .hub-auth__submit:hover { background: var(--green-deep); }
  .hub-auth__submit:disabled { background: var(--line); color: var(--muted); cursor: not-allowed; }
  .hub-auth__links { font-size: 13px; color: var(--muted); line-height: 1.8; }
  /* Plain-text "link" actions use <button> instead of <a href="#">, so the
     sitewide anchor-color trap (`a:not([class*="btn"])`) never enters the
     picture. */
  .hub-textlink { background: none; border: none; padding: 0; cursor: pointer; color: var(--brand); font-weight: 600; font-family: var(--font-sans); font-size: inherit; text-decoration: none; }
  .hub-textlink:hover { text-decoration: underline; }
</style>

<script>
  import { signUp, signIn, googleSignIn, resetPassword } from '../../lib/hub/auth';

  let authMode: 'signin' | 'signup' = 'signin';
  const authToggleLink = document.getElementById('authToggleLink');
  const forgotBtn = document.getElementById('forgotPasswordLink');
  const authForm = document.getElementById('authForm') as HTMLFormElement | null;
  const googleBtn = document.getElementById('googleBtn') as HTMLButtonElement | null;
  const authErrorEl = document.getElementById('authError') as HTMLElement | null;

  function setAuthError(msg: string, ok: boolean) {
    if (!authErrorEl) return;
    authErrorEl.textContent = msg;
    authErrorEl.style.display = 'block';
    // Error red (#fee2e2/#fca5a5/#991b1b) matches checkout.astro's existing
    // form-error box — that's this site's real established error color, not
    // a generic default, so it stays as-is. The success state had no such
    // precedent anywhere else in the codebase; it used Tailwind's stock
    // emerald-100/800 instead of an on-brand tone, so it's realigned here to
    // the same Material green already used twice in hub.css (.hub-badge--ok)
    // rather than inventing a third distinct "positive" green.
    authErrorEl.style.background = ok ? '#e8f5e9' : '#fee2e2';
    authErrorEl.style.borderColor = ok ? '#a5d6a7' : '#fca5a5';
    authErrorEl.style.color = ok ? '#2e7d32' : '#991b1b';
  }

  if (authToggleLink) {
    authToggleLink.addEventListener('click', () => {
      if (authErrorEl) authErrorEl.style.display = 'none';
      authMode = authMode === 'signin' ? 'signup' : 'signin';
      const isSignup = authMode === 'signup';
      document.getElementById('authTitle')!.textContent = isSignup ? 'Create your account.' : 'Welcome back.';
      document.getElementById('authSubtitle')!.textContent = isSignup
        ? 'Join Freeley to access physician-supervised treatments, track your progress, and manage prescriptions.'
        : 'Sign in to the Freeley Health Hub to view your medical records, active treatments, and messages.';
      document.getElementById('authBtn')!.textContent = isSignup ? 'Create Account' : 'Sign In to Hub';
      document.getElementById('authToggleText')!.textContent = isSignup ? 'Already have an account?' : "Don't have an account?";
      authToggleLink.textContent = isSignup ? 'Sign in' : 'Create one';
      (document.getElementById('forgotLink') as HTMLElement).style.display = isSignup ? 'none' : 'inline';
      document.querySelectorAll<HTMLElement>('.hub-toggle-field').forEach((el) => {
        el.style.display = isSignup ? 'block' : 'none';
      });
    });
  }

  if (authForm) {
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('loginEmail') as HTMLInputElement).value;
      const password = (document.getElementById('loginPassword') as HTMLInputElement).value;
      const nameEl = document.getElementById('authName') as HTMLInputElement | null;
      const name = nameEl ? nameEl.value : '';
      const btn = document.getElementById('authBtn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = authMode === 'signin' ? 'Signing in...' : 'Creating account...';
      if (authErrorEl) authErrorEl.style.display = 'none';

      const result = authMode === 'signup' ? await signUp(email, password, name) : await signIn(email, password);
      if (!result.success) {
        setAuthError(result.message, false);
        btn.disabled = false;
        btn.textContent = authMode === 'signin' ? 'Sign In to Hub' : 'Create Account';
      } else if (authMode === 'signup') {
        // Supabase requires email confirmation before a session exists —
        // signUp() succeeding does NOT sign the user in yet, so there's
        // nothing for the hub:auth listener to react to here. Without this
        // branch the button just sat on "Creating account..." forever with
        // no feedback at all (the bug the client reported).
        //
        // result.status distinguishes a genuinely new signup from a repeat
        // attempt on an email that already has an account — Supabase
        // itself never errors on the latter (by design, so it can't be
        // used to enumerate registered emails), so signUp() infers it
        // client-side (see src/lib/hub/auth.ts).
        if (result.status === 'existing_confirmed') {
          setAuthError('An account with this email already exists. Please sign in instead.', false);
        } else if (result.status === 'existing_unconfirmed') {
          setAuthError('An account with this email already exists but hasn’t been verified yet. We’ve resent the confirmation email — please check your inbox.', false);
        } else {
          setAuthError('✓ Account created! Check your email to confirm your address, then sign in.', true);
        }
        btn.disabled = false;
        btn.textContent = 'Create Account';
      } else {
        // Sign-in success: the page-level hub:auth listener swaps to the
        // dashboard once the session lands. Reset the button too, in case
        // that swap is ever delayed, so it's never left stuck.
        btn.disabled = false;
        btn.textContent = 'Sign In to Hub';
      }
    });
  }

  if (googleBtn) {
    googleBtn.addEventListener('click', async () => {
      googleBtn.disabled = true;
      if (authErrorEl) authErrorEl.style.display = 'none';
      const result = await googleSignIn();
      if (!result.success) setAuthError(result.message, false);
      googleBtn.disabled = false;
    });
  }

  if (forgotBtn) {
    forgotBtn.addEventListener('click', async () => {
      const email = (document.getElementById('loginEmail') as HTMLInputElement).value;
      if (!email) {
        setAuthError('Please enter your email address first, then click reset.', false);
        return;
      }
      try {
        await resetPassword(email);
        setAuthError('✓ Password reset email sent! Check your inbox.', true);
      } catch (err) {
        setAuthError('Could not send reset email. Please check the email address.', false);
      }
    });
  }
</script>
