---
// Treatments panel: the MDI live case-status card. Data loading
// (refreshCaseStatus) lives in src/lib/hub/dashboard.ts; hub.astro also
// calls it when this tab is selected.
---

<div id="panel-treatments" class="hub-panel">
  <div class="hub-card">
    <div class="hub-card__head">
      <div>
        <span class="hub-eyebrow hub-card__kicker">Case Status</span>
        <h3>Active Treatments</h3>
      </div>
      <a href="/assessment-quiz" class="hub-btn hub-btn--sm"><span class="hub-btn__ic"><i class="ri-add-line" aria-hidden="true"></i></span> Start New Treatment</a>
    </div>

    <div id="mdi-status-card" class="hub-status">
      <div class="hub-status__row">
        <div class="hub-status__icon" id="mdi-status-icon">📝</div>
        <div>
          <div class="hub-status__title" id="mdi-status-title">Submitted for Review</div>
          <div class="hub-status__product" id="mdi-status-product"></div>
        </div>
        <button type="button" class="hub-btn hub-btn--outline hub-btn--sm hub-status__refresh" id="hubRefreshStatus" title="Refresh"><span class="hub-btn__ic"><i class="ri-refresh-line" aria-hidden="true"></i></span> Refresh</button>
      </div>
      <div class="hub-status__msg" id="mdi-status-message"></div>

      <div id="mdi-clinician-section" class="hub-status__clinician">
        <img id="mdi-clinician-photo" src="" alt="" loading="lazy" decoding="async" />
        <div>
          <div class="hub-status__clinician-name" id="mdi-clinician-name"></div>
          <div class="hub-status__clinician-role" id="mdi-clinician-specialty"></div>
        </div>
      </div>

      <div class="hub-status__pills">
        <div class="hub-status__pill" id="mdi-case-id-badge"></div>
        <div class="hub-status__pill" id="mdi-last-updated"></div>
      </div>
    </div>

    <div id="mdi-no-case" class="hub-empty hub-empty--dashed">
      <i class="ri-capsule-line"></i>
      <p>No active treatments found. <a href="/assessment-quiz" style="color:var(--brand); font-weight:700;">Take the quiz</a> to get started.</p>
    </div>
  </div>
</div>

<style>
  .hub-status { border: 1px solid var(--line); border-radius: 16px; padding: 24px; margin-bottom: 18px; display: none; background: var(--cream); }
  .hub-status__row { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .hub-status__icon { font-size: 22px; line-height: 1; width: 46px; height: 46px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--line); border-radius: 12px; }
  .hub-status__title { font-family: var(--font-serif); font-weight: 600; font-size: 16.5px; color: var(--ink); }
  .hub-status__product { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  /* Was an icon-only round button; now the shared .hub-btn pill+coin,
     just pinned to the row's trailing edge and kept compact. */
  .hub-status__refresh { margin-left: auto; flex-shrink: 0; }
  .hub-status__refresh:active .hub-btn__ic i { transform: rotate(180deg); display: inline-block; transition: transform .3s ease; }
  .hub-status__msg { font-size: 13.5px; color: var(--ink); line-height: 1.6; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .hub-status__clinician { display: none; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); align-items: center; gap: 12px; }
  .hub-status__clinician img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; display: none; box-shadow: 0 0 0 3px rgba(15,107,69,.12); }
  .hub-status__clinician-name { font-weight: 700; font-size: 13.5px; color: var(--ink); }
  .hub-status__clinician-role { font-size: 12px; color: var(--muted); font-family: var(--font-condensed); letter-spacing: .03em; }
  .hub-status__pills { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .hub-status__pill { font-family: var(--font-condensed); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; background: #fff; border: 1px solid var(--line); padding: 4px 12px; border-radius: 999px; color: var(--muted); }
</style>

<script>
  import { refreshCaseStatus } from '../../lib/hub/dashboard';

  const refreshBtn = document.getElementById('hubRefreshStatus');
  if (refreshBtn) refreshBtn.addEventListener('click', () => refreshCaseStatus());
</script>
