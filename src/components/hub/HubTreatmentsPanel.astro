---
// Treatments panel: the MDI live case-status card. Data loading
// (refreshCaseStatus) lives in src/lib/hub/dashboard.ts; hub.astro also
// calls it when this tab is selected.
---

<div id="panel-treatments" class="hub-panel">
  <div class="hub-card">
    <div class="hub-card__head">
      <h3>Active Treatments</h3>
      <a href="/assessment-quiz" class="hub-btn hub-btn--sm"><i class="ri-add-line" aria-hidden="true"></i> Start New Treatment</a>
    </div>

    <div id="mdi-status-card" class="hub-status">
      <div class="hub-status__row">
        <div class="hub-status__icon" id="mdi-status-icon">📝</div>
        <div>
          <div class="hub-status__title" id="mdi-status-title">Submitted for Review</div>
          <div class="hub-status__product" id="mdi-status-product"></div>
        </div>
        <button type="button" class="hub-status__refresh" id="hubRefreshStatus" title="Refresh"><i class="ri-refresh-line" aria-hidden="true"></i></button>
      </div>
      <div class="hub-status__msg" id="mdi-status-message"></div>

      <div id="mdi-clinician-section" class="hub-status__clinician">
        <img id="mdi-clinician-photo" src="" alt="" loading="lazy" decoding="async" />
        <div>
          <div class="hub-status__clinician-name" id="mdi-clinician-name"></div>
          <div class="hub-status__clinician-role" id="mdi-clinician-specialty"></div>
        </div>
      </div>

      <div class="hub-status__pills">
        <div class="hub-status__pill" id="mdi-case-id-badge"></div>
        <div class="hub-status__pill" id="mdi-last-updated"></div>
      </div>
    </div>

    <div id="mdi-no-case" class="hub-empty hub-empty--dashed">
      <i class="ri-capsule-line"></i>
      <p>No active treatments found. <a href="/assessment-quiz" style="color:var(--brand); font-weight:700;">Take the quiz</a> to get started.</p>
    </div>
  </div>
</div>

<style>
  .hub-status { border: 1px solid var(--line); border-radius: 16px; padding: 22px; margin-bottom: 18px; display: none; }
  .hub-status__row { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .hub-status__icon { font-size: 26px; line-height: 1; }
  .hub-status__title { font-weight: 700; font-size: 15.5px; color: var(--ink); }
  .hub-status__product { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .hub-status__refresh { margin-left: auto; background: none; border: none; cursor: pointer; color: var(--brand); font-size: 18px; padding: 4px; }
  .hub-status__msg { font-size: 13.5px; color: var(--ink); line-height: 1.6; background: rgba(15,107,69,.06); border-radius: 10px; padding: 12px 14px; }
  .hub-status__clinician { display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); align-items: center; gap: 12px; }
  .hub-status__clinician img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; display: none; }
  .hub-status__clinician-name { font-weight: 700; font-size: 13.5px; color: var(--ink); }
  .hub-status__clinician-role { font-size: 12px; color: var(--muted); }
  .hub-status__pills { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .hub-status__pill { font-size: 11px; background: var(--card); padding: 4px 11px; border-radius: 999px; color: var(--muted); }
</style>

<script>
  import { refreshCaseStatus } from '../../lib/hub/dashboard';

  const refreshBtn = document.getElementById('hubRefreshStatus');
  if (refreshBtn) refreshBtn.addEventListener('click', () => refreshCaseStatus());
</script>
