---
// Billing panel: payment methods + invoice history. Loaded lazily by
// hub.astro calling loadBillingHistory() from src/lib/hub/dashboard.ts.
---

<div id="panel-billing" class="hub-panel">
  <div class="hub-card">
    <div class="hub-card__head"><div><span class="hub-eyebrow hub-card__kicker">Subscriptions</span><h3>Active Plans</h3></div></div>
    <div id="subscriptions-content" style="display:none;"></div>
    <div id="subscriptions-empty" class="hub-empty" style="display:none;">
      <i class="ri-refresh-line"></i>
      <p>No active subscriptions</p>
      <p>Your recurring treatment plan will appear here after checkout.</p>
    </div>
  </div>
  <div class="hub-card">
    <div class="hub-card__head"><div><span class="hub-eyebrow hub-card__kicker">Billing</span><h3>Payment Methods</h3></div></div>
    <div id="billing-loading" class="hub-loading"><div class="hub-spinner" style="width:22px; height:22px;"></div>Loading billing...</div>
    <div id="payment-methods-content" style="display:none;"></div>
    <div id="payment-methods-empty" class="hub-empty" style="display:none;">
      <i class="ri-bank-card-line"></i>
      <p>No payment methods on file</p>
      <p>Payment information is managed through your checkout process.</p>
    </div>
  </div>
  <div class="hub-card">
    <div class="hub-card__head"><div><span class="hub-eyebrow hub-card__kicker">Receipts</span><h3>Invoice History</h3></div></div>
    <div id="invoices-content" style="display:none;"></div>
    <div id="invoices-empty" class="hub-empty" style="display:none;">
      <i class="ri-receipt-line"></i>
      <p>No invoices yet</p>
      <p>Your receipts will appear here after your first order.</p>
    </div>
  </div>
</div>

<style is:global>
  /* is:global, deliberately: .hub-pm-row and .hub-table rows below are
     rendered into #payment-methods-content / #invoices-content via
     innerHTML from src/lib/hub/dashboard.ts's loadBillingHistory(), not by
     this component's own template — Astro's scoped-style attribute is only
     ever applied to elements the compiler sees at build time, so a scoped
     <style> here would silently fail to reach that injected markup. */
  .hub-pm { display: flex; align-items: center; gap: 16px; padding: 16px; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 8px; background: var(--cream); }
  .hub-pm i { font-size: 22px; color: #fff; background: var(--brand); width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  /* The actual brand mark (Visa/Mastercard/Amex/Discover) instead of the
     generic card icon above — those logos are full-color art on their own
     white ground, not a tintable glyph, so this gets its own light tile
     instead of reusing .hub-pm i's brand-colored square. */
  .hub-pm__cardicon { width: 52px; height: 42px; border-radius: 8px; background: #fff; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 6px 8px; }
  .hub-pm__cardicon img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .hub-pm__brand { font-weight: 700; font-size: 14.5px; color: var(--ink); }
  .hub-pm__exp { font-size: 12.5px; color: var(--muted); }
  .hub-table { width: 100%; font-size: 13.5px; text-align: left; border-collapse: collapse; }
  .hub-table th { padding: 12px 0; border-bottom: 2px solid var(--line); color: var(--muted); font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .hub-table td { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .hub-table tr:last-child td { border-bottom: none; }
  .hub-table td.hub-table__muted { color: var(--muted); }
  .hub-receipt-link { display: inline-flex; align-items: center; gap: 4px; }
  /* Text link inside a table cell — the one spot on this page a real
     <a href> is genuinely correct (external Stripe receipt URL), so it
     needs the sitewide anchor-color trap's alternate fix: !important on
     color, not a "btn" class rename. Same pattern as .wl-notsure a
     elsewhere in this repo. */
  .hub-receipt-link, .hub-receipt-link:hover { color: var(--brand) !important; text-decoration: none; }
  .hub-sub { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 8px; background: var(--cream); }
  .hub-sub__name { font-weight: 700; font-size: 14.5px; color: var(--ink); }
  .hub-sub__cadence { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .hub-sub-cancel { flex-shrink: 0; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); font-size: 13px; font-weight: 600; cursor: pointer; transition: border-color .15s, color .15s; }
  .hub-sub-cancel:hover { border-color: #c0392b; color: #c0392b; }
  .hub-sub-cancel:disabled { opacity: .6; cursor: default; }
</style>
