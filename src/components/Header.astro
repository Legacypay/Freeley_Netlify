---
// Site header — /prototype's nav, one for one: logo | links | CTA on a
// space-between row, burger + slide-down panel under 1024px. Styles live in
// public/style/style.css ("Header section").
//
// The CTA keeps id="start-assessment-header": the vertical scripts
// (wl/hl/sw/longevity) bind it to open the quiz modal. On pages without the
// modal the inline script below falls back to navigating to the quiz page,
// so the button is never dead.
import { Image } from 'astro:assets';
import logo from '../assets/brand/freeley_logo_transparent_green.webp';

const nav = [
  { label: 'GLP-1 Weight Loss', href: '/weight-loss' },
  { label: 'Hair Loss', href: '/hair-loss' },
  { label: 'Sexual Wellness', href: '/sexual-wellness' },
  { label: 'Longevity', href: '/longevity' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About Us', href: '/about' },
];
---

<header>
  <div class="container navbar-custom">
    <a href="/" class="navbar-brand-custom">
      <Image src={logo} alt="Freeley" loading="eager" />
    </a>
    <nav class="navbar-nav-custom">
      {nav.map((item) => <a href={item.href} class="navbar-link">{item.label}</a>)}
    </nav>
    <div class="navbar-actions">
      <button type="button" class="btn-check-eligibility" id="start-assessment-header">
        Start Assessment <span class="navbar-cta-arw">→</span>
      </button>
      <button type="button" class="navbar-burger" id="siteNavBurger" aria-label="Open menu" aria-expanded="false" aria-controls="siteNavMobile">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="navbar-mobile" id="siteNavMobile">
    {nav.map((item) => <a href={item.href} class="navbar-link">{item.label}</a>)}
    {/* An <a>, not the modal trigger: on phones the quiz page beats a
        modal-in-iframe, and the id must stay unique to the desktop CTA. */}
    <a href="/assessment-quiz" class="navbar-mobile-cta">Start Assessment <span class="navbar-cta-arw">→</span></a>
  </nav>

  <script is:inline>
    (function () {
      var b = document.getElementById('siteNavBurger');
      var m = document.getElementById('siteNavMobile');
      if (b && m) {
        b.addEventListener('click', function () {
          var open = m.classList.toggle('open');
          b.setAttribute('aria-expanded', String(open));
        });
      }
      /* Pages without any quiz modal get a real destination instead of a
         dead button. Runs alongside the vertical scripts' own handler —
         when #quiz--modal (legacy div) or #quizModal (shared QuizModal.astro
         dialog) exists, one of those owns this click instead. */
      var cta = document.getElementById('start-assessment-header');
      if (cta) {
        cta.addEventListener('click', function () {
          if (!document.getElementById('quiz--modal') && !document.getElementById('quizModal')) {
            var target = window.location.pathname.startsWith('/preview') ? '/preview/assessment-quiz' : '/assessment-quiz';
            window.location.href = target;
          }
        });
      }
    })();
  </script>
</header>
