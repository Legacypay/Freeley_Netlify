---
// PROTOTYPE — new clean landing design (client mockup, 2026-07-21).
// Standalone route: does NOT touch the live home or the waitlist gate.
// View locally with `npm run dev` → http://localhost:4321/prototype
// Reuses the Figma v5 export in public/assets/brand/_figma_v5/ + src badges.
// ponytail: hard-coded content arrays — it's a prototype, wire to CMS/data later.
import { Image, Font } from 'astro:assets';
import logo from '../assets/brand/freeley_logo_transparent_green.webp';
import logoWhite from '../assets/brand/freeley_logo_transparent_white.webp';
// Hero trust badges — exactly the set used on the original landing (index.astro):
// Trustpilot / LegitScript / Made in USA, from src/assets/badges/.
import trustPilot from '../assets/badges/trust_pilot.png';
import legitScript from '../assets/badges/49921676.png';
import hipaaBadge from '../assets/badges/hipaa_badge.png';
import usaBadge from '../assets/badges/usa_badge.png';
// Image sources live in src/assets/ so the Image component can optimize them at
// build time (static build → sharp runs on Netlify's builder, nothing at runtime).
import heroCouple from '../assets/figma-v5/hero-couple-green.jpg';
import vialWeightLoss from '../assets/figma-v5/vial-weight-loss.png';
import vialSexualWellness from '../assets/figma-v5/vial-sexual-wellness.png';
import vialHairLoss from '../assets/figma-v5/vial-hair-loss.png';
import vialLongevity from '../assets/figma-v5/vial-longevity.png';
import pressForbes from '../assets/figma-v5/press-forbes.png';
import pressBloomberg from '../assets/figma-v5/press-bloomberg.png';
import pressNyt from '../assets/figma-v5/press-nyt.png';
import pressTechCrunch from '../assets/figma-v5/press-techcrunch.png';

// Every link points at a route that really exists — `href="#"` is a dead link
// for keyboard and screen-reader users, and the site pages are already built.
const ASSESSMENT = '/assessment-quiz';

const nav = [
  { label: 'GLP-1 Weight Loss', href: '/weight-loss' },
  { label: 'Hair Loss', href: '/hair-loss' },
  { label: 'Sexual Wellness', href: '/sexual-wellness' },
  { label: 'Longevity', href: '/longevity' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About Us', href: '/about' },
];

const trustBar = [
  { label: 'Licensed U.S. Physicians', icon: 'stethoscope' },
  { label: 'US Pharmacy Compounded', icon: 'pharmacy' },
  { label: 'HIPAA Compliant', icon: 'lock' },
  { label: 'Discreet Shipping', icon: 'box' },
  { label: 'FSA / HSA Eligible', icon: 'card' },
];

const steps = [
  { n: '1', title: 'Complete Intake', desc: 'A quick online assessment takes just 2 minutes.' },
  { n: '2', title: 'Physician Review', desc: 'A licensed physician reviews your answers and creates your plan.' },
  { n: '3', title: 'Delivered to You', desc: 'Your medication is compounded and shipped discreetly to your door.' },
];

const stats = [
  { value: '15%', label: 'Avg. body weight lost', sub: 'Average body weight loss with physician-guided GLP-1 treatment, not diet alone.' },
  { value: '24hr', label: 'Avg. physician response', sub: 'From intake to physician review and prescription — often same day.' },
  { value: '96%', label: 'Patient satisfaction', sub: 'Across all four treatment programs, from internal patient surveys.' },
  { value: '48hr', label: 'Door-to-Door Delivery', sub: 'Medication delivered to your door within 2 business days.' },
];

const compareCols = ['Freeley', 'Traditional Clinics', 'Retail Pharmacy', 'Other Telehealth'];
const compareRows = [
  { label: 'Board-certified physician oversight', cells: ['y', 'y', '–', 'Varies'] },
  { label: 'No in-person visit required', cells: ['y', 'n', 'n', 'y'] },
  { label: 'Compounded medication options', cells: ['y', 'Rarely', 'n', 'Some'] },
  { label: 'Monthly price (GLP-1 weight loss)', cells: ['$99/mo · 12-mo plan', '$300–$500+', 'Varies', '$188–$399'] },
  { label: 'Free shipping & discreet delivery', cells: ['y', 'n', 'Varies', 'y'] },
  { label: 'FSA / HSA eligible', cells: ['y', 'y', 'y', 'Some'] },
  { label: 'No membership or hidden fees', cells: ['y', 'n', 'y', 'Varies'] },
  { label: 'Cancel anytime — no contracts', cells: ['y', 'N/A', 'N/A', 'Varies'] },
];

const products = [
  { name: 'GLP-1 Weight Loss', img: vialWeightLoss, href: '/weight-loss', desc: 'Semaglutide or Tirzepatide compounded for effective, clinician-supervised weight loss.', price: '$99' },
  { name: 'Sexual Wellness', img: vialSexualWellness, href: '/sexual-wellness', desc: 'Physician-prescribed treatments for performance, libido, and confidence.', price: '$59' },
  { name: 'Hair Loss', img: vialHairLoss, href: '/hair-loss', desc: 'Clinically proven solutions to stop hair loss and support regrowth.', price: '$29' },
  { name: 'Longevity & Peptides', img: vialLongevity, href: '/longevity', desc: 'Peptides and therapies to optimize energy, recovery, and long-term health.', price: '$129' },
];

const testimonials = [
  { quote: 'I’ve lost 34 lbs in 4 months. My cravings are gone and I finally feel in control.', name: 'Jessica R.', tag: '34 lbs lost' },
  { quote: 'The process was so easy and the support from my doctor is unmatched.', name: 'Mark T.', tag: '28 lbs lost' },
  { quote: 'Freeley changed my confidence, my energy, and my life.', name: 'Amanda L.', tag: '22 lbs lost' },
];

const press = [
  { src: pressForbes, name: 'Forbes' },
  { src: pressBloomberg, name: 'Bloomberg' },
  { src: pressNyt, name: 'The New York Times' },
  { src: pressTechCrunch, name: 'TechCrunch' },
