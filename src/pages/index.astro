      </div>
      <div class="wrap foot__bottom">
        <span>© 2026 Freeley. All rights reserved.</span>
        <span class="disc">Freeley does not manufacture compounded medications. Product images are illustrative; actual medication appearance and labeling will differ.</span>
      </div>
    </footer>

    <script is:inline>
      /* Order confirmation banner: reads the ?payment=success&pi=TXN-... redirect
         from checkout.astro's processPayment() and the matching sessionStorage
         receipt it wrote, then reveals the banner. Does not touch the fake
         payment mechanism itself, only reads what it already produced. */
      (function () {
        var params = new URLSearchParams(window.location.search);
        if (params.get('payment') !== 'success' || !params.get('pi')) return;
        var banner = document.getElementById('order-confirmation');
        var idEl = document.getElementById('order-conf-id');
        if (!banner || !idEl) return;
        var raw = sessionStorage.getItem('freeley_transaction');
        var data = null;
        try { data = raw ? JSON.parse(raw) : null; } catch (e) {}
        idEl.textContent = '#' + ((data && data.transactionId) || params.get('pi'));
        banner.style.display = 'block';
        banner.scrollIntoView({ block: 'start' });
      })();

      (function () {
        var b = document.getElementById('navBurger');
        var m = document.getElementById('navMobile');
        if (!b || !m) return;
        b.addEventListener('click', function () {
          var open = m.classList.toggle('open');
          b.setAttribute('aria-expanded', String(open));
        });
      })();

      /* Your Journey timeline: a 20s loop that starts the first time the section
         reaches the viewport and pauses whenever it leaves, so nothing animates
         off screen. The observer is deliberately NOT disconnected — it is what
         drives that pause. is-armed (the empty starting state) is added from JS
         on purpose: a visitor without JS keeps the finished timeline instead of
         staring at a blank box. */
      (function () {
        var t = document.querySelector('.journey__timeline');
        if (!t || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        t.classList.add('is-armed');
        new IntersectionObserver(function (entries) {
          var seen = entries[0].isIntersecting;
          if (seen) t.classList.add('is-live');
          t.classList.toggle('is-idle', !seen);
        }, { threshold: 0.25 }).observe(t);
      })();
    </script>

    <script is:inline>
      if (window.location.pathname.startsWith('/preview')) {
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a');
          if (!a) return;
          var href = a.getAttribute('href');
          if (href && href.startsWith('/') && !href.startsWith('//') && !href.startsWith('/preview') && !href.startsWith('mailto:') && !href.startsWith('tel:')) {
            e.preventDefault();
            window.location.href = '/preview' + (href === '/' ? '' : href);
          }
        });
      }
    </script>

    <QuizModal />
