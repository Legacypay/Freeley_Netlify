// PROTOTYPE — new clean landing design (client mockup, 2026-07-21).
// Standalone route: does NOT touch the live home or the waitlist gate.
// View locally with `npm run dev` → http://localhost:4321/prototype
// Reuses the Figma v5 export in public/assets/brand/_figma_v5/ + src badges.
// ponytail: hard-coded content arrays — it's a prototype, wire to CMS/data later.
import { Image, Font } from 'astro:assets';
import { heroRows } from '../data/compare';
import QuizModal from '../components/QuizModal.astro';
import FinalCta from '../components/FinalCta.astro';
import logo from '../assets/brand/freeley_logo_transparent_green.webp';
import logoWhite from '../assets/brand/freeley_logo_transparent_white.webp';
// Hero trust badges — LegitScript / HIPAA / Made in USA, from src/assets/badges/.
import legitScript from '../assets/badges/49921676.png';
import hipaaBadge from '../assets/badges/hipaa_badge.png';
import usaBadge from '../assets/badges/usa_badge.png';
// Image sources live in src/assets/ so the Image component can optimize them at
// build time (static build → sharp runs on Netlify's builder, nothing at runtime).
import vialWeightLoss from '../assets/figma-v5/vial-weight-loss.png';
import vialSexualWellness from '../assets/figma-v5/vial-sexual-wellness.png';
import vialHairLoss from '../assets/figma-v5/vial-hair-loss.png';
import vialLongevity from '../assets/figma-v5/vial-longevity.png';
import pressForbes from '../assets/figma-v5/press-forbes.png';
import pressBloomberg from '../assets/figma-v5/press-bloomberg.png';
import pressNyt from '../assets/figma-v5/press-nyt.png';
import pressTechCrunch from '../assets/figma-v5/press-techcrunch.png';
// Before/after — only 2 real patient pairs exist (src/assets/before-after/).
// Every link points at a route that really exists — `href="#"` is a dead link
// for keyboard and screen-reader users, and the site pages are already built.
const ASSESSMENT = '/assessment-quiz';

const nav = [
  { label: 'GLP-1 Weight Loss', href: '/weight-loss' },
  { label: 'Hair Loss', href: '/hair-loss' },
  { label: 'Sexual Wellness', href: '/sexual-wellness' },
  { label: 'Longevity', href: '/longevity' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About Us', href: '/about' },
];

const trustBar = [
  { label: 'Licensed U.S. Physicians', icon: 'stethoscope' },
  { label: 'US Pharmacy Compounded', icon: 'pharmacy' },
  { label: 'HIPAA Compliant', icon: 'lock' },
  { label: 'Discreet Shipping', icon: 'box' },
  { label: 'FSA / HSA Eligible', icon: 'card' },
];

const steps = [
  { n: '1', title: 'Complete Intake', desc: 'A quick online assessment takes just 2 minutes.' },
  { n: '2', title: 'Physician Review', desc: 'A licensed physician reviews your answers and creates your plan.' },
  { n: '3', title: 'Delivered to You', desc: 'Your medication is compounded and shipped discreetly to your door.' },
];

// "The Process" — 4-step breakdown, restored from index.astro's own process
// section (was never carried into this redesign). rectangle-32.png and the
// trust-card photos below are pre-existing public/ assets, referenced
// directly rather than through astro:assets since Image only optimizes
// files under src/ — these already ship unoptimized on the live homepage.
// Card images reuse /how-it-works' own existing assets (same steps, same
// files) instead of generating new ones — no AI image call needed here.
const processSteps = [
  { n: '1', title: 'Complete Intake', desc: 'A quick, secure health questionnaire. Takes 5 minutes from your phone. No appointment needed.', img: '/assets/howItsWork/Complete_Your_Health_Intake.png' },
  { n: '2', title: 'Doctor Reviews', desc: 'A board-certified physician reviews your profile within 24 hours and writes your personalized Rx.', img: '/assets/howItsWork/Physician_Reviews_Your_Profile.png' },
  { n: '3', title: 'Pharmacy Compounds', desc: 'Your prescription is sent to a 503A-licensed compounding pharmacy for precise formulation.', img: '/assets/howItsWork/Pharmacy%20Compounds%20Your%20Medication.png' },
  { n: '4', title: 'Delivered to You', desc: 'Discreet, climate-controlled packaging shipped directly to your door. Refills are automatic.', img: '/assets/howItsWork/Delivered_to_Your_Door.png' },
];

// "Real Doctors / Real Providers / Pharmacy Grade" — restored trust section.
const trustCards = [
  { img: '/assets/home/Real_Doctors.png', label: 'Real Doctors', desc: 'Every visit reviewed by a board-certified, licensed U.S. physician.' },
  { img: '/assets/home/Real_Providers.png', label: 'Real Providers', desc: 'Medications sourced and dispensed by our licensed pharmacy partners.' },
  { img: '/assets/home/Pharmacy_Grade.png', label: 'Pharmacy Grade', desc: '503A-licensed compounding, tested for potency, sterility, and purity.' },
];

const stats = [
  { value: '15%', label: 'Avg. body weight lost', sub: 'Average body weight loss with physician-guided GLP-1 treatment, not diet alone.' },
  { value: '24hr', label: 'Avg. physician response', sub: 'From intake to physician review and prescription — often same day.' },
  { value: '96%', label: 'Patient satisfaction', sub: 'Across all four treatment programs, from internal patient surveys.' },
  { value: '48hr', label: 'Door-to-Door Delivery', sub: 'Medication delivered to your door within 2 business days.' },
];

// x/y are the node coordinates of the original graph-home.svg export, kept so the
// hand-built timeline lands on the photo exactly where the flattened SVG did.
const journeyStops = [
  { x: 45, y: 345, label: 'Week 1-2', copy: 'Reduced appetite and cravings begin. Starter dose calibration.' },
  { x: 343, y: 199, label: 'Month 1', copy: 'Average 5–8 lbs lost. Energy improves. Dosage may be adjusted.' },
  { x: 635, y: 199, label: 'Month 3', copy: 'Significant weight reduction. Metabolic markers improve. Visible results.' },
  { x: 879, y: 66, label: 'Month 6', copy: '15%+ body weight lost. Maintenance phase. Long-term metabolic health.' },
];

// ── The 3D capsule ────────────────────────────────────────────────────────────
// Drawn as depth slices, not as a cylinder of radial faces. Cut a capsule with
// planes perpendicular to the camera axis and the cross-section at depth z is
// EXACTLY a stadium of half-height sqrt(r² − z²) — the cylindrical middle
// (y² + z² = r²) and the spherical domes (centres at ±x0) both reduce to it.
// So every slice is one div with border-radius:999px and the domes cost nothing:
// no ring stacks, no dome approximation, no seams.
//
// Sizes are emitted UNITLESS and multiplied by --u in the CSS, so one variable
// rescales the whole capsule on small screens while the geometry stays exact.
// Shading is baked here rather than applied with filter: brightness(), which
// would promote all 64 slices to their own compositor layers.
const POD_R = 104;  // capsule radius
const POD_X0 = 190; // half-length of the straight section
const POD_SLICES = 32;
const podSlices = Array.from({ length: POD_SLICES }, (_, i) => {
  const z = -POD_R + (2 * POD_R * (i + 0.5)) / POD_SLICES;
  const h = Math.sqrt(POD_R * POD_R - z * z);
  // Front slices catch the light; the curve keeps the falloff off-linear so the
  // stack reads as a lit cylinder rather than a flat gradient.
  const lit = 0.58 + 0.42 * Math.pow((z + POD_R) / (2 * POD_R), 0.7);
  const shade = (c: number[]) => c.map((v) => Math.round(v * lit)).join(' ');
  return {
    z: +z.toFixed(2),
    h: +h.toFixed(2),
    w: +(POD_X0 + h).toFixed(2),
    cap: shade([26, 122, 82]),
    body: shade([243, 240, 232]),
  };
});

// The capsule opens onto the four `hero` rows; /compare renders all eight from
// the same module, so the two can never drift.

// The final-CTA pill decoration array used to live here — moved into the
// shared FinalCta.astro component so every page gets the same fixed
// placements instead of its own drifting copy.

const products = [
  { name: 'GLP-1 Weight Loss', img: vialWeightLoss, href: '/weight-loss', desc: 'Semaglutide or Tirzepatide compounded for effective, clinician-supervised weight loss.', price: '$199' },
  { name: 'Sexual Wellness', img: vialSexualWellness, href: '/sexual-wellness', desc: 'Physician-prescribed treatments for performance, libido, and confidence.', price: '$59' },
  { name: 'Hair Loss', img: vialHairLoss, href: '/hair-loss', desc: 'Clinically proven solutions to stop hair loss and support regrowth.', price: '$49' },
  { name: 'Longevity & Peptides', img: vialLongevity, href: '/longevity', desc: 'Peptides and therapies to optimize energy, recovery, and long-term health.', price: '$129' },
];

const testimonials = [
  { quote: 'I’ve lost 34 lbs in 4 months. My cravings are gone and I finally feel in control.', name: 'Jessica R.', tag: '34 lbs lost' },
  { quote: 'The process was so easy and the support from my doctor is unmatched.', name: 'Mark T.', tag: '28 lbs lost' },
  { quote: 'Freeley changed my confidence, my energy, and my life.', name: 'Amanda L.', tag: '22 lbs lost' },
];

const press = [
  { src: pressForbes, name: 'Forbes' },
  { src: pressBloomberg, name: 'Bloomberg' },
  { src: pressNyt, name: 'The New York Times' },
  { src: pressTechCrunch, name: 'TechCrunch' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-condensed" />
    <title>Freeley — Physician-Prescribed Care, Delivered</title>
    <meta
      name="description"
      content="Physician-prescribed GLP-1 weight loss, sexual wellness, hair and longevity care — compounded by licensed U.S. pharmacies and delivered to your door from $199/month."
    />
    <style is:inline>
      /* Hallmark · audit-fix pass · 2026-07-21
       * Kept by client brand: italic display emphasis + gold price.
       * Applied: footer, mobile nav, focus-visible, broken split-rhythm,
       * fewer eyebrows, quote-led testimonials, overflow-clip, minmax grids.
       *
       * ── Impeccable direction contract · 2026-07-23 ──────────────────────
       * THESIS: A compounded prescription is a document before it is a
       *   product. This page speaks in that document's voice — dispensing
       *   record, not apothecary romance — and refuses the soft
       *   wellness-brand register the category defaults to.
       * OWN-WORLD: Client-pinned palette untouched (cream, forest green,
       *   gold). The change is the voice, in two families. Source Serif 4,
       *   drawn as a companion face for documents and interfaces: low
       *   contrast, upright, no flourish, with an optical-size axis spent on
       *   legibility. Under it, Archivo, an American grotesque whose width
       *   axis gives a native condensed register for the compliance
       *   microtype a real Rx label carries. Both replace training-default
       *   faces (Playfair Display, Inter). Owner call 2026-07-23: an earlier
       *   didone pass was rejected — its contrast read as italic everywhere.
       * STORY: A licensed physician decides, a licensed pharmacy compounds,
       *   it arrives at the door. Whatever you came for.
       * FIRST VIEWPORT: Display headline at 4.8rem with the italic carrying
       *   the refusal; price and primary action directly beneath.
       * FORM: Grounded structure #3 (the dispensary document) · seed 5c02a55e
       *   · staging held to type, per owner scope: visual design stays.
       * ─────────────────────────────────────────────────────────────────── */
      :root {
        --green: #123c2c;
        --green-deep: #0d3122;
        --brand: #0f6b45;
        --emph: #2c6b4c;
        --cream: #f6f2e9;
        --card: #efe9dd;
        --ink: #1a1c1a;
        --muted: #63665f;
        --gold: #c39a4e;
        --line: #e5ded0;
        --check: #1f8a55;
        --x: #c2513f;
        --focus: #0f6b45;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; overflow-x: clip; }
      body {
        font-family: var(--font-text);
        color: var(--ink);
        background: var(--cream);
        -webkit-font-smoothing: antialiased;
        line-height: 1.55;
      }
      img { max-width: 100%; display: block; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 8px; }
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
      /* Display — Source Serif 4, drawn as a companion for documents and
         interfaces: low stroke contrast, upright, no flourish. It keeps the
         optical-size axis (8..60), so the same face tightens for small sizes
         and opens for display, but it spends that axis on legibility rather
         than on hairline drama. Owner call 2026-07-23: the didone was read as
         italic wherever it appeared, so the whole face was replaced. */
      .serif {
        font-family: var(--font-display);
        font-weight: 600;
        font-optical-sizing: auto;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }
      .serif em { font-style: italic; font-weight: 600; color: var(--emph); }

      /* Compliance register — Archivo held narrow on its width axis. This is the
         voice a real prescription label uses for everything the law makes it
         carry, and it is why this pairing beats a second decorative face. */
            .eyebrow {
        font-family: var(--font-condensed);
        font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
        color: var(--brand);
      }
      .pill {
        display: inline-flex; align-items: center; gap: 10px;
        background: var(--green); color: #fff; border: none; border-radius: 999px;
        font-family: var(--font-text); font-size: 15px; font-weight: 600;
        padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s;
      }
      .pill:hover { background: var(--green-deep); }
      .pill--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .pill--light:hover { background: #faf8f2; }
      .pill .arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .pill--light .arw { background: var(--green); color: #fff; }
      .ghost {
        display: inline-flex; align-items: center; gap: 10px;
        background: #fff; border: 1px solid var(--line); border-radius: 999px;
        padding: 11px 20px; font-size: 14px; font-weight: 600; color: var(--ink);
        text-decoration: none; cursor: pointer; transition: background .15s;
      }
      .ghost:hover { background: #faf8f2; }
      .ghost .arw { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: var(--green); color: #fff; }
      .price { font-family: var(--font-display); color: var(--gold); font-weight: 600; }

      /* Header */
      header { position: absolute; top: 0; left: 0; right: 0; z-index: 20; }
      header .pill { box-shadow: 0 6px 18px rgba(18, 60, 44, .18); }
      /* padding longhands wherever a class shares its element with .wrap — a
         `padding` shorthand would zero out .wrap's `padding: 0 28px`. */
      .nav { display: flex; align-items: center; justify-content: space-between; padding-top: 22px; padding-bottom: 22px; gap: 24px; }
      .nav__logo img { height: 45px; width: auto; }
      .nav__links { display: none; gap: 22px; font-size: 14px; font-weight: 500; color: var(--ink); }
      .nav__links a { color: inherit; text-decoration: none; white-space: nowrap; }
      .nav__links a:hover { color: var(--brand); }
      @media (min-width: 1024px) { .nav__links { display: flex; } }
      .nav__right { display: flex; align-items: center; gap: 12px; }
      .nav__burger { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 40px; padding: 9px; background: #fff; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
      .nav__burger span { display: block; height: 2px; width: 100%; background: var(--ink); border-radius: 2px; }
      .nav__cta { display: none; }
      @media (min-width: 1024px) { .nav__burger { display: none; } .nav__cta { display: inline-flex; } }
      .nav__mobile { display: none; flex-direction: column; background: var(--cream); border-top: 1px solid var(--line); box-shadow: 0 12px 24px rgba(0,0,0,.08); padding: 10px 28px 18px; }
      .nav__mobile.open { display: flex; }
      /* :not(.pill) — otherwise this beats .pill's own color/padding (higher
         specificity: class+tag vs. class) and the CTA renders with black text. */
      .nav__mobile a:not(.pill) { color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 500; padding: 11px 0; border-bottom: 1px solid var(--line); }
      .nav__mobile a:not(.pill):last-of-type { border-bottom: none; }
      .nav__mobile .pill { justify-content: center; margin-top: 12px; }
      @media (min-width: 1024px) { .nav__mobile { display: none !important; } }

      /* Hero */
      .hero { position: relative; background: var(--cream); overflow: hidden; }
      .hero__img { display: none; }
      @media (min-width: 1024px) {
        .hero__img {
          display: block; position: absolute; top: 84px; right: 0;
          width: 50%; height: calc(100% - 84px); max-height: 760px;
          object-fit: cover; object-position: center 22%;
          /* soft fade of the left edge into the cream — no hard vertical seam */
          -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 26%);
          mask-image: linear-gradient(to right, transparent 0%, #000 26%);
        }
      }
      /* Longhands on purpose: a `padding` shorthand here would zero out the
         horizontal padding this element inherits from .wrap's `padding: 0 28px`. */
      .hero__inner { position: relative; z-index: 5; padding-top: 150px; padding-bottom: 72px; }
      .hero__col { max-width: 560px; }
      @media (min-width: 1024px) { .hero__col { max-width: 50%; } }
      .hero__img-mob { display: none; }
      @media (max-width: 1023px) {
        .hero__img-mob {
          /* height:auto is load-bearing: without it the height="1024" attribute
             Astro's <Image> emits wins (no author height rule), and a determined
             height disables aspect-ratio entirely — the image renders 1024px tall. */
          display: block; width: 100%; height: auto; border-radius: 18px;
          aspect-ratio: 16 / 10; object-fit: cover; object-position: center 18%;
          margin: 8px 0 26px;
        }
      }
      .hero h1 { font-size: clamp(2.9rem, 6.2vw, 4.8rem); line-height: 1.02; letter-spacing: -0.021em; margin: 20px 0 22px; }
      .hero__sub { font-size: 1.05rem; color: var(--muted); margin: 0 0 22px; }
      .hero__qual { font-family: var(--font-condensed); font-size: 12.5px; color: var(--muted); display: block; margin-top: 4px; }
      .hero__from { font-size: 1rem; color: var(--ink); margin-bottom: 22px; }
      .hero__from .price { font-size: 1.6rem; }
      .hero__proof { display: flex; align-items: center; gap: 14px; margin-top: 26px; }
      .avatars { display: flex; }
      .avatars span {
        width: 36px; height: 36px; border-radius: 999px; margin-left: -12px;
        border: 2px solid var(--cream); box-shadow: 0 2px 6px rgba(0,0,0,.14);
        background-repeat: no-repeat; background-position: center; background-size: cover;
      }
      .avatars span:first-child { margin-left: 0; }
      .avatars span:nth-child(1) { background-image: url(/assets/brand/testimonial_1.png); }
      .avatars span:nth-child(2) { background-image: url(/assets/brand/testimonial_2.png); }
      .avatars span:nth-child(3) { background-image: url(/assets/brand/testimonial_3.png); }
      .avatars span:nth-child(4) { background-image: url(/assets/brand/testimonial_4.png); }
      .hero__count b { display: block; font-size: 15px; }
      .hero__count span { font-size: 13px; color: var(--muted); }
      .hero__rating { display: flex; align-items: center; gap: 10px; margin-top: 18px; font-size: 14px; font-weight: 600; }
      .stars { color: #00b67a; letter-spacing: 1px; }
      /* .hero is full-bleed, so a plain `right: 24px` pins the badges to the
         viewport edge and they drift ever further from the copy as the screen
         grows — on 4K they end up ~1300px right of the content column. Anchor
         them to that column instead: 572px = half the 1200px .wrap minus its
         28px padding, so their right edge lands on the same line every other
         section ends at. Below ~1200px the max() falls back to the old 24px. */
      .hero__badges { position: absolute; z-index: 6; right: max(24px, calc(50% - 572px)); bottom: 20px; display: flex; gap: 14px; align-items: center; }
      .hero__badges img { height: 38px; width: auto; background: #fff; border-radius: 8px; padding: 5px 8px; box-shadow: 0 4px 16px rgba(0,0,0,.12); }
      .hero__badges img.lg { height: 48px; }
      .badge-mob { display: none; }

      /* Trust bar */
      /* .trustbar is the cream divider band under the hero — a position treatment,
         not tied to any one set of contents. The trust points moved out of it and
         the press logos moved in; the list styles below travel with the list. */
      .trustbar { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--cream); }
      .trustbar .wrap { padding-block: 18px; }
      .trustlist { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18px; list-style: none; margin: 0; padding: 0; }
      .trustlist li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; color: var(--ink); }
      .trustlist svg { color: var(--brand); flex: none; }

      /* Steps band */
      .band { background: var(--green); color: #fff; border-radius: 22px; margin: 46px 0; padding: 44px; }
      .band__grid { display: grid; gap: 34px; grid-template-columns: 1fr; }
      @media (min-width: 900px) { .band__grid { grid-template-columns: 0.8fr 2.4fr; align-items: center; } }
      .band h2 { font-size: 2rem; margin: 0; color: #fff; line-height: 1.15; }
      .steps { display: grid; gap: 26px; grid-template-columns: 1fr; }
      @media (min-width: 700px) { .steps { grid-template-columns: repeat(3, 1fr); } }
      .step { display: flex; gap: 14px; }
      .step__ic { flex: none; width: 46px; height: 46px; border-radius: 12px; background: rgba(255,255,255,.10); display: grid; place-items: center; }
      .step__n { font-family: var(--font-display); font-size: 1.5rem; color: #cdb98f; line-height: 1; }
      .step h3 { font-size: 1rem; margin: 0 0 6px; font-weight: 600; }
      .step p { font-size: 13px; color: rgba(255,255,255,.72); margin: 0; }
      .band__foot { margin-top: 26px; }
      .band__foot a { color: rgba(255,255,255,.85); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }

      /* Full-width section with a centered head — breaks the split rhythm */
      section.fullsec { padding: 56px 0; }
      .center-head { text-align: center; max-width: 640px; margin: 0 auto 42px; }
      .center-head h2 { font-size: clamp(2.1rem, 4vw, 2.7rem); margin: 0 0 14px; line-height: 1.08; }
      .center-head p { color: var(--muted); font-size: 15px; margin: 0; }
      .center-cta { text-align: center; margin-top: 32px; }

      /* Generic split section: intro + grid */
      section.split { padding: 56px 0; }
      .split__grid { display: grid; gap: 34px; grid-template-columns: 1fr; }
      @media (min-width: 960px) { .split__grid { grid-template-columns: 280px 1fr; } }
      .intro h2 { font-size: clamp(2.1rem, 3.6vw, 2.6rem); margin: 12px 0 16px; line-height: 1.08; }
      .intro p { color: var(--muted); font-size: 15px; margin: 0 0 22px; max-width: 260px; }

      /* "The Process" — restored from index.astro. Mirrors .split__grid but
         swaps the 280px intro column for an even split (text | phone photo),
         and the step row below runs the full width under both. */
      .process__top { display: grid; gap: 34px; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 900px) { .process__top { grid-template-columns: 1fr 1fr; } }
      /* The photo used to be capped at an inline max-width:340px regardless
         of how wide its grid column actually was — on a real desktop
         viewport that left it floating small in a sea of whitespace next to
         the (now correctly-sized) intro text. Letting it fill the column
         and giving it real shadow + a floating stat chip (the same white
         pill-with-shadow device the hero already uses for its badges) gives
         this half of the section the same weight the text half now has. */
      .process__img { display: flex; justify-content: center; position: relative; }
      .process__img img { max-width: 100%; height: auto; border-radius: 20px; box-shadow: 0 24px 60px -12px rgba(18,60,44,.35); }
      .process__badge { position: absolute; left: 24px; bottom: 24px; background: #fff; border-radius: 12px; padding: 10px 16px; box-shadow: 0 8px 24px rgba(0,0,0,.16); font-family: var(--font-serif); font-weight: 600; font-size: 1.15rem; color: var(--brand); line-height: 1.1; }
      .process__badge small { display: block; font-family: var(--font-condensed); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
      /* The hand rises into frame on scroll — a bigger, slower rise than the
         stat/prod cards elsewhere, since this is the section's one signature
         moment, not a repeated list-item reveal. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .process__img img { animation: phoneRise ease-out both; animation-timeline: view(); animation-range: entry 5% cover 55%; }
          @keyframes phoneRise { from { opacity: 0; transform: translateY(90px) scale(.94); } to { opacity: 1; transform: none; } }
        }
      }
      .process__steps { display: grid; gap: 28px; grid-template-columns: repeat(2, 1fr); margin-top: 56px; }
      @media (min-width: 700px) { .process__steps { grid-template-columns: repeat(4, 1fr); } }
      .process__step { border-top: 2px solid var(--line); padding-top: 18px; }
      .process__step img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 14px; margin-bottom: 16px; }
      .process__step .step__n { font-family: var(--font-display); font-size: 1.3rem; color: var(--gold); display: block; margin-bottom: 10px; }
      .process__step h3 { font-size: 1rem; margin: 0 0 6px; font-weight: 600; }
      .process__step p { font-size: 13px; color: var(--muted); margin: 0; }

      /* Staggered reveal-on-scroll, same mechanism as .jcard above (and same
         reason: IntersectionObserver, not `animation-timeline: view()` —
         that's the Safari/macOS gap that already caused a bug on this site).
         No JS / reduced-motion / unsupported-browser all fall back to the
         cards simply being visible, never stuck hidden. */
      @media (prefers-reduced-motion: no-preference) {
        .process__step { opacity: 0; transform: translateY(28px); transition: opacity .6s ease, transform .6s cubic-bezier(.22,.61,.36,1); }
        .process__step.is-visible { opacity: 1; transform: none; }
        .process__step:nth-child(1) { transition-delay: 0s; }
        .process__step:nth-child(2) { transition-delay: .1s; }
        .process__step:nth-child(3) { transition-delay: .2s; }
        .process__step:nth-child(4) { transition-delay: .3s; }
      }

      /* "Your Journey" — rebuilt as 4 card panels (was a full-bleed photo +
         hand-drawn SVG timeline). Reuses .prod's card visual language
         (background: var(--card), border-radius: 18px card, staggered
         reveal-on-scroll) so it reads consistently with the Products section
         instead of introducing a third card style. The reveal below uses
         IntersectionObserver, not `animation-timeline: view()` — the
         Safari/macOS support gaps for scroll-timelines already caused a
         separate bug on this site (see the pod/bento @supports fallbacks). */
      .jcards { display: grid; gap: 16px; grid-template-columns: repeat(1, minmax(0, 1fr)); }
      @media (min-width: 640px) { .jcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 1100px) { .jcards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
      .jcard { background: var(--card); border-radius: 18px; padding: 26px 22px; }
      .jcard__n { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; color: var(--brand); margin-bottom: 12px; }
      .jcard h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin: 0 0 8px; }
      .jcard p { font-size: 13.5px; color: var(--muted); margin: 0; }

      /* Staggered reveal-on-scroll, played once per card (JS at the bottom
         adds .is-visible via IntersectionObserver — see the note above). */
      @media (prefers-reduced-motion: no-preference) {
        .jcard { opacity: 0; transform: translateY(28px); transition: opacity .6s ease, transform .6s cubic-bezier(.22,.61,.36,1); }
        .jcard.is-visible { opacity: 1; transform: none; }
        .jcard:nth-child(1) { transition-delay: 0s; }
        .jcard:nth-child(2) { transition-delay: .1s; }
        .jcard:nth-child(3) { transition-delay: .2s; }
        .jcard:nth-child(4) { transition-delay: .3s; }
      }

      /* Product cards */
      .stats { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
      @media (min-width: 1024px) {
        .stats { grid-template-columns: repeat(12, minmax(0, 1fr)); }
        .stat--1, .stat--4 { grid-column: span 7; }
        .stat--2, .stat--3 { grid-column: span 5; }
      }
      .stat { position: relative; overflow: hidden; border-radius: 16px; padding: 26px 30px; min-height: 309px; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(180deg, #E7EAF0 0%, #F3F4EF 100%); }
      .stat::after { content: ''; position: absolute; inset: 0; background-repeat: no-repeat; }
      .stat__body { position: relative; z-index: 1; max-width: 66%; }
      .stat__v { font-family: var(--font-display); font-size: clamp(3.4rem, 5vw, 4.1rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.022em; }
      .stat__l { font-size: 16px; font-weight: 500; margin-top: 4px; color: var(--brand); }
      .stat__s { font-size: 15px; color: #000; margin-top: 16px; line-height: 1.4; }

      /* Text placement mirrors the reference bento: card 1 top-left, 2 & 4 bottom-left, 3 bottom-centered */
      .stat--1 { justify-content: flex-start; background: linear-gradient(101.13deg, #D2CBC2 33.46%, #F0E9E0 100%); }
      .stat--1 .stat__body { max-width: 40%; }
      .stat--1::before { content: ''; position: absolute; top: 0; left: 0; width: 340px; height: 100%; background: url('/assets/home/white-ellipse.png') no-repeat; background-size: contain; }
      .stat--1::after { background-image: url('/assets/home/girl-belly.png'); background-position: right center; background-size: contain; }
      .stat--2 { background: radial-gradient(139.32% 139.32% at 50% 100%, #F6EEE0 0%, #FFDAAD 100%); }
      .stat--2::after { background-image: url('/assets/home/24hr.Avg.physician.esponse.png'); background-position: right 22px top 22px; background-size: 180px auto; }
      .stat--3 { background: radial-gradient(107.61% 107.61% at 50.12% 100%, #F8FEFF 0%, #C7D0E4 100%); }
      .stat--3 .stat__body { max-width: 100%; text-align: center; }
      .stat--3::before { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 80%; height: 64%; border-radius: 50%; background: url('/assets/home/ellipse_35.png') no-repeat; background-size: contain; }
      .stat--3::after { background-image: url('/assets/home/96_Patient satisfaction.png'); background-position: center -220px; background-size: calc(100% + 100px) auto; }
      .stat--4 .stat__body { max-width: 38%; }
      .stat--4::after { background-image: url('/assets/home/48hr_Door-to-Door_Delivery.png'); background-position: right -30px center; background-size: auto 110%; }

      /* On one column the artwork on cards 2 and 4 is sized to the card, so it
         grew to cover the whole tile and the copy ended up printed over vials and
         a cardboard box — dark type on dark artwork, unreadable. The layering was
         never wrong (.stat__body already sits at z-index 1); the artwork was
         simply too big. Pin it to the top-right at a fixed height, hand the lower
         half to the text, and add the height that split needs.
         Cards 1 and 3 place their art clear of the copy already — left alone. */
      @media (max-width: 639.98px) {
        .stat--2, .stat--4 { min-height: 344px; }
        .stat--2 .stat__body, .stat--4 .stat__body { max-width: 100%; }
        .stat--2::after { background-size: auto 104px; background-position: right 14px top 16px; }
        .stat--4::after { background-size: auto 132px; background-position: right -8px top 14px; }
      }

      /* Hover: lift the card, push the artwork in a touch. Uses the standalone
         `translate` / `scale` properties, not `transform`, so it composes with
         the scroll-in animation below instead of fighting it. */
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .stat { transition: translate .4s cubic-bezier(.22,.61,.36,1), box-shadow .4s ease; }
        .stat::after { transition: scale .6s cubic-bezier(.22,.61,.36,1); }
        .stat:hover { translate: 0 -6px; box-shadow: 0 20px 44px rgba(23, 34, 42, .16); }
        .stat:hover::after { scale: 1.045; }
        /* Scale from the side the artwork sits on, so it grows into the card
           instead of drifting off the edge. */
        .stat--1::after, .stat--4::after { transform-origin: right center; }
        .stat--2::after { transform-origin: right top; }
        .stat--3::after { transform-origin: center top; }
        .stat__v, .stat__l, .stat__s { transition: translate .4s cubic-bezier(.22,.61,.36,1); }
        .stat:hover .stat__v { translate: 0 -2px; }
      }

      /* Scroll-in reveal, native scroll-driven animation — no JS, no library.
         ponytail: gated behind @supports; browsers without view() just show the
         cards immediately, which is the correct fallback, not a broken one. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .stat { animation: statIn linear both; animation-timeline: view(); animation-range: entry 8% cover 24%; }
          @keyframes statIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
        }
      }

      @media (max-width: 1023px) {
        .stat__body, .stat--1 .stat__body, .stat--4 .stat__body { max-width: 68%; }
        .stat--1::after { background-image: url('/assets/home/girl-belly-mobile.png'); background-position: right center; }
        .stat--3::after { background-size: calc(100% + 210px) auto; }
      }
      .footnote { font-size: 11.5px; color: var(--muted); margin-top: 16px; }

      /* ── The 3D capsule ─────────────────────────────────────────────────────
         One big capsule that splits open and reveals what Freeley includes, in
         the exact space it occupied. See the frontmatter for why each slice is a
         plain rounded div: the cross-section of a capsule at depth z IS a
         stadium, so this is exact geometry, not an approximation, and the domes
         need no special case.

         The reveal is absolutely positioned over the stage, so opening changes
         NO layout — nothing below the section moves, and there is no height to
         animate. The halves swing to nearly edge-on (rotateY 74°) rather than
         sliding far apart, which is what lets a 588px capsule open inside an
         820px column without the halves leaving the grid cell.

         Two invariants that are easy to undo by accident: the idle motion
         animates .pod__stage ALONE (the 64 slices ride along as one composited
         3D subtree — animating them individually is the mistake this design
         exists to avoid), and slice sizes are emitted unitless and multiplied by
         --u, so one number rescales the whole capsule per breakpoint.

         ponytail: no 3D library, no JavaScript. <details> supplies the toggle and
         keeps every value in the DOM — indexable, screen-reader reachable,
         expandable by find-in-page. A WebGL canvas would have cost ~155 KB and
         hidden all of it. */
      .pod { --u: 1px; --r: 104; --x0: 190; position: relative; display: block; }
      /* Full column to itself now, so the capsule scales up on wide screens. */
      @media (min-width: 1040px) { .pod { --u: 1.3px; } }
      .pod__trigger { display: block; cursor: pointer; list-style: none; border-radius: 26px; }
      .pod__trigger::-webkit-details-marker { display: none; }
      .pod__trigger:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

      .pod__scene {
        position: relative;
        display: flex; justify-content: center; align-items: center;
        min-height: calc(var(--r) * 2.5 * var(--u));
        perspective: calc(1500 * var(--u));
      }
      /* Contact shadow. Deliberately on the scene, not the stage: the stage is
         what drifts, and a shadow that floats along with the object it belongs to
         kills the illusion. Anchored here, the capsule reads as rising off it. */
      /* ::before, not ::after — it paints before the element's children, so it
         sits under the capsule without a negative z-index, which would have
         depended on whichever ancestor happens to form the stacking context. */
      .pod__scene::before {
        content: ''; position: absolute; left: 50%;
        bottom: calc(var(--r) * .06 * var(--u));
        width: calc((var(--x0) + var(--r)) * 1.75 * var(--u));
        height: calc(var(--r) * .3 * var(--u));
        transform: translateX(-50%);
        background: radial-gradient(50% 50% at 50% 50%, rgba(18, 60, 44, .24), rgba(18, 60, 44, 0) 70%);
        transition: opacity .9s ease, transform .9s cubic-bezier(.2, .8, .25, 1);
        pointer-events: none;
      }
      /* Halves apart, the mass under them spreads and thins. scaleX rather than
         width: same look, composited instead of re-laid-out every frame. */
      .pod[open] .pod__scene::before { opacity: .55; transform: translateX(-50%) scaleX(1.43); }
      .pod__stage {
        position: relative;
        width: calc((var(--x0) + var(--r)) * 2 * var(--u));
        height: calc(var(--r) * 2 * var(--u));
        transform-style: preserve-3d;
        animation: podIdle 9s ease-in-out infinite;
      }
      @keyframes podIdle {
        0%, 100% { transform: translateY(calc(-6 * var(--u))) rotateY(-7deg) rotateZ(-1.4deg); }
        50%      { transform: translateY(calc(6 * var(--u)))  rotateY(7deg)  rotateZ(1.4deg); }
      }

      /* Each half is a zero-sized anchor at the joint, so its default
         transform-origin sits exactly on the seam — rotateY pivots the half about
         the joint, the way a real capsule comes apart. */
      .pod__half {
        position: absolute; left: 50%; top: 50%;
        transform-style: preserve-3d;
        transition: transform .9s cubic-bezier(.2, .8, .25, 1), opacity .7s ease;
      }
      .pod__slice {
        position: absolute;
        width: calc(var(--w) * var(--u));
        height: calc(var(--h) * 2 * var(--u));
        top: calc(var(--h) * -1 * var(--u));
        transform: translateZ(calc(var(--z) * var(--u)));
        /* Depth shading is baked into the inline background. --gloss adds the
           roll-off around the cylinder, which depth alone cannot express: a tight
           specular band near the top, a core shadow low down, and a bounce rim on
           the very bottom edge. The narrow highlight is what stops it reading as
           a flat lozenge — a wide soft one just looks like a gradient. */
        --gloss: linear-gradient(
          to bottom,
          rgba(255, 255, 255, .10) 0%,
          rgba(255, 255, 255, .58) 13%,
          rgba(255, 255, 255, .16) 27%,
          rgba(255, 255, 255, 0) 44%,
          rgba(0, 0, 0, .14) 68%,
          rgba(0, 0, 0, .34) 90%,
          rgba(255, 255, 255, .18) 100%
        );
        background-image: var(--gloss);
      }
      /* One horizontal layer per half carries both ends: the outer dome falling
         away from the light, and the darker seam where the two halves meet. The
         stops are mirrored because the joint is on the right of the cap and on
         the left of the body. */
      .pod__half--cap .pod__slice {
        left: calc(var(--w) * -1 * var(--u)); border-radius: 999px 3px 3px 999px;
        background-image: linear-gradient(90deg, rgba(0, 0, 0, .20), transparent 14%, transparent 88%, rgba(0, 0, 0, .24)), var(--gloss);
      }
      .pod__half--body .pod__slice {
        left: 0; border-radius: 3px 999px 999px 3px;
        background-image: linear-gradient(90deg, rgba(0, 0, 0, .28), transparent 12%, transparent 86%, rgba(0, 0, 0, .20)), var(--gloss);
      }

      /* Opens sideways: each half slides outward along the capsule's own axis and
         pivots a little about the joint. The head now sits above the capsule
         instead of beside it, which is what freed the width for this travel. */
      /* .42 opacity turned the halves into pale blobs and they stopped reading as
         a capsule at all. Higher opacity keeps their colour, and a stronger
         rotateY foreshortens the flat inner edge so it reads as a cut face
         turning away rather than a rounded rectangle. */
      .pod[open] .pod__half--cap { transform: translateX(calc(var(--x0) * -.92 * var(--u))) rotateY(-24deg) rotateZ(-2.5deg); opacity: .58; }
      .pod[open] .pod__half--body { transform: translateX(calc(var(--x0) * .92 * var(--u))) rotateY(24deg) rotateZ(2.5deg); opacity: .58; }

      .pod__hint {
        display: block; text-align: center; margin-top: 2px;
        font-family: var(--font-condensed); font-size: 12.5px;
        letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
      }
      .pod__hint--open, .pod[open] .pod__hint--shut { display: none; }
      .pod[open] .pod__hint--open { display: inline; }

      /* Out of flow on purpose — see the block comment. Centred on the capsule,
         not on the section, so it lands where the capsule was. */
      .pod__reveal {
        position: absolute; left: 50%; top: calc(var(--r) * 1.25 * var(--u));
        /* Sized to the OPENING, not to the capsule. The halves travel .92·x0
           each, so the gap between them is 1.84·x0 — a panel wider than that cut
           diagonally across the green half instead of sitting inside the opening. */
        width: min(100%, calc(var(--x0) * 2.05 * var(--u)));
        transform: translate(-50%, -50%);
        animation: podReveal .65s cubic-bezier(.2, .8, .25, 1) .18s both;
      }
      @keyframes podReveal {
        from { opacity: 0; transform: translate(-50%, -50%) scale(.88); }
        to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
      }
      .pod__eyebrow {
        margin: 0 0 10px; text-align: center;
        font-family: var(--font-condensed); font-size: 12px;
        letter-spacing: .16em; text-transform: uppercase; color: var(--brand);
      }
      .pod__gives {
        list-style: none; margin: 0; padding: 8px 10px;
        background: rgba(255, 255, 255, .94); border: 1px solid var(--line);
        border-radius: 20px; box-shadow: 0 14px 38px rgba(18, 60, 44, .13);
        backdrop-filter: blur(3px);
      }
      .pod__gives li {
        display: flex; align-items: center; justify-content: space-between;
        gap: 14px; flex-wrap: wrap; padding: 9px 12px;
      }
      .pod__gives li + li { box-shadow: inset 0 1px 0 var(--line); }
      .pod__gives-label { font-size: 14px; font-weight: 500; }
      .pod__gives-val {
        display: flex; align-items: center; margin-left: auto;
        font-size: 14.5px; font-weight: 700; color: var(--brand);
        font-variant-numeric: tabular-nums;
      }

      /* Link to the full comparison, not a disclosure. */
      .pod__more { display: flex; justify-content: center; margin-top: 26px; }
      .pod__more-btn {
        display: inline-flex; align-items: center; gap: 10px; padding: 11px 12px 11px 24px;
        background: #fff; border: 1px solid var(--line); border-radius: 999px;
        font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none;
        transition: border-color .3s ease, box-shadow .3s ease;
      }
      .pod__more-btn .arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: var(--green); color: #fff; }
      @media (hover: hover) { .pod__more-btn:hover { border-color: #d6cbb4; box-shadow: 0 8px 20px rgba(18, 60, 44, .10); } }

      /* Half the slices below 640px. Tilt is bounded to ±7°, so at this scale the
         lateral offset between adjacent slices stays under a pixel — the volume
         still reads, at half the overdraw. */
      @media (max-width: 639.98px) {
        .pod { --u: .5px; }
        .pod__slice:nth-child(even) { display: none; }
        /* The reveal drops into normal flow here rather than floating over the
           capsule. Centring a ~230px panel on a 104px capsule needed a 300px
           scene, which sat mostly empty the rest of the time — about 94px of dead
           air above and below. Opening now costs a layout shift, which on a phone
           is the ordinary, expected behaviour. */
        .pod__scene { min-height: calc(var(--r) * 2.7 * var(--u)); }
        .pod__reveal {
          position: static; transform: none; width: auto; padding-top: 20px;
          animation-name: podRevealFlow;
        }
        @keyframes podRevealFlow {
          from { opacity: 0; transform: translateY(14px) scale(.96); }
          to { opacity: 1; transform: none; }
        }
        .pod__gives li { padding: 8px 10px; }
        .pod__gives-label { font-size: 13.5px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .pod__stage { animation: none; }
        .pod__half { transition: opacity .3s ease; }
        .pod[open] .pod__half--cap, .pod[open] .pod__half--body { transform: none; opacity: .12; }
        .pod__reveal { animation: none; }
        .pod__more-btn { transition: none; }
      }

      .ic-y { color: var(--check); }
      .ic-n { color: var(--x); }

      /* Product cards */
      .prods { display: grid; gap: 16px; grid-template-columns: repeat(1, minmax(0, 1fr)); }
      @media (min-width: 640px) { .prods { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 1100px) { .prods { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
      .prod { background: var(--card); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; }
      .prod__img { position: relative; height: 150px; display: grid; place-items: center; margin-bottom: 14px; }
      /* position: relative keeps the vial painting ABOVE the hover halo — the
         halo is a positioned pseudo, so a static img would sit under it. */
      .prod__img img { position: relative; max-height: 150px; width: auto; object-fit: contain; }
      .prod h3 { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; margin: 0 0 8px; text-align: center; }
      .prod p { font-size: 13px; color: var(--muted); text-align: center; margin: 0 0 18px; flex: 1; }
      .prod__price { text-align: center; margin-bottom: 14px; }
      .prod__price .price { font-size: 1.5rem; }
      .prod__price small { color: var(--muted); font-size: 13px; }
      .prod .pill { justify-content: center; width: 100%; font-size: 14px; padding: 12px; }

      /* The funnel's decision row: the motion here has a job — pull the eye to
         one card at a time and make the CTA read as the next step. */
      .prod { position: relative; border: 1px solid transparent; }
      /* Soft halo behind the vial, revealed on hover. */
      .prod__img::before {
        content: ''; position: absolute; inset: -10% 8% 0;
        background: radial-gradient(closest-side, rgba(15, 107, 69, .16), transparent 70%);
        opacity: 0; pointer-events: none;
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .prod__img img { transition: translate .5s cubic-bezier(.22,.61,.36,1), scale .5s cubic-bezier(.22,.61,.36,1); }
        .prod__img::before { transition: opacity .45s ease; }
        .prod .pill { transition: translate .35s cubic-bezier(.22,.61,.36,1); }
        .prod__price .price { transition: color .35s ease; }

        .prod:hover { translate: 0 -8px; box-shadow: 0 22px 48px rgba(23, 34, 42, .16); border-color: var(--brand); }
        .prod:hover .prod__img img { translate: 0 -8px; scale: 1.06; }
        .prod:hover .prod__img::before { opacity: 1; }
        .prod:hover .prod__price .price { color: var(--brand); }
        .prod:hover .pill { translate: 0 -2px; }

        /* Dim the siblings so the hovered card is the only live option — the
           whole point of a funnel row. Dims with `filter: opacity()`, not
           `opacity`: the scroll-in keyframes below animate `opacity`, and an
           animation with fill `both` outranks a plain declaration, so this
           would silently never apply. `filter` composes instead of colliding. */
        .prod { transition: translate .4s cubic-bezier(.22,.61,.36,1), box-shadow .4s ease, border-color .4s ease, filter .4s ease; }
        .prods:hover .prod { filter: opacity(.62); }
        .prods:hover .prod:hover { filter: none; }
      }

      /* Staggered scroll-in. The cards sit in one row, so they share the same
         view() progress — the stagger comes from shifting each card's
         animation-range, not from a delay (delays don't apply to scroll
         timelines). ponytail: same @supports fallback as the bento. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .prod { animation: prodIn linear both; animation-timeline: view(); }
          .prod:nth-child(1) { animation-range: entry 6% cover 20%; }
          .prod:nth-child(2) { animation-range: entry 12% cover 26%; }
          .prod:nth-child(3) { animation-range: entry 18% cover 32%; }
          .prod:nth-child(4) { animation-range: entry 24% cover 38%; }
          @keyframes prodIn { from { opacity: 0; transform: translateY(30px) scale(.97); } to { opacity: 1; transform: none; } }
        }
      }

      /* "Real Doctors / Real Providers / Pharmacy Grade" — restored trust
         section, reusing index.astro's three photos. */
      .trust { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 780px) { .trust { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .trust__card { border-radius: 18px; overflow: hidden; background: var(--card); }
      .trust__img { aspect-ratio: 4 / 3; overflow: hidden; }
      .trust__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .trust__body { padding: 20px 22px 24px; }
      .trust__body h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; margin: 0 0 6px; }
      .trust__body p { font-size: 13.5px; color: var(--muted); margin: 0; }

      /* Staggered scroll-in, same mechanism as .stat/.prod above. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .trust__card { animation: trustIn linear both; animation-timeline: view(); }
          .trust__card:nth-child(1) { animation-range: entry 8% cover 26%; }
          .trust__card:nth-child(2) { animation-range: entry 14% cover 32%; }
          .trust__card:nth-child(3) { animation-range: entry 20% cover 38%; }
          @keyframes trustIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
        }
      }

      /* Testimonials — quote-led (no duplicated imagery) */
      /* Testimonials — swiper@11, the same CDN + init mechanics already
         used for the mechanism-cards/press-logo carousels on the product
         pages (wl-script.js's okSwiper/brandSwiper), so the site has one
         carousel approach instead of two. Init script is at the bottom. */
      .testi.swiper { overflow: hidden; padding-top: 6px; padding-bottom: 16px; }
      .testi .swiper-slide { width: 320px; height: auto; }
      @media (min-width: 700px) { .testi .swiper-slide { width: 400px; } }
      .tcard { background: var(--card); border-radius: 16px; padding: 24px; height: 100%; }
      .tcard__stars { color: #00b67a; letter-spacing: 2px; font-size: 14px; margin-bottom: 14px; }
      .tcard__quote { font-family: var(--font-display); font-size: 1.28rem; line-height: 1.42; color: var(--ink); margin: 0 0 16px; }
      .tcard__meta { font-size: 13px; }
      .tcard__name { font-weight: 600; }
      .tcard__tag { color: var(--brand); }

      /* Press */
      .trustpoints { padding: 30px 0 56px; }
      /* Label on its own line, logos in a row beneath it — the label used to sit
         inline at the far left, which made the four logos read as a continuation
         of the sentence rather than as a set. */
      .press__row { display: flex; flex-direction: column; align-items: center; gap: 15px; }
      .press__label { font-size: 12px; font-family: var(--font-condensed); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .press__logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 22px 54px; }
      .press__logos img { height: 24px; width: auto; opacity: .72; filter: grayscale(1); }

      /* Final CTA — now the shared <FinalCta> component
         (src/components/FinalCta.astro); its background/pill CSS lives there. */

      /* Footer */
      .foot { background: var(--green-deep); color: rgba(255,255,255,.75); }
      .foot__grid { display: grid; gap: 34px; grid-template-columns: 1fr; padding-top: 56px; padding-bottom: 34px; }
      @media (min-width: 780px) { .foot__grid { grid-template-columns: 1.7fr 1fr 1fr 1fr; } }
      .foot__logo { height: 30px; width: auto; opacity: .95; }
      .foot__brand p { font-size: 14px; max-width: 260px; margin: 16px 0 0; line-height: 1.6; }
      .foot__col h3 { color: #fff; font-size: 13px; font-weight: 600; letter-spacing: .04em; margin: 0 0 14px; }
      .foot__col a { display: block; color: rgba(255,255,255,.7); text-decoration: none; font-size: 14px; padding: 6px 0; }
      .foot__col a:hover { color: #fff; }
      .foot__bottom { border-top: 1px solid rgba(255,255,255,.12); padding-top: 22px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 10px 32px; justify-content: space-between; }
      .foot__bottom span { font-size: 12px; color: rgba(255,255,255,.55); }
      .foot__bottom .disc { max-width: 640px; font-family: var(--font-condensed); letter-spacing: 0.015em; }

      @media (max-width: 1023px) {
        .badge-mob { display: block; margin-top: 26px; }
        .hero__badges { display: none; }
        .hero__inner { padding-top: 104px; }
      }

      /* Order confirmation banner */
      .order-conf { background: var(--green); color: #fff; }
      .order-conf__inner { padding: 14px 28px; display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 14px; }
      .order-conf__inner strong { font-weight: 700; }
      #order-conf-onboarding { color: #fff; font-weight: 700; text-decoration: underline; }
    </style>
  </head>

