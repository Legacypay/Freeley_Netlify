      <section class="transformation-section overflow-hidden">
        <div class="container">
          <div class="heading-wrap">
            <div class="section--title mt-2">
              <h2>
                Numbers that speak<br /><span class="highlight"
                  >for themselves</span
                >
              </h2>
            </div>
            <p>
              Results from real Freeley patients under physician supervision.
            </p>
          </div>
          <div
            class="swiper swiper_before_after transformation-slider"
          >
            <div class="swiper-wrapper">
              <div class="swiper-slide">
                <div class="transform-card">
                  <div class="compare-wrapper">
                    <div class="before-box">
                      <span class="compare-label">Before</span
                      ><Image src={beforeImg} alt="Before" loading="eager" />
                    </div>
                    <div class="after-box">
                      <span class="compare-label">After</span
                      ><Image src={afterImg} alt="After" loading="eager" />
                    </div>
                  </div>
                  <div class="transform-quote">
                    &#8220;Down 37 lbs. Food noise gone. Life changed.&#8221;
                  </div>
                  <div class="transform-author">
                    Sarah K.<span>• GLP-1 Weight Loss Program</span>
                  </div>
                </div>
              </div>
              <div class="swiper-slide">
                <div class="transform-card">
                  <div class="compare-wrapper">
                    <div class="before-box">
                      <span class="compare-label">Before</span
                      ><Image src={beforeImg} alt="Before" loading="eager" />
                    </div>
