                />
              </div>
              <h3>Sexual Wellness</h3>
              <ul class="feature-list mb-6">
                <li>
                  <span class="list-icon"
                    ><svg viewBox="0 0 24 24">
                      <path
                        d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"
                      /></svg></span
                  >Dissolves under the tongue (Sublingual)
                </li>
                <li>
                  <span class="list-icon"
                    ><svg viewBox="0 0 24 24">
                      <path
                        d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"
                      /></svg></span
