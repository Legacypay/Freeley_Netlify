            </p>
          </div>
          <div class="medicine-grid">
            <div
              class="medicine-card"
            >
              <div class="product-image">
                <Image
                  src={image18}
                  alt="GLP-1 Weight Loss"
                />
              </div>
              <h3>GLP-1 Weight Loss</h3>
              <ul class="feature-list mb-6">
                <li>
                  <span class="list-icon"
