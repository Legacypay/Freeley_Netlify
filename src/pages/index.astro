    <script is:inline>
      /* Order confirmation banner: reads the ?payment=success&pi=... redirect
         from checkout.astro and the matching sessionStorage receipt it wrote,
         then reveals the banner. If the receipt carries MDI's onboardingUrl
         (the branded patient site), surface it as the primary next step. */
      (function () {
        var params = new URLSearchParams(window.location.search);
        if (params.get('payment') !== 'success' || !params.get('pi')) return;
        var banner = document.getElementById('order-confirmation');
        var idEl = document.getElementById('order-conf-id');
        if (!banner || !idEl) return;
        var raw = sessionStorage.getItem('freeley_transaction');
        var data = null;
        try { data = raw ? JSON.parse(raw) : null; } catch (e) {}
        idEl.textContent = '#' + ((data && data.transactionId) || params.get('pi'));
        var onboarding = document.getElementById('order-conf-onboarding');
        if (onboarding && data && data.onboardingUrl && /^https:\/\//.test(data.onboardingUrl)) {
          onboarding.href = data.onboardingUrl;
          onboarding.style.display = 'inline-block';
        }
        banner.style.display = 'block';
        banner.scrollIntoView({ block: 'start' });
      })();

      (function () {
        var b = document.getElementById('navBurger');
        var m = document.getElementById('navMobile');
        if (!b || !m) return;
        b.addEventListener('click', function () {
          var open = m.classList.toggle('open');
          b.setAttribute('aria-expanded', String(open));
        });
      })();

      /* This page IS /preview (it's also the live homepage at /). Its navbar
         hrefs are absolute (/weight-loss, /about, ...), none of which are on
         the waitlist gate's allow-list — clicking one from /preview jumped
         straight to the real path and fell through to the forced /waitlist
         rewrite. Keep navigation under /preview/* while browsing the mockup,
         same fix already applied to Header.astro (used by the other pages). */
      (function () {
        if (!window.location.pathname.startsWith('/preview')) return;
        document.querySelectorAll('a[data-preview-aware]').forEach(function (a) {
          var href = a.getAttribute('href');
          if (href && href.charAt(0) === '/' && !href.startsWith('/preview')) {
            a.setAttribute('href', '/preview' + href);
          }
        });
      })();

      /* Your Journey cards + The Process steps: staggered reveal-on-scroll,
         once per card, sharing one observer. IntersectionObserver rather
         than `animation-timeline: view()` — see the .jcards CSS note above
         for why. Each card unobserves itself once revealed, so it never
         re-plays. */
      (function () {
        var cards = document.querySelectorAll('.jcard, .process__step');
        if (!cards.length || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          });
        }, { threshold: 0.25 });
        cards.forEach(function (c) { io.observe(c); });
      })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
    <script is:inline>
      (function () {
        var el = document.querySelector('.testi.swiper');
        if (!el || typeof Swiper === 'undefined') return;
        new Swiper(el, {
          slidesPerView: 'auto',
          spaceBetween: 20,
          autoplay: { delay: 5000 },
          direction: 'horizontal',
          loop: true,
          grabCursor: true,
          centeredSlides: false,
        });
      })();
    </script>

    <QuizModal />
  </body>
</html>
