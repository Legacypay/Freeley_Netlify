                <div class="text-14-inter dark">Starting at</div>
                <div>
                  <span>$99</span><small class="text-14-inter">/month</small>
                </div>
              </div>
              <button type="button" class="global--qua--button w-full"
                ><img
                  class="btn--icon"
                  src="/assets/icons/arrow-right.svg"
                  alt="" loading="lazy" />See if you Quality</button
              >
              <div class="cancel-text">Cancel Anytime</div>
            </div>
          </div>
          <div
            class="medicine-footer-note"
          >
            <p>
              *Price reflects the 12-month plan. 1-, 3-, and 6-month plan
              lengths available at higher monthly rates. See checkout for full
