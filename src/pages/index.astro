---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import image18 from '../assets/products-imgs/image-18.png';
import image19 from '../assets/products-imgs/image-19.png';
import image20 from '../assets/products-imgs/image-20.png';
import image21 from '../assets/products-imgs/image-21.png';
import beforeImg from '../assets/before-after/before.png';
import afterImg from '../assets/before-after/after.png';
import hipaaBadge from '../assets/badges/hipaa_badge.png';
import legitScript from '../assets/badges/49921676.png';
import usaBadge from '../assets/badges/usa_badge.png';
import closeIcon from '../assets/icons/close.png';
import arrowCircleRight from '../assets/icons/arrow-circle-right.png';
---

<Layout title="Compounded GLP-1 & Peptide Telehealth | Freeley Wellness">
  <Fragment slot="head">
    <!-- Font playfair display embed -->
    <style>
        .swiper_before_after {}
        .swiper_before_after .swiper-slide {
            max-width: fit-content;
            width: 100%;
        }
        .featured-logos {
            justify-content: flex-start;
        }
        .featured-logos span {
            opacity: 0.3;
        }
        .rhemsleves-row {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }
        @media (max-width: 768px) {
            .rhemsleves-row {
                display: flex;
                gap: 15px;
                margin-bottom: 15px;
                flex-direction: column;
                max-width: 100%;
                overflow: hidden;
            }
        }
    </style>
  </Fragment>

    <main class="homepage">
        <!-- Header -->
        <Header />

      <!-- Hero Section -->
      <section class="hero py-5">

        <div class="container hero--container py-5">
       <div class="fig-hero__couple" aria-hidden="true">
        </div>
          <div class="grid grid-cols-1 md:grid-cols-12 relative">
            <div class="md:col-span-8 lg:col-span-7">
              <div
                class="bordered--heading inline-block px-4 mb-3"
              >
                <span class="uppercase">Physician-Prescribed</span>
              </div>
              <h1
                class="flex flex-col"
              >
                Your Last Diet Didn't Fail.
                <span class="text-highlight">Your Biology Did.</span>
              </h1>
              <p
                class="lead"
              >
                Real doctors. Real Rx. Delivered to your door
              </p>
              <img
                src="/assets/home/hero-mob.png"
                alt="Freeley patients"
                loading="eager"
                class="hero-img-mobile w-full rounded-2xl mb-6"
              />
              <div
                class="bordered--heading extra-border mt-4 inline-block px-4 mb-6"
              >
                <span class="uppercase"
                  >WHAT'S YOUR WEIGHT LOSS GOAL?</span
                >
              </div>
              <div
                class="mb-6"
              >
                <div class="weight-guide grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-2 m-0">
                  <div
                    class="weight-item"
                    id="start-assessment1"
                  >
                    <span class="weight-range">10–25 lbs </span
                    ><span
                      ><img src="/assets/icons/arrow-right-green.svg" alt="" loading="eager" /></span>
                  </div>
                  <div
                    class="weight-item"
                    id="start-assessment2"
                  >
                    <span class="weight-range">25–50 lbs </span
                    ><span
                      ><img src="/assets/icons/arrow-right-green.svg" alt="" loading="eager" /></span>
                  </div>
                  <div
                    class="weight-item"
                    id="start-assessment3"
                  >
                    <span class="weight-range">50+ lbs</span>
                    <span
                      ><img src="/assets/icons/arrow-right-green.svg" alt="" loading="eager" /></span>
                  </div>
                </div>
                <div class="assessment-link">
                  <span>Not sure? </span
                  ><button type="button" id="start-full-assessment"
                    >Start the full assessment</button
                  >
                </div>
              </div>
              <div
                class="steps--container md:flex hidden"
              >
                <div class="step">
                  <div class="step--number">1</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">2 Minute Intake</div>
                    <div class="step--subtitle">Quick & secure</div>
                  </div>
                </div>
                <div class="step">
                  <div class="step--number">2</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">Physician Reviewed</div>
                    <div class="step--subtitle">Same Day</div>
                  </div>
                </div>
                <div class="step">
                  <div class="step--number">3</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">Delivered in 48hrs</div>
                    <div class="step--subtitle">To your door</div>
                  </div>
                </div>
              </div>

              <div
                class="steps--container gap-4 md:hidden grid grid-cols-1"
              >
                <div class="step mb-2">
                  <div class="step--number">1</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">2 Minute Intake</div>
                  </div>
                </div>
                <div class="step mb-2">
                  <div class="step--number">2</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">Physician Reviewed</div>
                  </div>
                </div>
                <div class="step mb-2">
                  <div class="step--number">3</div>
                  <div class="flex gap-2 flex-col">
                    <div class="step-title">Delivered in 48hrs</div>
                  </div>
                </div>
              </div>

              <div
                class="hero--testimonial pr-0 mb-0 md:mb-12 md:pr-12 mt-6"
              >
                <p class="text-black mb-6">Testimonials</p>
                <span
                  >&#8220;I tried every diet app imaginable. Nothing stuck until my
                  doctor started me on semaglutide through Freeley. The cravings
                  just… stopped. I&#8217;m down 31 lbs and my A1C went from 6.4 to
                  5.6.&#8221;</span
                >
              </div>
            </div>
            <div class="md:col-span-4 lg:col-span-5"></div>
          </div>
        </div>
        <div
          class="container position-relative z-2 py-3 percentage--container"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 protocol--text">
            <div class="flex flex-col md:flex-row gap-2">
              <div class="percentage">15%</div>
              <div>
                <p>
                  Average body weight lost by patients on our physician-guided
                  GLP-1 protocol
                </p>
                <p class="medicine-footer-note">*Based on internal program data.</p>
              </div>
            </div>
            <div class="verified--text">
              <div class="text-left mb-4 block md:hidden">
                <span>Verified &amp; Certified</span>
              </div>
              <div
                class="flex justify-start md:justify-end items-end md:items-center gap-4 md:gap-12 protocol--imgs"
              >
                <div class="flex-1 hidden md:block">
                  <span>Verified &amp; Certified</span>
                </div>
                <div class="swiper verified-badges-swiper flex-1">
                  <div class="swiper-wrapper items-center">
                    <div class="swiper-slide">
                      <Image
                        src={hipaaBadge}
                        alt="HIPAA compliance badge"
                        class="img-fluid"
                        loading="eager"
                      />
                    </div>
                    <div class="swiper-slide">
                      <Image
                        src={legitScript}
                        alt="LegitScript certification badge"
                        class="img-fluid"
                        loading="eager"
                      />
                    </div>
                    <div class="swiper-slide">
                      <Image
                        src={usaBadge}
                        alt="USA-based badge"
                        class="img-fluid"
                        loading="eager"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="container z-2 position-relative blur--bg"
          id="start-assessment"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 items-center">
            <div class="flex flex-col gap-4 left">
              <strong>Start Assessment</strong>
              <div class="from--to">
                From <span>$99</span> Physician-supervised
              </div>
            </div>
            <div
              class="flex justify-start md:justify-end gap-4 mt-4 md:mt-0 right"
            >
              <button
                type="button"
                id="start-assessment4"
                class="cta--global w-full md:w-1/3 text-center"
                ><span>Start Your Assessment</span></button
              >
            </div>
          </div>
        </div>
      </section>

      <section>
        <div id="quiz--modal" class="modal">
          <div class="modal-content">
            <span class="close" id="close--quiz"
              ><Image src={closeIcon} alt="Close" loading="lazy"
            /></span>
            <div class="processing-loader" id="loader"></div>
            <div id="quiz--container"></div>
          </div>
        </div>
      </section>

      <!-- Benefits -->
      <section class="benefits py-5">
        <div class="container">
          <div class="benefits-grid grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="benefits-grid__lead">
              <div class="benefit--item">
                <div class="item--img"></div>
                <div class="flex justify-between pt-4 px-4">
                  <h3>Weight Loss</h3>
                  <Image src={arrowCircleRight} alt="" loading="lazy" />
                </div>
              </div>
            </div>
            <div class="benefits-grid__offset">
              <div class="benefit--item">
                <div class="item--img"></div>
                <div class="flex justify-between pt-4 px-4">
                  <h3>Sexual Wellness</h3>
                  <Image src={arrowCircleRight} alt="" loading="lazy" />
                </div>
              </div>
            </div>
            <div>
              <div class="benefit--item">
                <div class="item--img"></div>
                <div class="flex justify-between pt-4 px-4">
                  <h3>Hair Loss</h3>
                  <Image src={arrowCircleRight} alt="" loading="lazy" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

