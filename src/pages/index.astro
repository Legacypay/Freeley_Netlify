                {t.icon === 'pharmacy' && <path d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 0 8H8a4 4 0 0 1-4-4ZM12 12v8M8 16h8" />}
                {t.icon === 'lock' && <path d="M6 10V7a6 6 0 0 1 12 0v3M5 10h14v11H5z" />}
                {t.icon === 'box' && <path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3ZM3 7.5 12 12l9-4.5" />}
                {t.icon === 'card' && <path d="M3 6h18v12H3zM3 10h18" />}
              </svg>
              {t.label}
