      @media (min-width: 900px) { .wl-journey__list { display: none; } }
      .wl-tl { display: flex; gap: 14px; }
      .wl-tl__dot { flex: none; width: 14px; height: 14px; border-radius: 999px; background: #fff; margin-top: 5px; box-shadow: 0 0 0 6px rgba(255,255,255,.18); }
      .wl-tl__badge { display: inline-block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--green); background: #fff; border-radius: 999px; padding: 3px 10px; margin-bottom: 8px; }
