                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"/><path d="M8.47 10.74 12 14.26l3.53-3.52"/></svg>
                </span>
              </div>
              <div class="faq-answer"><div><p>{f.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Referral ═══ -->
    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap">
        <div class="wl-refer">
          <div>
            <h2 class="wl-serif">Give $50, get $50</h2>
            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>
          </div>
          <a href="/about" class="wl-btn-ghost">Share &amp; save <span class="wl-arw">→</span></a>
        </div>
      </div>
    </section>

    <!-- ═══ Closing band ═══ -->
    <section class="wl-close">
      <div class="wl-wrap wl-close__grid">
        <div>
          <h2 class="wl-serif">Feel better,<br /><em>starting today.</em></h2>
          <p>Personalized care for every part of you, from weight to skin, sleep to sexual health.</p>
          <div class="wl-close__feats">
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> No credit card required</span>
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Takes 2 minutes</span>
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Cancel anytime</span>
          </div>
        </div>
        <button type="button" class="wl-btn wl-btn--light" id="start-assessment6">
          Start Your Assessment <span class="wl-arw">→</span>
        </button>
      </div>
    </section>

    <!-- Quiz modal — opened by every #start-assessment* trigger above -->
    <div id="quiz--modal" class="modal">
      <div class="modal-content">
        <span class="close" id="close--quiz"><img src="/assets/icons/close.png" alt="Close" /></span>
        <div class="processing-loader" id="loader"></div>
        <div id="quiz--container"></div>
      </div>
    </div>

    <Footer />
  </main>

  <script src="/style/script.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
  <script src="/assets/js/wl-script.js" is:inline></script>
</Layout>
