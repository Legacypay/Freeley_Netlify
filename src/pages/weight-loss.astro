  <script src="/style/script.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
  <script src="/assets/js/wl-script.js" is:inline></script>
  <script is:inline>
    /* Journey timeline: 20s loop that starts when the section first reaches
       the viewport and pauses whenever it leaves. Same protocol as
       /prototype: is-armed is added from JS on purpose, so a visitor
       without JS keeps the finished timeline instead of a blank box. */
    (function () {
      var t = document.querySelector('.wl-journey__timeline');
      if (!t || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
      t.classList.add('is-armed');
      new IntersectionObserver(function (entries) {
        var seen = entries[0].isIntersecting;
        if (seen) t.classList.add('is-live');
        t.classList.toggle('is-idle', !seen);
      }, { threshold: 0.25 }).observe(t);
    })();
  </script>
