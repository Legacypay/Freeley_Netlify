      .wl-refer h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 2.8vw, 2.1rem); margin: 0 0 8px; line-height: 1.15; }
      .wl-refer p { color: var(--muted); font-size: 14.5px; margin: 0; max-width: 46ch; }

      .wl-close { background: var(--green-deep); color: #fff; }
      .wl-close__grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 26px; padding-top: 56px; padding-bottom: 56px; }
      .wl-close h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.2vw, 2.5rem); margin: 0 0 10px; color: #fff; line-height: 1.12; }
      .wl-close h2 em { font-style: italic; color: #cdb98f; }
      .wl-close p { color: rgba(255,255,255,.65); font-size: 14.5px; margin: 0; max-width: 42ch; }
      .wl-close__feats { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 18px; }
      .wl-close__feats span { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.85); }

      /* ── Motion, gated exactly as /prototype gates it ───────── */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .wl-mech__card, .wl-ba__card, .wl-why__img { animation: wlRise linear both; animation-timeline: view(); animation-range: entry 6% cover 24%; }
          @keyframes wlRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
        }
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .wl-mech__card, .wl-ba__card { transition: translate .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease; }
        .wl-mech__card:hover, .wl-ba__card:hover { translate: 0 -6px; box-shadow: 0 20px 40px rgba(23,34,42,.14); }
      }

      /* ── Legacy cascade overrides ───────────────────────────────
         wl-script.js and script.js force these exact class names, and
         public/style/style.css already styles them for the OLD design
         (Inter/Poppins, #004C27, #005c2b). Every selector here is
         .wl-page-prefixed so it outranks the legacy rule and cannot
         reach the other verticals that share those classes. !important
         appears only where the legacy declaration is itself !important
         — style.css:3646 and :3657. Verified by computed style, not by
         reading the cascade. */
      .wl-page .medication-toggle .btn { font-family: var(--font-sans); font-size: 14px; padding: 11px 22px; color: var(--muted) !important; }
      .wl-page .medication-toggle .btn.active-medication { background: var(--green) !important; color: #fff !important; }
      .wl-page #featuresList .feature-text { font-family: var(--font-sans); font-size: 14.5px; font-weight: 400; line-height: 1.45; color: var(--ink); }
      .wl-page .faq-question-text { color: var(--ink); }
      /* legacy .faq-answer ships padding:14px 20px + margin-top, which
         leaves a gap even when the row is collapsed to 0fr. */
      .wl-page .faq-answer { padding: 0; margin-top: 0; }
      .wl-page .faq-answer p { font-family: var(--font-sans); }
      /* global.css:591 sets `.swiper { overflow: visible !important }`
         site-wide, so every carousel bleeds past its container. /prototype's
         rows clip at the wrap, so these two do too. !important is required
         to answer !important; the .wl-page prefix keeps it off the other
         verticals that rely on the bleed. */
      .wl-page .wl-mech.swiper, .wl-page .wl-ba.swiper { overflow: hidden !important; }

      /* Quiz modal — legacy chrome, styling kept local so it no longer
         depends on the old page's cascade. */
      #quiz--modal { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(10,20,15,.55); }
      #quiz--modal .modal-content { position: relative; background: #fff; max-width: 620px; margin: 6vh auto; border-radius: 18px; overflow: hidden; }
      #quiz--modal .close { position: absolute; top: 12px; right: 12px; z-index: 2; cursor: pointer; }
      #quiz--modal .close img { width: 26px; height: 26px; }
      .processing-loader { display: none; width: 34px; height: 34px; margin: 60px auto; border: 3px solid var(--line); border-top-color: var(--brand); border-radius: 50%; animation: wlSpin .8s linear infinite; }
      @keyframes wlSpin { to { transform: rotate(360deg); } }
    </style>
