---
// WEIGHT LOSS — rebuilt 2026-07-24 in the /prototype design language.
//
// ── Impeccable direction contract ────────────────────────────────────
// THESIS: /prototype is the new landing and owns the visual world; this
//   page is the vertical a visitor lands ON, so it inherits that world
//   wholesale and spends it on one job — getting a GLP-1 candidate into
//   intake. It refuses the old page's stacked-band layout where every
//   section looked equally loud.
// OWN-WORLD: inherited from /prototype, unchanged. Cream ground, forest
//   green, gold price. Source Serif 4 display with italic emphasis,
//   Archivo text, Archivo Narrow for the compliance register.
// STORY: your biology, not your willpower → here is the molecule and who
//   prescribes it → here is what the months actually look like → start.
// FIRST VIEWPORT: serif headline left, real patient photo right, the
//   three weight-goal doors directly under the price.
// FORM: extension of an established surface — no concept tournament.
// ─────────────────────────────────────────────────────────────────────
//
// EVERY DOM hook in public/assets/js/wl-script.js is preserved verbatim:
//   modal      #quiz--modal #loader #quiz--container #close--quiz
//   triggers   #start-full-assessment #start-assessment1..6
//   gallery    #mainProductImage #prevBtn #nextBtn #dotContainer
//              #thumbnailsContainer #featuresList
//   toggle     .medication-toggle .btn[data-medication] .active-medication
//   live text  .product-title .product-current-price
//              .text-decoration-line-through .popular-badge
//   swipers    .ok--section.swiper .brand--grid--hero.swiper .transformSwiper.swiper
//   accordion  .faq-item > .faq-question   (public/style/script.js toggles .open)
// Class names for layout are `wl-` prefixed so none of the legacy
// global.css / style.css cascade reaches this markup. Layout.astro puts
// <slot name="head"/> last in <head>, so the block below outranks both.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ASSESSMENT = '/assessment-quiz';

// Weight-goal doors — each id is a quiz-modal trigger wl-script.js binds.
const goals = [
  { id: 'start-assessment1', label: '10–25 lbs' },
  { id: 'start-assessment2', label: '25–50 lbs' },
  { id: 'start-assessment3', label: '50+ lbs' },
];

// Real ladder from pricing.json (semaglutide). The old page printed "$99*"
// on all three tiers, which is only the 12-month rate — see the note in
// PRODUCT.md about the qualifier having to travel with the number.
const plans = [
  { months: '1 month', price: '$194', save: null },
  { months: '3 months', price: '$149', save: 'Save 23%' },
  { months: '6 months', price: '$124', save: 'Save 36%' },
  { months: '12 months', price: '$99', save: 'Save 49%', best: true },
];

const trustPoints = [
  'Board-Certified Physicians',
  '503A Licensed Pharmacy',
  'HIPAA Compliant',
  'HSA/FSA Accepted',
  'Free Shipping',
  'Cancel Anytime',
];

// The five "what's inside" cards. Images are the page's own existing
// assets, previously reachable only as ::before backgrounds keyed to
// legacy class names in global.css — referenced directly now.
const mechanisms = [
  {
    title: 'Quiets the "food noise"',
    desc: "GLP-1s target the brain's hunger receptors. The constant cravings and obsession over your next meal disappear.",
    img: '/assets/wl/QuietsThe_FoodNoise_.png',
    tint: '#C6CCDA',
  },
  {
    title: 'You stay full longer',
    desc: 'It slows down stomach emptying. Small portions finally make you feel completely satisfied and full.',
    img: '/assets/wl/YouStayFullLonger.png',
    tint: '#D2CBC2',
  },
  {
    title: 'Improves metabolic health',
    desc: 'By balancing blood sugar and insulin levels, your body stops hoarding fat and starts burning it.',
    img: '/assets/wl/ImprovesMetabolicHealth.png',
    tint: '#D1D9DC',
  },
  {
    title: 'Compounded securely in 503A pharmacies',
    desc: 'Prepared to your prescription by a licensed compounding facility, tested for potency, sterility, and purity.',
    img: '/assets/wl/Compounded_securely_in_503A_Pharmacies.png',
    tint: '#E4DDD4',
  },
  {
    title: 'Overseen by board-certified physicians',
    desc: 'A licensed U.S. physician reviews your intake, writes your plan, and adjusts your dose as you go.',
    img: '/assets/wl/OverseenbyBoard-CertifiedPhysicians.png',
    tint: '#F6EEE0',
  },
];

const press = [
  { src: '/assets/brands/bloomberg.svg', name: 'Bloomberg' },
  { src: '/assets/brands/forbes.svg', name: 'Forbes' },
  { src: '/assets/brands/new_york.svg', name: 'The New York Times' },
  { src: '/assets/brands/tech_crunch.svg', name: 'TechCrunch' },
];

// Timeline. The old page's fourth entry was hair-loss copy ("noticeably
// thicker, denser hair") under a duplicated "Month 6" label — dropped
// rather than rewritten, since a replacement would be an invented claim.
const timeline = [
  {
    badge: 'Month 1',
    phase: 'The Reset',
    tag: 'Appetite Control',
    desc: "Your appetite decreases significantly. You'll naturally eat smaller portions and feel fuller much faster. Less bloating is common.",
  },
  {
    badge: 'Month 3',
    phase: 'The Momentum',
    tag: 'Visible Results',
    desc: "You're dropping consistent, healthy weight week over week. Clothes fit significantly better. Energy levels stabilize without sugar crashes.",
  },
  {
    badge: 'Month 6',
    phase: 'The Transformation',
    tag: 'Full Payoff',
    desc: 'Significant, noticeable weight loss. Improved metabolic markers. The compounding effect of healthy eating feels effortless.',
  },
];

// ⚠️ The old page shipped three FAQs whose answers were all the same
// side-effects paragraph, answering none of their questions. The
// side-effect copy is kept verbatim under the question it actually
// answers; the other two are written from PRODUCT.md facts only.
// Flagged for owner review — no medical claim here is invented.
const faqs = [
  {
    q: 'Do I need insurance?',
    a: 'No. Freeley does not bill insurance: you pay one flat monthly price with no membership fee and no hidden charges. Plans are FSA/HSA eligible, and you can cancel at any time.',
  },
  {
    q: 'What are the most common side effects?',
    a: 'Most common side effects are mild gastrointestinal symptoms that typically improve over time. These may include nausea, vomiting, diarrhea, or constipation.',
  },
  {
    q: 'What is compounded medication?',
    a: 'A compounded medication is prepared for you by a licensed 503A pharmacy following USP standards, rather than mass-produced. Compounded medications are not FDA-approved and are not equivalent to the brand-name drug.',
  },
];
---

<Layout title="GLP-1 Weight Loss Treatment | Freeley">
  <Fragment slot="head">
    <style is:inline>
      /* Design tokens are already declared in public/style/style.css :root
         (--green, --cream, --font-serif, …). Everything below is scoped to
         wl- classes so no legacy rule collides. */
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }

      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-price { font-family: var(--font-serif); color: var(--gold); font-weight: 600; }
      .wl-foot { font-size: 11.5px; color: var(--muted); margin-top: 16px; }

      /* Buttons — same two shapes /prototype uses. */
      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-btn-ghost { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; cursor: pointer; transition: background .15s; }
      .wl-btn-ghost:hover { background: #faf8f2; color: var(--ink); }
      .wl-btn-ghost .wl-arw { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: var(--green); color: #fff; }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }

      /* ── Hero ───────────────────────────────────────────────── */
      .wl-hero { position: relative; overflow: hidden; }
      .wl-hero__img { display: none; }
      @media (min-width: 1024px) {
        .wl-hero__img {
          display: block; position: absolute; top: 0; right: 0;
          /* no max-height: the column's own height sets the section height,
             and any cap shorter than that leaves a hard horizontal cut where
             the photo stops against the cream. */
          width: 46%; height: 100%;
          object-fit: cover; object-position: center 25%;
          -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%);
          mask-image: linear-gradient(to right, transparent 0%, #000 30%);
        }
      }
      .wl-hero__inner { position: relative; z-index: 2; padding-top: 40px; padding-bottom: 64px; }
      .wl-hero__col { max-width: 560px; }
      @media (min-width: 1024px) { .wl-hero__col { max-width: 54%; } }
      /* height:auto is load-bearing next to aspect-ratio — a width/height
         attribute pair would otherwise win and defeat the ratio box. */
      /* hero-mob.png is a 337x525 transparent cutout, not a photo plate —
         forcing it into a landscape ratio box with object-fit:cover crops the
         subject and strands it off-centre. Centre the cutout on the cream
         instead, the same treatment /prototype gives its vials. */
      .wl-hero__img-mob { display: block; width: auto; height: auto; max-height: 320px; margin: 10px auto 28px; }
      @media (min-width: 1024px) { .wl-hero__img-mob { display: none; } }
      .wl-hero h1 { font-size: clamp(2.6rem, 5.4vw, 4.2rem); line-height: 1.04; margin: 18px 0 20px; }
      .wl-hero__sub { font-size: 1.05rem; color: var(--muted); margin: 0 0 26px; max-width: 46ch; }

      .wl-badgeline { display: inline-flex; align-items: center; gap: 8px; background: rgba(15,107,69,.06); border: 1px solid rgba(15,107,69,.16); border-radius: 999px; padding: 6px 14px 6px 10px; }
      .wl-badgeline img { width: 16px; height: auto; }
      .wl-badgeline span { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); }

      /* Weight-goal doors */
      .wl-goals { display: grid; gap: 10px; grid-template-columns: 1fr; margin: 0 0 14px; }
      @media (min-width: 560px) { .wl-goals { grid-template-columns: repeat(3, 1fr); } }
      .wl-goal { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 13px 18px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer; transition: border-color .15s, transform .15s; }
      .wl-goal:hover { border-color: var(--brand); }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) { .wl-goal:hover { transform: translateY(-2px); } }
      .wl-goal svg { flex: none; color: var(--brand); }
      .wl-notsure { font-size: 14px; color: var(--muted); margin: 0 0 6px; }
      .wl-notsure button { background: none; border: none; padding: 0; font: inherit; font-weight: 600; color: var(--brand); cursor: pointer; text-decoration: none; }
      .wl-notsure button:hover { text-decoration: underline; }
      .wl-hero__fineprint { font-family: var(--font-condensed); font-size: 12.5px; color: var(--muted); margin: 0 0 26px; }

      .wl-hero__from { font-size: 1rem; margin: 0 0 8px; }
      .wl-hero__from .wl-price { font-size: 1.7rem; }
      .wl-hero__qual { font-family: var(--font-condensed); font-size: 12.5px; color: var(--muted); display: block; margin-top: 2px; }

      .wl-quote { border-left: 2px solid var(--line); padding-left: 18px; margin: 30px 0 0; max-width: 48ch; }
      .wl-quote p { font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.5; font-style: italic; color: var(--ink); margin: 0 0 8px; }
      .wl-quote span { font-family: var(--font-condensed); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

      /* ── Plan ladder ────────────────────────────────────────── */
      .wl-plans { display: grid; gap: 10px; grid-template-columns: repeat(2, 1fr); margin: 0 0 4px; }
      @media (min-width: 700px) { .wl-plans { grid-template-columns: repeat(4, 1fr); } }
      .wl-plan { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; }
      .wl-plan--best { border-color: var(--brand); box-shadow: 0 6px 20px rgba(15,107,69,.10); }
      .wl-plan__price { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--ink); line-height: 1.1; }
      .wl-plan--best .wl-plan__price { color: var(--gold); }
      .wl-plan__mo { font-size: 12px; color: var(--muted); }
      .wl-plan__term { font-size: 13px; font-weight: 600; margin-top: 6px; }
      .wl-plan__save { display: inline-block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--brand); background: rgba(15,107,69,.08); border-radius: 999px; padding: 3px 9px; margin-top: 8px; }

      /* ── Trust bar ──────────────────────────────────────────── */
      .wl-trustbar { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .wl-trustbar ul { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; list-style: none; margin: 0; padding-top: 20px; padding-bottom: 20px; }
      @media (min-width: 900px) { .wl-trustbar ul { grid-template-columns: repeat(6, auto); justify-content: space-between; } }
      .wl-trustbar li { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 500; }
      .wl-trustbar svg { color: var(--brand); flex: none; }
      .wl-certs { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; padding-top: 18px; padding-bottom: 18px; }
      .wl-certs > span { font-family: var(--font-condensed); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .wl-certs img { height: 40px; width: auto; }

      /* ── Section furniture ──────────────────────────────────── */
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }
      .wl-head { max-width: 660px; margin-bottom: 40px; }
      .wl-head--center { text-align: center; margin-left: auto; margin-right: auto; }
      .wl-head h2 { font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.1; margin: 14px 0 12px; }
      .wl-head p { color: var(--muted); font-size: 15px; margin: 0; }

      /* ── Inline CTA band ────────────────────────────────────── */
      .wl-band { background: var(--green); color: #fff; border-radius: 22px; padding: 34px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px; }
      .wl-band h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.6vw, 2rem); color: #fff; margin: 0 0 6px; line-height: 1.15; }
      .wl-band p { color: rgba(255,255,255,.75); font-size: 14px; margin: 0; }
      .wl-band p b { color: var(--gold); font-family: var(--font-serif); font-size: 1.15rem; }
      /* script.js pins this band on mobile scroll by adding .mobile-fixed.
         global.css already handles position/radius and hides .left; the band
         still carries section padding, so tighten it for the pinned state. */
      .wl-band.mobile-fixed { padding: 12px 20px; }

      /* ── Mechanism cards (swiper row) ───────────────────────── */
      /* Clip at the wrap edge — swiper's own overflow:hidden is correct
         here; the padding keeps the hover lift and its shadow from being
         shaved off by that clip. */
      .wl-mech.swiper { overflow: hidden; padding-top: 6px; padding-bottom: 16px; }
      .wl-mech .swiper-slide { width: 300px; height: auto; }
      @media (min-width: 700px) { .wl-mech .swiper-slide { width: 340px; } }
      .wl-mech__card { display: flex; flex-direction: column; height: 100%; border-radius: 18px; overflow: hidden; background: var(--card); }
      .wl-mech__img { aspect-ratio: 4 / 3; overflow: hidden; }
      .wl-mech__img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
      .wl-mech__body { padding: 20px 22px 24px; }
      .wl-mech__body h3 { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 600; margin: 0 0 8px; line-height: 1.25; }
      .wl-mech__body p { font-size: 13.5px; color: var(--muted); margin: 0; }

      /* ── Before / after ─────────────────────────────────────── */
      .wl-ba.swiper { overflow: hidden; padding-top: 6px; padding-bottom: 16px; }
      .wl-ba .swiper-slide { width: 320px; height: auto; }
      @media (min-width: 700px) { .wl-ba .swiper-slide { width: 400px; } }
      .wl-ba__card { background: var(--card); border-radius: 18px; padding: 16px; height: 100%; }
      .wl-ba__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .wl-ba__box { position: relative; border-radius: 12px; overflow: hidden; background: #fff; }
      .wl-ba__box img { width: 100%; height: auto; display: block; }
      .wl-ba__label { position: absolute; top: 10px; left: 10px; z-index: 1; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; background: rgba(255,255,255,.92); color: var(--ink); border-radius: 999px; padding: 3px 10px; }
      .wl-ba__box--after .wl-ba__label { background: var(--green); color: #fff; }
      .wl-ba__quote { font-family: var(--font-serif); font-size: 1.05rem; font-style: italic; margin: 16px 0 6px; }
      .wl-ba__note { font-size: 11.5px; color: var(--muted); margin: 0; line-height: 1.4; }

      /* ── Product showcase (JS-driven) ───────────────────────── */
      .wl-prod { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: start; }
      @media (min-width: 900px) { .wl-prod { grid-template-columns: 1fr 1fr; gap: 56px; } }
      .wl-prod__stage { background: var(--card); border-radius: 22px; padding: 22px; }
      .popular-badge { display: inline-block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; background: var(--gold); color: #fff; border-radius: 999px; padding: 5px 12px; }
      .wl-prod__frame { display: grid; place-items: center; padding: 26px 0 18px; min-height: 280px; }
      .wl-prod__frame img { max-height: 260px; width: auto; transition: opacity .2s ease; }
      .wl-prod__frame img.fade-out { opacity: 0; }
      .wl-prod__frame img.fade-in { opacity: 1; }
      .wl-prod__nav { display: flex; align-items: center; justify-content: space-between; }
      .wl-navbtn { background: #fff; border: 1px solid var(--line); border-radius: 999px; width: 42px; height: 42px; display: grid; place-items: center; cursor: pointer; color: var(--green); transition: border-color .15s; }
      .wl-navbtn:hover { border-color: var(--brand); }
      /* Fixed 18x6 box always reserved so activating a dot animates
         transform, never width — width would relayout the whole row. */
      #dotContainer { display: flex; align-items: center; gap: 7px; }
      #dotContainer .dot-indicator { width: 18px; height: 6px; border-radius: 999px; background: var(--line); cursor: pointer; transform: scaleX(.34); transition: transform .2s ease, background .15s ease; }
      #dotContainer .dot-indicator.active { background: var(--brand); transform: scaleX(1); }
      #thumbnailsContainer { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
      #thumbnailsContainer .thumb-box { border: 1px solid var(--line); border-radius: 12px; padding: 5px; cursor: pointer; background: #fff; transition: border-color .15s; }
      #thumbnailsContainer .thumb-box.active { border-color: var(--brand); }

      .wl-trustpilot { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
      .wl-trustpilot span { font-family: var(--font-condensed); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
      .wl-trustpilot img { height: 18px; width: auto; }
      .product-title { font-family: var(--font-serif); font-size: clamp(1.7rem, 3vw, 2.2rem); font-weight: 600; margin: 0 0 8px; line-height: 1.15; }
      .wl-prod__lede { font-size: 14.5px; color: var(--muted); margin: 0 0 20px; }

      .medication-toggle { display: inline-flex; gap: 6px; padding: 5px; background: var(--card); border-radius: 999px; margin-bottom: 24px; }
      .medication-toggle .btn { border: none; background: transparent; border-radius: 999px; padding: 11px 22px; font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--muted); cursor: pointer; transition: background .15s, color .15s; }
      /* 0,3,0 — outranks the .text-white / .text-success utility classes
         wl-script.js swaps in at runtime, which Tailwind may never emit. */
      .medication-toggle .btn.active-medication { background: var(--green); color: #fff; }

      .wl-pricerow { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 4px; }
      .product-current-price { font-family: var(--font-serif); font-size: 2.6rem; font-weight: 600; color: var(--gold); line-height: 1; }
      .text-decoration-line-through { text-decoration: line-through; color: var(--muted); font-size: 16px; opacity: .75; }
      .wl-prod__per { font-family: var(--font-condensed); font-size: 13px; color: var(--muted); margin: 0 0 24px; }

      #featuresList { margin-bottom: 24px; }
      #featuresList .feature-item { display: flex; align-items: center; gap: 11px; margin-bottom: 11px; font-size: 14.5px; }
      #featuresList .feature-icon { flex: none; width: 22px; height: 22px; border-radius: 999px; background: var(--brand); display: grid; place-items: center; }
      .wl-note { display: flex; align-items: flex-start; gap: 10px; background: #fbf5e6; border: 1px solid #ecd9a8; border-radius: 12px; padding: 13px 15px; margin-bottom: 24px; }
      .wl-note p { font-size: 13px; color: #6b5522; margin: 0; }
      .wl-note svg { flex: none; margin-top: 1px; }

      /* ── Journey ────────────────────────────────────────────── */
      .wl-journey { position: relative; overflow: hidden; border-radius: 22px; background: var(--green); }
      .wl-journey__bg { position: absolute; inset: 0; background-image: url('/assets/wl/Here_sWhatHappensNext.png'); background-size: cover; background-position: center; }
      .wl-journey__inner { position: relative; z-index: 1; padding: 44px 34px 0; min-height: 560px; display: flex; flex-direction: column; justify-content: space-between; }
      .wl-journey__head { max-width: 460px; }
      .wl-journey__head .wl-eyebrow { color: #fff; opacity: .85; }
