      .wl-tl__phase b { color: #fff; font-size: 14.5px; font-weight: 600; }
      .wl-tl__tag { font-size: 12.5px; color: #fff; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; padding: 3px 11px; }
      .wl-tl p { font-size: 13.5px; color: rgba(255,255,255,.82); margin: 0; line-height: 1.5; }

      /* ── Why trust ──────────────────────────────────────────── */
      .wl-why { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 900px) { .wl-why { grid-template-columns: 1fr 1fr; gap: 56px; } }
      .wl-why__img { border-radius: 20px; overflow: hidden; }
      .wl-why__img img { width: 100%; height: auto; display: block; }
      .wl-why__pt { margin-bottom: 22px; }
      .wl-why__pt-head { display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
      .wl-why__pt-head h3 { font-size: 1rem; font-weight: 600; margin: 0; }
      .wl-why__pt p { font-size: 14px; color: var(--muted); margin: 0; max-width: 52ch; }
      .wl-tick { flex: none; width: 22px; height: 22px; border-radius: 999px; background: var(--brand); display: grid; place-items: center; }

      /* ── Press ──────────────────────────────────────────────── */
      .wl-press { display: flex; flex-wrap: wrap; align-items: center; gap: 34px; padding-top: 8px; padding-bottom: 56px; }
      .wl-press > span { font-family: var(--font-condensed); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .wl-press img { height: 22px; width: auto; opacity: .62; filter: grayscale(1); }
      .wl-press .swiper-slide { width: auto; }

      /* ── FAQ ────────────────────────────────────────────────── */
      .wl-faqs { max-width: 780px; margin: 0 auto; }
      .faq-item { border-bottom: 1px solid var(--line); }
      .faq-question { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; cursor: pointer; }
      .faq-question-text { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
      .faq-toggle-icon { flex: none; color: var(--green); transition: transform .25s ease; }
      .faq-item.open .faq-toggle-icon { transform: rotate(180deg); }
      /* grid-template-rows animates without measuring — no JS height math. */
      .faq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease; }
      .faq-item.open .faq-answer { grid-template-rows: 1fr; }
      .faq-answer > div { overflow: hidden; }
      .faq-answer p { font-size: 14.5px; color: var(--muted); margin: 0 0 22px; max-width: 62ch; line-height: 1.6; }

      /* ── Referral + closing band ────────────────────────────── */
