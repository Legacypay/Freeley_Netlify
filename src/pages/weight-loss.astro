                  </radialGradient>
                </defs>
                {/* The line from the flattened graph.svg export, verbatim. */}
                <path class="wl-jline" pathLength="100" d="M37 301L305.5 170L587 66L873.279 22H1117" />
                {timeline.map((t, i) => (
                  <g class={`wl-jnode wl-jnode--${i + 1}`}>
                    <circle cx={t.x} cy={t.y} r="15" fill="url(#wlGlow)" />
                    <circle cx={t.x} cy={t.y} r="7" fill="#fff" />
                  </g>
                ))}
              </svg>
              {timeline.map((t, i) => (
                <div class={`wl-jstop wl-jstop--${i + 1}`}>
