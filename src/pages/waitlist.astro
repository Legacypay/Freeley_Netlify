---
// TEMPORARY "coming soon" waitlist page. The whole site is gated to this via
// netlify.toml. To remove the waitlist and restore the real site, see
// WAITLIST.md at the repo root (do not just delete this file — the gate lives
// in netlify.toml).
// Hallmark-enriched: showcases people + products while email capture stays the
// primary action. Kept by client brand: italic display emphasis + gold price.
import { Image } from 'astro:assets';
import logo from '../assets/brand/freeley_logo_transparent_green.webp';
import heroPeople from '../assets/waitlist/hero-green-2.png';
import vialWeight from '../assets/waitlist/vial-weight-loss.png';
import trocheSexual from '../assets/waitlist/troche-sexual-wellness.png';
import vialHair from '../assets/waitlist/vial-hair-loss.png';
import vialLongevity from '../assets/waitlist/vial-longevity.png';

const products = [
  { name: 'GLP-1 Weight Loss', img: vialWeight },
  { name: 'Sexual Wellness', img: trocheSexual },
  { name: 'Hair Loss', img: vialHair },
  { name: 'Longevity & Peptides', img: vialLongevity },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700&display=swap"
      rel="stylesheet"
    />
    <title>Freeley — Something better is coming</title>
    <style is:inline>
      :root {
        --brand: #004c27;
        --brand-soft: #0a6a3a;
        --ink: #10241a;
        --muted: #5b6b62;
        --line: #dbe5de;
        --bg: #f4f8f4;
        --card: #eef3ee;
        --gold: #c39a4e;
        --focus: #0a6a3a;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; overflow-x: clip; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1100px 620px at 78% -8%, #e6f2ea 0%, transparent 60%),
          linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      img { max-width: 100%; display: block; }
      a:focus-visible, button:focus-visible, input:focus-visible {
        outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 10px;
      }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 26px; }
      .serif { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; }
      .price { font-family: 'Playfair Display', serif; color: var(--gold); font-weight: 600; }

      /* Header */
      .top { display: flex; align-items: center; justify-content: space-between; padding: 26px 0; }
      .top__logo { height: 34px; width: auto; }
      .top__tag { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); }

      /* Hero */
      .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; padding: 30px 0 20px; }
      @media (min-width: 860px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: 44px; padding: 44px 0 30px; } }
      .hero__copy { min-width: 0; }
      .eyebrow {
        display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--brand); background: #fff;
        border: 1px solid var(--line); border-radius: 999px; padding: 7px 16px; margin-bottom: 22px;
      }
      h1 {
        font-family: 'Playfair Display', Georgia, serif; font-weight: 600;
        font-size: clamp(2.3rem, 5.5vw, 3.4rem); line-height: 1.08; margin: 0 0 18px; color: var(--ink);
      }
      h1 em { font-style: italic; color: var(--brand); }
      .lead { font-size: 1.05rem; line-height: 1.6; color: var(--muted); margin: 0 0 30px; max-width: 460px; }

      form { display: flex; gap: 10px; max-width: 480px; }
      input[type='email'] {
        flex: 1; min-width: 0; font-size: 1rem; padding: 15px 18px; border: 1px solid var(--line);
        border-radius: 12px; background: #fff; color: var(--ink); outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input[type='email']:focus { border-color: var(--brand-soft); box-shadow: 0 0 0 3px rgba(10, 106, 58, 0.14); }
      button {
        font-family: inherit; font-size: 1rem; font-weight: 600; color: #fff; background: var(--brand);
        border: none; border-radius: 12px; padding: 15px 26px; cursor: pointer; white-space: nowrap;
        transition: background 0.15s, transform 0.05s;
      }
      button:hover:not(:disabled) { background: var(--brand-soft); }
      button:active:not(:disabled) { transform: translateY(1px); }
      button:disabled { opacity: 0.6; cursor: default; }
      .msg { min-height: 20px; font-size: 0.9rem; margin-top: 14px; }
      .msg.error { color: #b3261e; }
      .hint { font-size: 0.85rem; color: var(--muted); margin: 14px 0 0; }

      /* Success swap */
      .success { display: none; }
      body[data-joined='true'] #waitlist-form,
      body[data-joined='true'] .lead,
      body[data-joined='true'] .hint { display: none; }
      body[data-joined='true'] .success { display: block; }
      .success h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.6rem; color: var(--brand); margin: 0 0 10px; }
      .success p { color: var(--muted); font-size: 1rem; margin: 0; max-width: 420px; line-height: 1.6; }

      /* Hero image (people) */
      /* Transparent people cutout sits in a soft green rounded panel,
         bottom-aligned — reads as an intentional hero card, not a crop. */
      .hero__media {
        position: relative; min-width: 0;
        border-radius: 22px; overflow: hidden; padding-top: 22px;
        background: radial-gradient(135% 120% at 50% 8%, #eef5ef 0%, #d6e8db 100%);
        display: flex; align-items: flex-end; justify-content: center;
      }
      /* fade the torso-cut bottom of the cutout softly into the panel */
      .hero__media img {
        width: 100%; height: auto; display: block;
        -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
      }

      /* Trust strip */
      .trust { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 24px 0; }
      .trust ul { display: flex; flex-wrap: wrap; gap: 14px 34px; justify-content: center; list-style: none; margin: 0; padding: 18px 0; }
      .trust li { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 500; color: var(--ink); }
      .trust svg { color: var(--brand); flex: none; }

      /* Product preview */
      .preview { padding: 30px 0 20px; text-align: center; }
      .preview h2 { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 1.9rem; margin: 0 0 8px; }
      .preview h2 em { font-style: italic; color: var(--brand); }
      .preview__sub { color: var(--muted); font-size: 15px; margin: 0 auto 34px; max-width: 480px; }
      .prods { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      @media (min-width: 820px) { .prods { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
      .prod { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 22px 18px; }
      .prod__img { height: 120px; display: grid; place-items: center; margin-bottom: 12px; }
      .prod__img img { max-height: 120px; width: auto; object-fit: contain; }
      .prod__name { font-weight: 600; font-size: 14px; margin-bottom: 8px; }
      .prod__soon { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); background: #e9f2ec; border-radius: 999px; padding: 5px 12px; }

      /* Footer */
      .foot { text-align: center; padding: 40px 0 48px; color: var(--muted); }
      .foot__line { font-size: 0.9rem; font-weight: 500; color: var(--ink); }
      .foot__copy { font-size: 0.8rem; margin-top: 10px; }

      @media (max-width: 520px) { form { flex-direction: column; } }
    </style>
  </head>

  <body>
    <div class="wrap">
      <!-- Header -->
      <header class="top">
        <Image class="top__logo" src={logo} alt="Freeley" loading="eager" />
        <span class="top__tag">Launching soon</span>
      </header>

      <!-- Hero -->
      <section class="hero">
        <div class="hero__copy">
          <span class="eyebrow">The waitlist is open</span>
          <h1>Something better <em>is coming.</em></h1>
          <p class="lead">
            Physician-prescribed, doctor-guided care — compounded by licensed U.S.
            pharmacies and delivered to your door. Join the waitlist and be first
            in line when we open.
          </p>

          <form id="waitlist-form" novalidate>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="you@email.com"
              autocomplete="email"
              required
              aria-label="Email address"
            />
            <button type="submit" id="submit-btn">Notify me</button>
          </form>
          <div class="msg" id="msg" role="status" aria-live="polite"></div>
          <p class="hint">No spam — just one email the day we go live.</p>

          <div class="success">
            <h2>You're on the list.</h2>
            <p>Thanks for joining. We'll email you the moment Freeley goes live.</p>
          </div>
        </div>

        <div class="hero__media">
          <Image src={heroPeople} alt="Freeley patients" loading="eager" />
        </div>
      </section>

      <!-- Trust strip -->
      <div class="trust">
        <ul>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3v6a4 4 0 0 0 8 0V3M10 17a5 5 0 0 0 10 0v-2M20 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" /></svg>
            Licensed U.S. Physicians
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3ZM3 7.5 12 12l9-4.5" /></svg>
            U.S. Pharmacy Compounded
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 10V7a6 6 0 0 1 12 0v3M5 10h14v11H5z" /></svg>
            HIPAA Compliant
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 6 9 17l-5-5" /></svg>
            Cancel Anytime
          </li>
        </ul>
      </div>

      <!-- Product preview -->
      <section class="preview">
        <h2 class="serif">A first look at <em>what's launching</em></h2>
        <p class="preview__sub">Four physician-guided programs, compounded to your exact prescription.</p>
        <div class="prods">
          {products.map((p) => (
            <div class="prod">
              <div class="prod__img"><Image src={p.img} alt={p.name} loading="lazy" /></div>
              <div class="prod__name">{p.name}</div>
              <div><span class="prod__soon">Soon</span></div>
            </div>
          ))}
        </div>
      </section>

      <!-- Footer -->
      <footer class="foot">
        <div class="foot__line">Physician-prescribed · Delivered to your door</div>
        <div class="foot__copy">© 2026 Freeley. All rights reserved.</div>
      </footer>
    </div>

    <script>
      import { callRpc } from '../lib/supabaseClient';

      const form = document.getElementById('waitlist-form');
      const emailInput = document.getElementById('email');
      const btn = document.getElementById('submit-btn');
      const msg = document.getElementById('msg');
      const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        msg.className = 'msg';
        msg.textContent = '';

        if (!EMAIL_RE.test(email)) {
          msg.className = 'msg error';
          msg.textContent = 'Please enter a valid email address.';
          emailInput.focus();
          return;
        }

        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = 'Joining…';

        try {
          await callRpc('join_waitlist', { p_email: email });
          document.body.setAttribute('data-joined', 'true');
        } catch (err) {
          msg.className = 'msg error';
          msg.textContent = 'Something went wrong. Please try again.';
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    </script>
  </body>
</html>
