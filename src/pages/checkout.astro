            <input type="checkbox" id="consent-check" />
            <span>I have read and agree to the <a href="/telehealth-consent" target="_blank" rel="noopener">Telehealth Consent</a>, understand that my treatment may be declined based on the clinician's medical judgment, and <span id="consent-billing-clause">authorize Freeley to charge my card the plan amount today.</span></span>
          </label>

          <div id="payment-errors" role="alert" class="ck-error" style="margin: 0 0 12px"></div>

          <button class="ck-btn" id="checkout-btn" type="button" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span id="btn-text">Checkout</span>
          </button>
          <div id="checkout-spinner" class="ck-spinner">Processing your payment…</div>
          <p class="ck-note" id="checkout-footnote">Your card is tokenized in your browser and never stored on our servers.</p>

          <div class="ck-assure">
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>Free overnight shipping</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>FSA / HSA eligible</div>
          </div>

          <p class="ck-fine">The $20 clinician consultation fee is included in the program cost and is paid to our independent doctor network partners. It is processed whether or not you qualify for treatment; if your consultation results in a denial, you will not be responsible for it. By completing this purchase you agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</p>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
  <QuizModal />

    <script is:inline define:vars={{ AUTHNET_LOGIN_ID, AUTHNET_CLIENT_KEY, AUTHNET_SIMULATE, PRICING, BILLING }}>
        // ═══════════════════════════════════════════════════════
        // PRODUCT DATA – loaded from sessionStorage
        // ═══════════════════════════════════════════════════════

        let selectedProducts = [];
        let selectedPlanMonths = 3; // Default: 3 Months
        let productTotalPrice = 0;
        let selectedCompound = null; // set by setCheckoutCompound(), sent to the charge
        let appliedPromo = null; // { code, type, value, label } from validatePromo; server re-derives it

        /**
         * Load products from sessionStorage (set by quiz)
         */
        function loadProductsFromSession() {
            try {
                // Try to load from checkout_product_data first
                const productData = JSON.parse(
                    sessionStorage.getItem("checkout_product_data"),
                );
                if (productData) {
                    if (
                        productData.isBundle &&
                        productData.allProducts &&
                        productData.allProducts.length > 0
                    ) {
                        selectedProducts = productData.allProducts.map((p) => ({
                            id: p.id || "product-" + Date.now(),
                            name: p.title || "Treatment",
                            description: p.description || "",
                            image: p.image || "/assets/quiz/hair-lose.png",
                            // Use the individual product's price, don't override it
                            price: parseFloat((p.price || "$0").replace(/[$,]/g, "")) || 0,
                            benefits: p.benefits || [],
                        }));
                        // REMOVE the block that averages prices - this was causing all products to show the same price
                        renderProducts();
                        renderPlanSelector();
                        updateTotals();
                        return;
                    }

                    // Single product
                    if (productData.name) {
                        selectedProducts = [{
                            id: productData.treatmentType || "default",
                            name: productData.name || "Treatment Plan",
                            description: productData.desc || "",
                            image: productData.image ||
                                "/assets/quiz/hair-lose.png",
                            price: parseFloat(productData.monthlyPrice) || 49.99,
                            benefits: [],
                        }, ];
                        renderProducts();
                        renderPlanSelector();
                        updateTotals();
                        return;
                    }
                }

            } catch (e) {
                console.warn("[CHECKOUT] Could not read checkout_product_data:", e);
            }
            // No usable product in the session (direct hit on /checkout, expired
            // session, bookmark). Never fall back to a silent default: the old
            // code rendered $0.00 while the charge call still sent
            // treatment "hair-loss" / 3 months and billed $225. Show the empty
            // state and keep the button disabled until a real product exists.
            selectedProducts = [];
            renderProducts();
            renderPlanSelector();
            updateTotals();
            enableCheckout();
        }

        // ═══════════════════════════════════════════════════════
        // RENDER FUNCTIONS
        // ═══════════════════════════════════════════════════════

        /**
         * Render all selected products in the order summary
         */
        function renderProducts() {
            const container = document.getElementById("products-container");
            if (!container) return;

            if (!selectedProducts || selectedProducts.length === 0) {
                container.innerHTML = `
      <div class="ck-item ck-item--empty">
        <div class="ck-item__name">No treatment selected</div>
        <div class="ck-item__desc">Complete the assessment to pick a plan.</div>
      </div>`;
                syncCompoundSelector();
                return;
            }

            syncCompoundSelector();
            let html = "";
            selectedProducts.forEach((product, index) => {
                // Use the product's individual price, not a shared value
                const priceDisplay = index === 0 ? `$${currentTier()["1"].toFixed(2)}` : "";
                const entry = index === 0 ? currentCatalogEntry() : null;
                const imageSrc = (entry && entry.img) || product.image || "/assets/quiz/hair-lose.png";
                const name = (entry && entry.name) || product.name || "Treatment";
                const desc = entry ? entry.desc : (product.id === "hair-loss" ? HAIR_NOTE : (product.description || "Compounded medication"));

                html += `
      <div class="ck-item">
        <img src="${imageSrc}" alt="" class="ck-item__img" loading="lazy" />
        <div class="ck-item__body">
          <div class="ck-item__name">${name}</div>
          <div class="ck-item__desc">${desc}</div>
        </div>
        <div class="ck-item__price">${priceDisplay}${priceDisplay ? "<small>/mo</small>" : ""}</div>
      </div>
    `;
            });
            container.innerHTML = html;
        }

        // Authorize.Net ARB caps a months-based interval at 12, so only plans
        // up to 12 months auto-renew (mirrors ARB_MAX_INTERVAL_MONTHS in
        // netlify/functions/lib/authnet-arb.js). The 24-month plan is a single
        // payment for the whole term and the copy must never promise otherwise.
        const ARB_MAX_INTERVAL_MONTHS = 12;

        // Mirror of netlify/functions/lib/billing-model.js — resolves the
        // current treatment + compound to "subscription" or "one-time" from
        // pricing.json's `billing` block. Display only; the server decides.
        function normalizeCompound(compound) {
          const c = String(compound || "").trim().toLowerCase();
          if (!c) return "";
          if (c === "semaglutide" || c === "sema") return "sema";
          if (c === "tirzepatide" || c === "tirz") return "tirz";
          if (c.startsWith("olympus")) return "olympus";
          if (c.startsWith("nad")) return "nad-plus";
          return c;
        }
        function currentBilling() {
          const cfg = BILLING || {};
          const oneTime = new Set(Array.isArray(cfg.one_time) ? cfg.one_time : []);
          const subs = new Set(Array.isArray(cfg.subscription) ? cfg.subscription : []);
          const primary = selectedProducts[0] || {};
          const t = PRICING[primary.id] ? primary.id : "hair-loss";
          const c = normalizeCompound(selectedCompound);
          for (const id of c ? [`${t}:${c}`, t] : [t]) {
            if (oneTime.has(id)) return "one-time";
            if (subs.has(id)) return "subscription";
          }
          return cfg._default === "one-time" ? "one-time" : "subscription";
        }
        function planRenews(months) { return currentBilling() === "subscription" && months <= ARB_MAX_INTERVAL_MONTHS; }

        // Keep the step-1 hint and the consent clause truthful for the
        // product + plan on screen (auto-renewal must be disclosed before the
        // charge; a one-time product must never be described as recurring).
        function syncBillingCopy() {
          const hint = document.getElementById("plan-billing-hint");
          const clause = document.getElementById("consent-billing-clause");
          const subscriptionProduct = currentBilling() === "subscription";
          const renews = planRenews(selectedPlanMonths);
          if (hint) {
            hint.textContent = !subscriptionProduct
              ? "Longer plans lower your rate per day. This treatment is a single payment for the plan length you choose — it does not auto-renew."
              : "Longer plans lower your rate per day. Monthly through 12-month plans are subscriptions: you're billed today, then automatically at the same amount and cadence until you cancel. The 24-month plan is a single payment for the full term and does not auto-renew.";
          }
          const foot = document.getElementById("checkout-footnote");
          if (foot) {
            foot.textContent = "Your card is tokenized in your browser and never stored on our servers." +
              (renews ? " Cancel your subscription anytime from your Hub account — no phone call needed." : "");
          }
          if (clause) {
            clause.textContent = renews
              ? "authorize Freeley to automatically charge my card the plan amount today and every renewal period thereafter until I cancel."
              : "authorize Freeley to charge my card the plan amount today as a one-time payment.";
          }
        }

        /**
         * Render plan selector with collapsible cards (accordion behavior)
         */
        function renderPlanSelector() {
            const container = document.getElementById("plan-selector");
            if (!container) return;
            if (!selectedProducts || selectedProducts.length === 0) {
                container.innerHTML = "";
                return;
            }

            // Tiers come straight from pricing.json — the server charges
            // tier[months] * months and nothing else (no % discounts, no fee).
            const tier = currentTier();
            const monthly1 = tier["1"];
            const planOptions = Object.keys(tier).map(Number).sort((a, b) => a - b).map((m) => ({
                months: m,
                label: m === 1 ? "Pay Monthly" : `Pay For ${m} Months`,
                badge: m === 24 ? "BEST VALUE" : m === 6 ? "POPULAR" : "",
                savingPercent: Math.round((1 - tier[m] / monthly1) * 100),
            }));
            if (!tier[selectedPlanMonths]) selectedPlanMonths = planOptions[0].months;

            let html = "";
            planOptions.forEach((option) => {
                        const isActive = selectedPlanMonths === option.months;
                        const discountedPrice = tier[option.months];
                        const baseMonthlyPrice = monthly1;
                        const totalPrice = discountedPrice * option.months;
                        const perDay = (discountedPrice / 30).toFixed(2);
                        const savingTag =
                            option.savingPercent > 0 ? `(Save ${option.savingPercent}%)` : "";

                        const badgeHtml = option.badge ? `<span class="ck-plan__tag">${option.badge}</span>` : "";

                        html += `
          <div class="ck-plan ${isActive ? "is-active" : ""}" onclick="selectPlan(${option.months})" data-months="${option.months}" role="radio" aria-checked="${isActive}">
            ${badgeHtml}
            <span class="ck-plan__radio" aria-hidden="true"></span>
            <div class="ck-plan__body">
              <div class="ck-plan__name">${option.label} ${savingTag ? `<span class="ck-plan__save">${savingTag}</span>` : ""}</div>
              <div class="ck-plan__meta">${planRenews(option.months) ? `$${totalPrice.toFixed(2)} today, then every ${option.months === 1 ? "month" : option.months + " months"}` : `$${totalPrice.toFixed(2)} one-time for ${option.months} months, no auto-renewal`} · $${perDay}/day</div>
            </div>
            <div class="ck-plan__price">${baseMonthlyPrice > discountedPrice ? `<s>$${baseMonthlyPrice}</s>` : ""}<b>$${discountedPrice}</b><small>/mo</small></div>
          </div>
        `;
        });

        container.innerHTML = html;
      }

      /**
       * Select a plan by months - updates selection and totals
       */
      function selectPlan(months) {
        selectedPlanMonths = months;
        renderPlanSelector(); // Re-render to update active state
        updateTotals(); // Update prices
        enableCheckout(); // Enable button if consent is checked
      }

      /**
       * Update subtotal and total
       */
      function updateTotals() {
        if (!selectedProducts || selectedProducts.length === 0) {
          // Empty state — show $0 honestly and never a default tier's price.
          for (const id of ["totals-subtotal", "totals-total"]) {
            const el = document.getElementById(id);
            if (el) el.textContent = "$0.00";
          }
          const bt = document.getElementById("btn-text");
          if (bt) bt.textContent = "Complete the assessment first";
          const note = document.getElementById("totals-recurring-note");
          if (note) note.textContent = "";
          return;
        }
        // Mirrors create-authnet-transaction.js exactly: monthly tier price
        // × months. The $20 consultation is INCLUDED in that price (see the
        // fine print), never added on top.
        const tier = currentTier();
        const monthly = tier[selectedPlanMonths] || tier["1"];
        const total = monthly * selectedPlanMonths;
        // Same formula as lib/promos.js discountCents(): never below $1.
        const discount = !appliedPromo ? 0 : Math.max(0, Math.min(
          appliedPromo.type === "percent" ? Math.round(total * appliedPromo.value) / 100 : appliedPromo.value,
          total - 1));
        const grandTotal = total - discount;

        // Update display
        const subtotalEl = document.getElementById("totals-subtotal");
        const totalEl = document.getElementById("totals-total");
        const btnText = document.getElementById("btn-text");
        const discountRow = document.getElementById("totals-discount-row");
        if (discountRow) {
          discountRow.hidden = !appliedPromo;
          if (appliedPromo) {
            document.getElementById("totals-discount").textContent = `−$${discount.toFixed(2)}`;
            document.getElementById("promo-applied-code").textContent = appliedPromo.code;
          }
        }

        if (subtotalEl) subtotalEl.textContent = `$${total.toFixed(2)}`;
        if (totalEl) totalEl.textContent = `$${grandTotal.toFixed(2)}`;
        const renews = planRenews(selectedPlanMonths);
        if (btnText)
          btnText.textContent = renews
            ? `Subscribe — $${grandTotal.toFixed(2)} today`
            : `Pay $${grandTotal.toFixed(2)} once`;
        // The promo discount only ever applies to today's charge, never to
        // future renewals (the server schedules renewals at the FULL plan
        // price) — this note quotes the undiscounted total as what repeats,
        // so it can never understate a future charge.
        const recurringNote = document.getElementById("totals-recurring-note");
        if (recurringNote) {
          const cadence = selectedPlanMonths === 1 ? "month" : `${selectedPlanMonths} months`;
          recurringNote.textContent = renews
            ? `Then $${total.toFixed(2)} every ${cadence}, automatically, until you cancel.`
            : `One-time payment covering ${selectedPlanMonths} months. This plan does not renew automatically.`;
        }

        productTotalPrice = grandTotal;
        syncBillingCopy();
      }

      /**
       * Price tier for the current treatment + compound. MUST stay in sync
       * with the compoundKey mapping in create-authnet-transaction.js.
       */
      function currentTier() {
        const primary = selectedProducts[0] || {};
        const treatment = PRICING[primary.id] ? primary.id : "hair-loss";
        const c = String(selectedCompound || "").toLowerCase();
        let key = "default";
        if (treatment === "weight-loss") key = (c === "tirzepatide" || c === "tirz") ? "tirzepatide" : "semaglutide";
        else if (treatment === "longevity") key = c.startsWith("nad") ? "premium" : "standard";
        else if (treatment === "sexual-wellness" || treatment === "ed") key = c.startsWith("olympus") ? "premium" : "standard";
        return PRICING[treatment][key] || PRICING[treatment]["default"];
      }

      /**
       * Enable checkout button when consent is checked
       */
      function enableCheckout() {
        const btn = document.getElementById("checkout-btn");
        const consent = document.getElementById("consent-check");
        if (btn && consent) {
          // A real product from the quiz is required — never let consent alone
          // arm a charge for an empty cart (see loadProductsFromSession).
          btn.disabled = !consent.checked || !selectedProducts || selectedProducts.length === 0;
        }
      }

      // ═══════════════════════════════════════════════════════
      // PAYMENT VALIDATION & SUBMISSION
      // ═══════════════════════════════════════════════════════

      /**
       * Validate all checkout form fields
       */
      function validateCheckoutForm() {
        const fields = [
          { id: "pt-first-name", label: "First Name" },
          { id: "pt-last-name", label: "Last Name" },
          { id: "pt-dob", label: "Date of Birth" },
          { id: "pt-gender", label: "Gender" },
          { id: "pt-address", label: "Street Address" },
          { id: "pt-city", label: "City" },
          { id: "pt-state", label: "State" },
          { id: "pt-zip", label: "ZIP Code" },
          { id: "pt-email", label: "Email" },
          { id: "pt-phone", label: "Phone" },
          { id: "an-card-name", label: "Name on Card" },
          { id: "an-card-number", label: "Card Number" },
          { id: "an-exp", label: "Expiry" },
          { id: "an-cvc", label: "CVC" },
          { id: "an-zip", label: "Billing ZIP" },
        ];

        let isValid = true;
        const errorEl = document.getElementById("patient-info-error");
        const errors = [];

        fields.forEach((field) => {
          const el = document.getElementById(field.id);
          if (!el) return;
          const val = el.value.trim();
          if (!val) {
            isValid = false;
            el.style.borderColor = "#dc2626";
            errors.push(field.label);
          } else {
            el.style.borderColor = "";
          }
        });

        // Validate card number (basic)
        const cardNum = document.getElementById("an-card-number");
        if (cardNum) {
          const clean = cardNum.value.replace(/\s/g, "");
          if (clean.length < 15 || clean.length > 16 || !/^\d+$/.test(clean)) {
            isValid = false;
            cardNum.style.borderColor = "#dc2626";
            errors.push("Valid Card Number");
          }
        }

        // Validate expiry
        const exp = document.getElementById("an-exp");
        if (exp) {
          const expVal = exp.value.replace(/\s/g, "");
          if (!/^\d{2}\/\d{2}$/.test(expVal)) {
            isValid = false;
            exp.style.borderColor = "#dc2626";
            errors.push("Valid Expiry (MM/YY)");
          }
        }

        // Validate CVC
        const cvc = document.getElementById("an-cvc");
        if (cvc) {
          const cvcVal = cvc.value.replace(/\s/g, "");
          if (cvcVal.length < 3 || cvcVal.length > 4 || !/^\d+$/.test(cvcVal)) {
            isValid = false;
            cvc.style.borderColor = "#dc2626";
            errors.push("Valid CVC");
          }
        }

        // Validate consent
        const consent = document.getElementById("consent-check");
        if (!consent || !consent.checked) {
          isValid = false;
          if (consent) {
            consent.parentElement.style.border = "1px solid #dc2626";
            consent.parentElement.style.background = "#fef2f2";
          }
          errors.push("Telehealth Consent");
        } else {
          if (consent) {
            consent.parentElement.style.border = "";
            consent.parentElement.style.background = "";
          }
        }

        if (!isValid && errorEl) {
          errorEl.textContent = `Please fill in all required fields: ${errors.join(", ")}`;
          errorEl.style.display = "block";
          document
            .getElementById("patient-info-box")
            .scrollIntoView({ behavior: "smooth" });
        } else if (errorEl) {
          errorEl.style.display = "none";
        }

        return isValid;
      }

      /**
       * Charge the card via Authorize.Net Accept.js (real payment).
       * 1. Tokenize the raw card fields in-browser (Accept.dispatchData) —
       *    the card number/CVC never touch our server, only the resulting
       *    opaque token does.
       * 2. POST the token to create-authnet-transaction.js, which recomputes
       *    the price from pricing.json server-side and charges the card.
       */
      async function processPayment() {
        const btn = document.getElementById("checkout-btn");
        const spinner = document.getElementById("checkout-spinner");
        const errorEl = document.getElementById("payment-errors");

        if (!validateCheckoutForm()) {
          return;
        }

        function resetButton() {
          btn.disabled = false;
          btn.style.opacity = "1";
          spinner.style.display = "none";
        }

        function showError(message) {
          errorEl.textContent =
            message || "Something went wrong. Please try again.";
          errorEl.style.display = "block";
          resetButton();
        }

        if (!AUTHNET_SIMULATE && typeof Accept === "undefined") {
          showError(
            "Payment system failed to load. Please refresh and try again.",
          );
          return;
        }

        btn.disabled = true;
        btn.style.opacity = "0.7";
        spinner.style.display = "block";
        errorEl.style.display = "none";

        const expDigits = document
          .getElementById("an-exp")
          .value.replace(/\D/g, ""); // "MMYY"

        const secureData = {
          authData: {
            clientKey: AUTHNET_CLIENT_KEY,
            apiLoginID: AUTHNET_LOGIN_ID,
          },
          cardData: {
            cardNumber: document
              .getElementById("an-card-number")
              .value.replace(/\s+/g, ""),
            month: expDigits.slice(0, 2),
            year: "20" + expDigits.slice(2, 4),
            cardCode: document.getElementById("an-cvc").value.trim(),
          },
        };

        // POSTs the (possibly null, in simulate mode) Accept.js token to the
        // server, then runs the shared post-approval flow (MDI + redirect).
        const submitCharge = async function (opaqueData) {
          try {
            if (!selectedProducts || selectedProducts.length === 0 || !selectedProducts[0].id || selectedProducts[0].id === "default") {
              showError("No treatment selected. Please complete the assessment first.");
              return;
            }
            const primary = selectedProducts[0];
            const attribution =
              window.FreeleyAttribution &&
              window.FreeleyAttribution.flatten
                ? window.FreeleyAttribution.flatten()
                : {};

            const resp = await fetch(
              "/.netlify/functions/create-authnet-transaction",
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  treatment: primary.id,
                  plan_months: selectedPlanMonths,
                  promo_code: appliedPromo ? appliedPromo.code : undefined,
                  compound: selectedCompound,
                  opaqueData: opaqueData,
                  attribution: attribution,
                  email: document.getElementById("pt-email").value.trim(),
                  firstName: document
                    .getElementById("pt-first-name")
                    .value.trim(),
                  lastName: document
                    .getElementById("pt-last-name")
                    .value.trim(),
                  phone: document.getElementById("pt-phone").value.trim(),
                  zip: document.getElementById("an-zip").value.trim(),
                  // For the funnel_orders record (Supabase). lead_id is the
                  // quiz's session id = funnel_leads.id; absent on a direct
                  // visit, which the server tolerates.
                  lead_id:
                    sessionStorage.getItem("freeley_quiz_session_id") ||
                    undefined,
                  address: document.getElementById("pt-address").value.trim(),
                  city: document.getElementById("pt-city").value.trim(),
                  state: document.getElementById("pt-state").value.trim(),
                  date_of_birth:
                    document.getElementById("pt-dob").value || undefined,
                }),
              },
            );

            const result = await resp.json();

            if (!result || !result.approved) {
              showError(
                (result && result.error) ||
                  "Your card was declined. Please check your details or try another card.",
              );
              return;
            }

            // ── Card approved → create the MDI case for physician review ──
            // Best-effort: the charge already went through, so nothing below is
            // allowed to trap the patient on this page. submitQuiz.js queues its
            // own retry on a transient MDI failure; savePendingCase.js is the
            // safety net for when the browser can't reach submitQuiz at all.
            const onboardingUrl = await submitToMDI(
              {
                transaction_id: String(result.transactionId),
                amount: result.amount,
                plan_months: selectedPlanMonths,
                card_last4: result.accountLast4 || undefined,
                card_brand: result.cardBrand || undefined,
                simulated: result.simulated === true,
              },
              primary,
            );

            const orderData = {
              transactionId: result.transactionId,
              amount: result.amount,
              products: selectedProducts.map((p) => p.name),
              planMonths: selectedPlanMonths,
              // MDI's branded patient-site link — the patient creates their
              // account and completes the medical intake there. Read by the
              // order-confirmation banner on index.astro.
              onboardingUrl: onboardingUrl || undefined,
              timestamp: new Date().toISOString(),
            };

            sessionStorage.setItem(
              "freeley_transaction",
              JSON.stringify(orderData),
            );
            // Send the patient straight to MDI's branded patient site to
            // complete the medical intake. Fallback (no quiz session, MDI
            // down): the homepage confirmation banner, which the waitlist
            // gate lets through via its ?payment= allow rule.
            if (onboardingUrl && /^https:\/\//.test(onboardingUrl)) {
              window.location.href = onboardingUrl;
            } else {
              window.location.href =
                "/?payment=success&pi=" + orderData.transactionId;
            }
          } catch (err) {
            console.error("[CHECKOUT] Payment error:", err);
            showError(
              "Unable to process payment. Please try again or contact support.",
            );
          }
        };

        // Simulate mode: skip tokenization entirely — the server approves
        // without contacting Authorize.Net (AUTHNET_SIMULATE=true build).
        if (AUTHNET_SIMULATE) {
          submitCharge(null);
          return;
        }

        Accept.dispatchData(secureData, function (tokenResponse) {
          if (
            !tokenResponse ||
            !tokenResponse.messages ||
            tokenResponse.messages.resultCode !== "Ok"
          ) {
            const msg =
              tokenResponse &&
              tokenResponse.messages &&
              tokenResponse.messages.message &&
              tokenResponse.messages.message[0] &&
              tokenResponse.messages.message[0].text;
            showError(msg || "Your card details could not be validated.");
            return;
          }
          submitCharge(tokenResponse.opaqueData);
        });
      }

      /**
       * Send the clinical intake to MD Integrations after a successful charge.
       *
       * NEVER throws — the card has already been charged by the time this runs,
       * so a failure here must not block the success redirect. Ordered fallback:
       *   1. submitQuiz.js  → creates the MDI voucher/case (self-queues its own
       *      retry on a transient MDI 5xx).
       *   2. savePendingCase.js → if the browser couldn't get a success out of
       *      submitQuiz at all, park the PHI-encrypted submission for
       *      retryPendingCases.js so the payment isn't orphaned.
       *
       * Returns MDI's onboarding_url (the branded patient site where the
       * patient creates their account and finishes the medical intake), or
       * null when MDI was skipped or unreachable.
       */
      async function submitToMDI(payment, primary) {
        const transactionId = payment.transaction_id;
        const val = (id) => {
          const el = document.getElementById(id);
          return el ? el.value.trim() : "";
        };

        let quizData = null;
        let quizAnswers = null;
        try {
          quizData = JSON.parse(
            sessionStorage.getItem("freeley_quiz_data") || "null",
          );
        } catch (e) {}
        try {
          quizAnswers = JSON.parse(
            sessionStorage.getItem("quiz_answers") || "null",
          );
        } catch (e) {}

        // No real quiz session (direct hit on /checkout, demo/QA run) means there
        // is no clinical data to submit — skip MDI rather than send garbage to a
        // physician. The payment stands either way.
        if (!quizData || !quizData.email) {
          console.warn(
            "[CHECKOUT] No quiz data in session — skipping MDI case creation.",
          );
          return null;
        }

        const mdiBody = {
          patient: {
            first_name: val("pt-first-name"),
            last_name: val("pt-last-name"),
            email: val("pt-email"),
            phone_number: val("pt-phone") || undefined,
            date_of_birth: val("pt-dob") || undefined,
            gender: val("pt-gender") || undefined,
            address: val("pt-address") || undefined,
            city: val("pt-city") || undefined,
            state: val("pt-state") || undefined,
            zip_code: val("pt-zip") || undefined,
          },
          product: primary.id,
          compound: selectedCompound || undefined,
          quiz_answers: quizAnswers || undefined,
          allergies: quizData.allergies || undefined,
          current_medications: quizData.medications || undefined,
          medical_conditions: quizData.conditions || undefined,
          // Payment receipt: lets submitQuiz record a Patient Order on the MDI
          // side and key its retry queue by transaction (no duplicate encounters).
          payment: payment,
        };

        try {
          const mdiResp = await fetch("/.netlify/functions/submitQuiz", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(mdiBody),
            // Patient-first now does up to 3 MDI calls (search/create patient,
            // voucher, order) before answering — give it room.
            signal: AbortSignal.timeout(20000),
          });
          const mdiResult = await mdiResp.json();
          if (mdiResp.status === 202 && mdiResult && mdiResult.queued) {
            // submitQuiz already parked the submission for retryPendingCases —
            // do NOT also call savePendingCase (that would queue a second record
            // and create two encounters for one charge).
            console.warn("[CHECKOUT] MDI temporarily unavailable — submission queued server-side for retry.");
            return null;
          }
          if (!mdiResp.ok || !mdiResult.success) {
            throw new Error("submitQuiz did not succeed");
          }
          console.log("[CHECKOUT] MDI case created:", mdiResult.voucher_id);
          return mdiResult.onboarding_url || null;
        } catch (mdiErr) {
          console.error(
            "[CHECKOUT] MDI submission failed after successful payment — queueing for retry:",
            mdiErr,
          );
          try {
            const saveResp = await fetch("/.netlify/functions/savePendingCase", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                payment_intent_id: transactionId,
                ...mdiBody,
              }),
              signal: AbortSignal.timeout(8000),
            });
            // savePendingCase runs the SAME validateQuizSubmission as submitQuiz —
            // if that's *why* submitQuiz just failed (bad email, oversized
            // narrative field, etc.), this call fails the identical way and a
            // 4xx never throws on its own. Without this check the payment goes
            // through with zero MDI trace anywhere and zero log line about it.
            if (!saveResp.ok) {
              throw new Error("savePendingCase responded " + saveResp.status);
            }
          } catch (saveErr) {
            // Non-fatal to the customer: the charge succeeded and Authorize.Net
            // holds the transaction record regardless. Ops needs this log line.
            console.error(
              "[CHECKOUT] savePendingCase ALSO failed — this payment has no MDI record anywhere:",
              saveErr,
            );
          }
        }
        return null;
      }

      // ═══════════════════════════════════════════════════════
      // EVENT BINDING
      // ═══════════════════════════════════════════════════════

      document.addEventListener("DOMContentLoaded", function () {
        loadProductsFromSession();

        const consent = document.getElementById("consent-check");
        if (consent) {
          consent.addEventListener("change", function () {
            enableCheckout();
            if (this.checked) {
              this.parentElement.style.border = "";
              this.parentElement.style.background = "";
            }
          });
        }

        // ── Promo code ──
        const promoForm = document.getElementById("promo-form");
        const promoMsg = document.getElementById("promo-msg");
        function setPromoMsg(text, ok) {
          promoMsg.textContent = text;
          promoMsg.className = "ck-promo__msg " + (text ? (ok ? "is-ok" : "is-err") : "");
        }
        if (promoForm) {
          promoForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const input = document.getElementById("promo-code");
            const btn = document.getElementById("promo-apply");
            const code = input.value.trim().toUpperCase();
            if (!code) return;
            btn.disabled = true;
            try {
              const r = await fetch("/.netlify/functions/validatePromo", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ code }),
                signal: AbortSignal.timeout(8000),
              });
              const data = await r.json();
              if (data && data.valid) {
                appliedPromo = { code: data.code, type: data.type, value: data.value, label: data.label };
                setPromoMsg(`✓ ${data.label} applied`, true);
                input.value = "";
              } else {
                appliedPromo = null;
                setPromoMsg((data && data.error) || "That promo code is not valid.", false);
              }
            } catch (err) {
              setPromoMsg("Couldn't check that code right now. Please try again.", false);
            }
            btn.disabled = false;
            updateTotals();
          });
          document.getElementById("promo-remove").addEventListener("click", () => {
            appliedPromo = null;
            setPromoMsg("", true);
            updateTotals();
          });
        }

        const checkoutBtn = document.getElementById("checkout-btn");
        if (checkoutBtn) {
          checkoutBtn.addEventListener("click", processPayment);
        }

        document.querySelectorAll(".ck-input").forEach((el) => {
          el.addEventListener("input", function () {
            this.style.borderColor = "";
            const errorEl = document.getElementById("patient-info-error");
            if (errorEl) errorEl.style.display = "none";
          });
        });

        const cardInput = document.getElementById("an-card-number");
        if (cardInput) {
          cardInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 16) val = val.slice(0, 16);
            const parts = val.match(/.{1,4}/g);
            if (parts) {
              this.value = parts.join(" ");
            } else {
              this.value = val;
            }
            this.style.borderColor = "";
          });
        }

        const expInput = document.getElementById("an-exp");
        if (expInput) {
          expInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 4) val = val.slice(0, 4);
            if (val.length >= 2) {
              this.value = val.slice(0, 2) + "/" + val.slice(2);
            } else {
              this.value = val;
            }
            this.style.borderColor = "";
          });
        }

        const cvcInput = document.getElementById("an-cvc");
        if (cvcInput) {
          cvcInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 4) val = val.slice(0, 4);
            this.value = val;
            this.style.borderColor = "";
          });
        }

        enableCheckout();
      });

      // Expose functions globally for inline onclick
      window.selectPlan = selectPlan;
      // What the patient is actually buying, per vertical. `key` is sent as
      // `compound` and is a real catalog key that netlify/functions/lib/products.js
      // resolves directly (nad-plus, olympus, …) or via its aliases (sema/tirz).
      // hair-loss has NO picker on purpose: Cedar (finasteride) vs Ivy/Willow is
      // decided server-side from declared sex + age for safety, then confirmed
      // by the physician.
      const CATALOG = {
        "weight-loss": [
          { key: "sema", name: "Semaglutide", desc: "Weekly GLP-1 injection · with Glycine + B12", img: "/assets/brand/semag_transparent.png" },
          { key: "tirz", name: "Tirzepatide", desc: "Weekly dual GIP/GLP-1 injection · with Glycine + B12", img: "/assets/brand/tirzz_transparent.png" },
        ],
        "sexual-wellness": [
          { key: "tadalafil-daily", name: "Tadalafil (Daily)", desc: "5 mg sublingual flex dose", img: "/assets/brand/freeley_troche_transparent.png" },
          { key: "olympus", name: "Olympus", desc: "Oxytocin / Bremelanotide / Tadalafil troche", img: "/assets/brand/freeley_troche_transparent.png" },
        ],
        "longevity": [
          { key: "sermorelin-injectable", name: "Sermorelin", desc: "Growth-hormone peptide · injectable", img: "/assets/brand/sermorelin_vial.png" },
          { key: "nad-plus", name: "NAD+", desc: "Cellular energy & repair · injectable", img: "/assets/brand/nad_vial.png" },
          { key: "glutathione-troche", name: "Glutathione", desc: "Antioxidant peptide · troche", img: "/assets/brand/glutathione_vial.png" },
        ],
        "hair-loss": [],
      };
      const HAIR_NOTE = "Cedar, Ivy or Willow tablet — matched to your profile by your physician";

      function catalogFor() {
        return CATALOG[(selectedProducts[0] || {}).id] || [];
      }
      function currentCatalogEntry() {
        return catalogFor().find((c) => c.key === selectedCompound) || null;
      }

      window.setCheckoutCompound = function (type) {
        selectedCompound = type;
        renderProducts(); renderPlanSelector(); updateTotals(); // tier may change
      };

      function syncCompoundSelector() {
        const box = document.getElementById("compoundSelector");
        if (!box) return;
        const options = catalogFor();
        box.hidden = options.length === 0;
        if (!options.length) return;
        if (!options.some((o) => o.key === selectedCompound)) selectedCompound = options[0].key;
        const tier1 = (key) => { const keep = selectedCompound; selectedCompound = key; const p = currentTier()["1"]; selectedCompound = keep; return p; };
        box.innerHTML = options.map((o) => `
          <button type="button" class="ck-choice ${o.key === selectedCompound ? "is-active" : ""}" role="radio" aria-checked="${o.key === selectedCompound}" data-compound="${o.key}" onclick="setCheckoutCompound('${o.key}')">
            <b>${o.name}</b><span>${o.desc}</span><span class="ck-choice__price">from $${tier1(o.key)}/mo</span>
          </button>`).join("");
      }
      window.loadProductFromQuiz = loadProductsFromSession;
    </script>

    {AUTHNET_ENV === 'sandbox' && (
      <script is:inline>
        // SANDBOX-ONLY demo prefill (for walkthrough recordings): fills every
        // checkout field with test data + the official Authorize.Net sandbox
        // test card, so a demo run is just consent-check → Checkout. Rendered
        // ONLY when AUTHNET_ENV=sandbox — the build for a real-payments
        // environment (AUTHNET_ENV=production) omits this block entirely, so
        // reverting the env vars removes it with no code change.
        (function () {
          var fill = {
            'pt-first-name': 'Samuel',
            'pt-last-name': 'Aranguren',
            'pt-dob': '1995-05-14',
            'pt-gender': '1',
            'pt-address': '123 Main St',
            'pt-city': 'Miami',
            'pt-state': 'FL',
            'pt-zip': '33101',
            'pt-email': 'samuel@ahimismito.com',
            'pt-phone': '(305) 555-0142',
            'an-card-name': 'Samuel Aranguren',
            'an-card-number': '4111 1111 1111 1111',
            'an-exp': '12/28',
            'an-cvc': '123',
            'an-zip': '33101'
          };
          for (var id in fill) {
            var el = document.getElementById(id);
            if (el && !el.value) el.value = fill[id];
          }
        })();
      </script>
    )}
</Layout>
