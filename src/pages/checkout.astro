            <div class="ck-calc__row ck-calc__row--promo" id="totals-discount-row" hidden><span>Discount <b id="promo-applied-code"></b> <button type="button" class="ck-promo__remove" id="promo-remove" aria-label="Remove promo code">×</button></span><span id="totals-discount">−$0.00</span></div>
            <div class="ck-calc__row ck-calc__row--total"><span>Total due today</span><span id="totals-total">$0.00</span></div>
