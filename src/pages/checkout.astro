---
import '../styles/tailwind.css';

// Authorize.Net Accept.js needs the API Login ID + Public Client Key
// client-side to tokenize the card (see netlify/functions/create-authnet-transaction.js
// for the matching server-side Transaction Key). Read here in frontmatter
// (build-time/SSR, not bundled to the client) and passed into the page's
// inline script via define:vars below — never hardcoded.
const AUTHNET_LOGIN_ID = process.env.AUTHNET_API_LOGIN_ID || '';
const AUTHNET_CLIENT_KEY = process.env.AUTHNET_CLIENT_KEY || '';
const AUTHNET_ENV = (process.env.AUTHNET_ENV || 'production').toLowerCase();
const ACCEPT_JS_SRC = AUTHNET_ENV === 'sandbox'
  ? 'https://jstest.authorize.net/v1/Accept.js'
  : 'https://js.authorize.net/v1/Accept.js';
