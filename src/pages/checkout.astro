                  color: var(--forest);
                  display: block;
                  margin-bottom: 6px;
                "></i> No Hidden<br />Fees
                    </div>
                </div>

                <div class="_fsaTag">
                    Eligible for FSA / HSA
                    <i class="ri-secure-payment-line" style="font-size: 18px; color: var(--forest)"></i>
                </div>

            </div>
        </div>
    </div>

    <script is:inline define:vars={{ AUTHNET_LOGIN_ID, AUTHNET_CLIENT_KEY }}>
        // ═══════════════════════════════════════════════════════
        // PRODUCT DATA – loaded from sessionStorage
        // ═══════════════════════════════════════════════════════

        let selectedProducts = [];
        let selectedPlanMonths = 3; // Default: 3 Months
        let productTotalPrice = 0;
        let selectedCompound = null; // set by setCheckoutCompound(), sent to the charge

        /**
         * Load products from sessionStorage (set by quiz)
         */
        function loadProductsFromSession() {
            try {
                // Try to load from checkout_product_data first
                const productData = JSON.parse(
                    sessionStorage.getItem("checkout_product_data"),
                );
                if (productData) {
                    if (
                        productData.isBundle &&
                        productData.allProducts &&
                        productData.allProducts.length > 0
                    ) {
                        selectedProducts = productData.allProducts.map((p) => ({
                            id: p.id || "product-" + Date.now(),
                            name: p.title || "Treatment",
                            description: p.description || "",
                            image: p.image || "/assets/checkout/hair-lose.png",
                            // Use the individual product's price, don't override it
                            price: parseFloat((p.price || "$0").replace(/[$,]/g, "")) || 0,
                            benefits: p.benefits || [],
                        }));
                        // REMOVE the block that averages prices - this was causing all products to show the same price
                        renderProducts();
                        renderPlanSelector();
                        updateTotals();
                        return;
                    }

                    // Single product
                    if (productData.name) {
                        selectedProducts = [{
                            id: productData.treatmentType || "default",
                            name: productData.name || "Treatment Plan",
                            description: productData.desc || "",
                            image: productData.image ||
                                "/assets/checkout/hair-lose.png",
                            price: parseFloat(productData.monthlyPrice) || 49.99,
                            benefits: [],
                        }, ];
                        renderProducts();
                        renderPlanSelector();
                        updateTotals();
                        return;
                    }
                }

                // Rest of the function remains the same...
            } catch (e) {
                console.log("No product data found, using defaults");
                selectedProducts = [{
                    id: "default",
                    name: "Treatment Plan",
                    description: "Personalized treatment",
                    image: "/assets/checkout/hair-lose.png",
                    price: 49.99,
                    benefits: [],
                }, ];
                renderProducts();
                renderPlanSelector();
                updateTotals();
            }
        }

        // ═══════════════════════════════════════════════════════
        // PRICING DATA (fallback)
        // ═══════════════════════════════════════════════════════

        const pricingData = {
            "weight-loss": {
                name: "Weight Loss Program",
                desc: "GLP-1 compounded medication",
                planName: "Weight Loss Plan",
                image: "/assets/checkout/hair-lose.png",
                plans: [{
                    months: 1,
                    base: 49.99,
                    overridePrice: 49.99,
                    recommended: false,
                }, {
                    months: 3,
                    base: 49.99,
                    overridePrice: 39.99,
                    recommended: false,
                }, {
                    months: 6,
                    base: 49.99,
                    overridePrice: 29.99,
                    recommended: true
                }, ],
            },
            "sexual-wellness": {
                name: "Sexual Wellness",
                desc: "Sublingual tablet",
                planName: "Sexual Wellness Protocol",
                image: "/assets/checkout/freeley_troche_transparent.png",
                plans: [{
                    months: 1,
                    base: 89,
                    overridePrice: 89,
                    recommended: false
                }, {
                    months: 3,
                    base: 89,
                    overridePrice: 79,
                    recommended: false
                }, {
                    months: 6,
                    base: 89,
                    overridePrice: 69,
                    recommended: true
                }, ],
            },
            "hair-loss": {
                name: "Hair Restoration",
                desc: "Hair growth compound",
                planName: "Hair Restoration Plan",
                image: "/assets/checkout/freeley_troche_transparent.png",
                plans: [{
                    months: 1,
                    base: 49,
                    overridePrice: 49,
                    recommended: false
                }, {
                    months: 3,
                    base: 49,
                    overridePrice: 39,
                    recommended: false
                }, {
                    months: 6,
                    base: 49,
                    overridePrice: 34,
                    recommended: true
                }, ],
            },
            longevity: {
                name: "Longevity & Performance",
                desc: "Recovery peptides",
                planName: "Longevity Plan",
                image: "/assets/checkout/sermorelin_vial.png",
                plans: [{
                    months: 1,
                    base: 149,
                    overridePrice: 149,
                    recommended: false
                }, {
                    months: 3,
                    base: 149,
                    overridePrice: 129,
                    recommended: false
                }, {
                    months: 6,
                    base: 149,
                    overridePrice: 109,
                    recommended: true
                }, ],
            },
        };

        // ═══════════════════════════════════════════════════════
        // RENDER FUNCTIONS
        // ═══════════════════════════════════════════════════════

        /**
         * Render all selected products in the order summary
         */
        function renderProducts() {
            const container = document.getElementById("products-container");
            if (!container) return;

            if (!selectedProducts || selectedProducts.length === 0) {
                container.innerHTML = `
      <div class="_entry">
        <div class="_entryLeft">
          <div class="_iconWrap"><i class="ri-medicine-bottle-line"></i></div>
          <div>
            <div class="_entryName">No products selected</div>
            <div class="_entryDesc">Please complete the quiz</div>
          </div>
        </div>
      </div>
    `;
                return;
            }

            let html = "";
            selectedProducts.forEach((product, index) => {
                // Use the product's individual price, not a shared value
                const priceDisplay = product.price ?
                    `$${product.price.toFixed(2)}` :
                    "$0.00";
                const imageSrc =
                    product.image || "/assets/checkout/hair-lose.png";
                const name = product.name || "Treatment";
                const desc = product.description || "Compounded medication";

                html += `
      <div class="_entry-product">
        <div class="_entryLeft">
          <img src="${imageSrc}" alt="${name}" class="_thumbnail-sm" />
          <div>
            <div class="_entryName">${name}</div>
            <div class="_entryDesc">${desc}</div>
          </div>
        </div>
        <div class="_entryPrice">${priceDisplay}<span style="font-size:11px; color:#999; font-weight:400; margin-left:2px;">/mo</span></div>
      </div>
    `;
            });

            container.innerHTML = html;
        }

        /**
         * Render plan selector with collapsible cards (accordion behavior)
         */
        function renderPlanSelector() {
            const container = document.getElementById("plan-selector");
            if (!container) return;

            // Define plan options with benefits
            const planOptions = [{
                months: 1,
                label: "Pay Monthly",
                badge: "",
                savingPercent: 0
            }, {
                months: 3,
                label: "Pay For 3 Months",
                badge: "SAVE 10%",
                savingPercent: 10,
            }, {
                months: 6,
                label: "Pay For 6 Months",
                badge: "BEST VALUE",
                savingPercent: 31,
            }, ];

            const baseMonthlyPrice = selectedProducts.reduce(
                (sum, p) => sum + (p.price || 0),
                0,
            );

            // Benefits to show for all plans
            const benefits = [
                "🎓 <strong>Exclusive Access</strong> to the Patient Hub Program",
                "💰 <strong>Maximum savings</strong> - lowest price per month",
                "🛡️ <strong>Risk-Free Consultation</strong>",
                "🚚 <strong>Free Overnight Shipping</strong> to all states",
                "⏸️ <strong>Cancel or pause anytime</strong>",
            ];

            let html = "";
            planOptions.forEach((option) => {
                        const isActive = selectedPlanMonths === option.months;
                        const discount = option.savingPercent / 100;
                        const discountedPrice = baseMonthlyPrice * (1 - discount);
                        const totalPrice = discountedPrice * option.months;
                        const perDay = (discountedPrice / 30).toFixed(2);
                        const savingTag =
                            option.savingPercent > 0 ? `(Save ${option.savingPercent}%)` : "";

                        const badgeHtml = option.badge ?
                            `<div class="badge-red">${option.badge}</div>` :
                            "";

                        html += `
          <div class="plan-card ${isActive ? "active" : ""}" onclick="selectPlan(${option.months})" data-months="${option.months}">
            ${badgeHtml ? `<div class="plan-badges">${badgeHtml}</div>` : ""}
            <div class="plan-card-header">
              <div class="plan-left">
                <div class="radio-circle"></div>
                <div>
                  <div class="plan-name">${option.label} <span class="saving-tag">${savingTag}</span></div>
                  <div class="plan-desc">$${totalPrice.toFixed(2)} Total for ${option.months} ${option.months === 1 ? "Month" : "Months"}</div>
                </div>
              </div>
              <div class="plan-right">
                <div class="plan-price-large">${baseMonthlyPrice > discountedPrice ? "<s>$" + Math.floor(baseMonthlyPrice) + "</s>" : ""}$${Math.floor(discountedPrice)}<small>/mo</small></div>
                <div class="plan-price-small">$${perDay} USD / DAY</div>
              </div>
            </div>
            <div class="plan-benefits">
              ${benefits.map((b) => `<div class="benefit-line">${b}</div>`).join("")}
            </div>
          </div>
        `;
        });

        container.innerHTML = html;
      }

      /**
       * Select a plan by months - updates selection and totals
       */
      function selectPlan(months) {
        selectedPlanMonths = months;
        renderPlanSelector(); // Re-render to update active state
        updateTotals(); // Update prices
        enableCheckout(); // Enable button if consent is checked
      }

      /**
       * Update subtotal and total
       */
      function updateTotals() {
        const baseMonthlyPrice = selectedProducts.reduce(
          (sum, p) => sum + (p.price || 0),
          0,
        );
        const discount =
          selectedPlanMonths === 3 ? 0.1 : selectedPlanMonths === 6 ? 0.2 : 0;
        const discountedPrice = baseMonthlyPrice * (1 - discount);
        const total = discountedPrice * selectedPlanMonths;
        const consultFee = 20.0;
        const grandTotal = total + consultFee;

        // Update display
        const subtotalEl = document.getElementById("totals-subtotal");
        const totalEl = document.getElementById("totals-total");
        const btnText = document.getElementById("btn-text");

        if (subtotalEl) subtotalEl.textContent = `$${total.toFixed(2)}`;
        if (totalEl) totalEl.textContent = `$${grandTotal.toFixed(2)}`;
        if (btnText)
          btnText.textContent = `Checkout — $${grandTotal.toFixed(2)}`;

        productTotalPrice = grandTotal;
      }

      /**
       * Enable checkout button when consent is checked
       */
      function enableCheckout() {
        const btn = document.getElementById("checkout-btn");
        const consent = document.getElementById("consent-check");
        if (btn && consent) {
          btn.disabled = !consent.checked;
        }
      }

      // ═══════════════════════════════════════════════════════
      // PAYMENT VALIDATION & SUBMISSION
      // ═══════════════════════════════════════════════════════

      /**
       * Validate all checkout form fields
       */
      function validateCheckoutForm() {
        const fields = [
          { id: "pt-first-name", label: "First Name" },
          { id: "pt-last-name", label: "Last Name" },
          { id: "pt-dob", label: "Date of Birth" },
          { id: "pt-gender", label: "Gender" },
          { id: "pt-address", label: "Street Address" },
          { id: "pt-city", label: "City" },
          { id: "pt-state", label: "State" },
          { id: "pt-zip", label: "ZIP Code" },
          { id: "pt-email", label: "Email" },
          { id: "pt-phone", label: "Phone" },
          { id: "an-card-name", label: "Name on Card" },
          { id: "an-card-number", label: "Card Number" },
          { id: "an-exp", label: "Expiry" },
          { id: "an-cvc", label: "CVC" },
          { id: "an-zip", label: "Billing ZIP" },
        ];

        let isValid = true;
        const errorEl = document.getElementById("patient-info-error");
        const errors = [];

        fields.forEach((field) => {
          const el = document.getElementById(field.id);
          if (!el) return;
          const val = el.value.trim();
          if (!val) {
            isValid = false;
            el.style.borderColor = "#dc2626";
            errors.push(field.label);
          } else {
            el.style.borderColor = "";
          }
        });

        // Validate card number (basic)
        const cardNum = document.getElementById("an-card-number");
        if (cardNum) {
          const clean = cardNum.value.replace(/\s/g, "");
          if (clean.length < 15 || clean.length > 16 || !/^\d+$/.test(clean)) {
            isValid = false;
            cardNum.style.borderColor = "#dc2626";
            errors.push("Valid Card Number");
          }
        }

        // Validate expiry
        const exp = document.getElementById("an-exp");
        if (exp) {
          const expVal = exp.value.replace(/\s/g, "");
          if (!/^\d{2}\/\d{2}$/.test(expVal)) {
            isValid = false;
            exp.style.borderColor = "#dc2626";
            errors.push("Valid Expiry (MM/YY)");
          }
        }

        // Validate CVC
        const cvc = document.getElementById("an-cvc");
        if (cvc) {
          const cvcVal = cvc.value.replace(/\s/g, "");
          if (cvcVal.length < 3 || cvcVal.length > 4 || !/^\d+$/.test(cvcVal)) {
            isValid = false;
            cvc.style.borderColor = "#dc2626";
            errors.push("Valid CVC");
          }
        }

        // Validate consent
        const consent = document.getElementById("consent-check");
        if (!consent || !consent.checked) {
          isValid = false;
          if (consent) {
            consent.parentElement.style.border = "1px solid #dc2626";
            consent.parentElement.style.background = "#fef2f2";
          }
          errors.push("Telehealth Consent");
        } else {
          if (consent) {
            consent.parentElement.style.border = "";
            consent.parentElement.style.background = "";
          }
        }

        if (!isValid && errorEl) {
          errorEl.textContent = `Please fill in all required fields: ${errors.join(", ")}`;
          errorEl.style.display = "block";
          document
            .getElementById("patient-info-box")
            .scrollIntoView({ behavior: "smooth" });
        } else if (errorEl) {
          errorEl.style.display = "none";
        }

        return isValid;
      }

      /**
       * Charge the card via Authorize.Net Accept.js (real payment).
       * 1. Tokenize the raw card fields in-browser (Accept.dispatchData) —
       *    the card number/CVC never touch our server, only the resulting
       *    opaque token does.
       * 2. POST the token to create-authnet-transaction.js, which recomputes
       *    the price from pricing.json server-side and charges the card.
       */
      async function processPayment() {
        const btn = document.getElementById("checkout-btn");
        const spinner = document.getElementById("checkout-spinner");
        const errorEl = document.getElementById("payment-errors");

        if (!validateCheckoutForm()) {
          return;
        }

        function resetButton() {
          btn.disabled = false;
          btn.style.opacity = "1";
          spinner.style.display = "none";
        }

        function showError(message) {
          errorEl.textContent =
            message || "Something went wrong. Please try again.";
          errorEl.style.display = "block";
          resetButton();
        }

        if (typeof Accept === "undefined") {
          showError(
            "Payment system failed to load. Please refresh and try again.",
          );
          return;
        }

        btn.disabled = true;
        btn.style.opacity = "0.7";
        spinner.style.display = "block";
        errorEl.style.display = "none";

        const expDigits = document
          .getElementById("an-exp")
          .value.replace(/\D/g, ""); // "MMYY"

        const secureData = {
          authData: {
            clientKey: AUTHNET_CLIENT_KEY,
            apiLoginID: AUTHNET_LOGIN_ID,
          },
          cardData: {
            cardNumber: document
              .getElementById("an-card-number")
              .value.replace(/\s+/g, ""),
            month: expDigits.slice(0, 2),
            year: "20" + expDigits.slice(2, 4),
            cardCode: document.getElementById("an-cvc").value.trim(),
          },
        };

        Accept.dispatchData(secureData, async function (tokenResponse) {
          if (
            !tokenResponse ||
            !tokenResponse.messages ||
            tokenResponse.messages.resultCode !== "Ok"
          ) {
            const msg =
              tokenResponse &&
              tokenResponse.messages &&
              tokenResponse.messages.message &&
              tokenResponse.messages.message[0] &&
              tokenResponse.messages.message[0].text;
            showError(msg || "Your card details could not be validated.");
            return;
          }

          try {
            const primary = selectedProducts[0] || {};
            const attribution =
              window.FreeleyAttribution &&
              window.FreeleyAttribution.flatten
                ? window.FreeleyAttribution.flatten()
                : {};

            const resp = await fetch(
              "/.netlify/functions/create-authnet-transaction",
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  treatment: primary.id || "hair-loss",
                  plan_months: selectedPlanMonths,
                  compound: selectedCompound,
                  opaqueData: tokenResponse.opaqueData,
                  attribution: attribution,
                  email: document.getElementById("pt-email").value.trim(),
                  firstName: document
                    .getElementById("pt-first-name")
                    .value.trim(),
                  lastName: document
                    .getElementById("pt-last-name")
                    .value.trim(),
                  phone: document.getElementById("pt-phone").value.trim(),
                  zip: document.getElementById("an-zip").value.trim(),
                }),
              },
            );

            const result = await resp.json();

            if (!result || !result.approved) {
              showError(
                (result && result.error) ||
                  "Your card was declined. Please check your details or try another card.",
              );
              return;
            }

            // ── Card approved → create the MDI case for physician review ──
            // Best-effort: the charge already went through, so nothing below is
            // allowed to trap the patient on this page. submitQuiz.js queues its
            // own retry on a transient MDI failure; savePendingCase.js is the
            // safety net for when the browser can't reach submitQuiz at all.
            await submitToMDI(result.transactionId, primary);

            const orderData = {
              transactionId: result.transactionId,
              amount: result.amount,
              products: selectedProducts.map((p) => p.name),
              planMonths: selectedPlanMonths,
              timestamp: new Date().toISOString(),
            };

            sessionStorage.setItem(
              "freeley_transaction",
              JSON.stringify(orderData),
            );
            window.location.href =
              "/?payment=success&pi=" + orderData.transactionId;
          } catch (err) {
            console.error("[CHECKOUT] Payment error:", err);
            showError(
              "Unable to process payment. Please try again or contact support.",
            );
          }
        });
      }

      /**
       * Send the clinical intake to MD Integrations after a successful charge.
       *
       * NEVER throws — the card has already been charged by the time this runs,
       * so a failure here must not block the success redirect. Ordered fallback:
       *   1. submitQuiz.js  → creates the MDI voucher/case (self-queues its own
       *      retry on a transient MDI 5xx).
       *   2. savePendingCase.js → if the browser couldn't get a success out of
       *      submitQuiz at all, park the PHI-encrypted submission for
       *      retryPendingCases.js so the payment isn't orphaned.
       */
      async function submitToMDI(transactionId, primary) {
        const val = (id) => {
          const el = document.getElementById(id);
          return el ? el.value.trim() : "";
        };

        let quizData = null;
        let quizAnswers = null;
        try {
          quizData = JSON.parse(
            sessionStorage.getItem("freeley_quiz_data") || "null",
          );
        } catch (e) {}
        try {
          quizAnswers = JSON.parse(
            sessionStorage.getItem("quiz_answers") || "null",
          );
        } catch (e) {}

        // No real quiz session (direct hit on /checkout, demo/QA run) means there
        // is no clinical data to submit — skip MDI rather than send garbage to a
        // physician. The payment stands either way.
        if (!quizData || !quizData.email) {
          console.warn(
            "[CHECKOUT] No quiz data in session — skipping MDI case creation.",
          );
          return;
        }

        const mdiBody = {
          patient: {
            first_name: val("pt-first-name"),
            last_name: val("pt-last-name"),
            email: val("pt-email"),
            phone_number: val("pt-phone") || undefined,
            date_of_birth: val("pt-dob") || undefined,
            gender: val("pt-gender") || undefined,
            address: val("pt-address") || undefined,
            city: val("pt-city") || undefined,
            state: val("pt-state") || undefined,
            zip_code: val("pt-zip") || undefined,
          },
          product: primary.id || "hair-loss",
          compound: selectedCompound || undefined,
          quiz_answers: quizAnswers || undefined,
          allergies: quizData.allergies || undefined,
          current_medications: quizData.medications || undefined,
          medical_conditions: quizData.conditions || undefined,
        };

        try {
          const mdiResp = await fetch("/.netlify/functions/submitQuiz", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(mdiBody),
            signal: AbortSignal.timeout(8000),
          });
          const mdiResult = await mdiResp.json();
          if (!mdiResp.ok || !mdiResult.success) {
            throw new Error("submitQuiz did not succeed");
          }
          console.log("[CHECKOUT] MDI case created:", mdiResult.voucher_id);
        } catch (mdiErr) {
          console.error(
            "[CHECKOUT] MDI submission failed after successful payment — queueing for retry:",
            mdiErr,
          );
          try {
            const saveResp = await fetch("/.netlify/functions/savePendingCase", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                payment_intent_id: transactionId,
                ...mdiBody,
              }),
              signal: AbortSignal.timeout(8000),
            });
            // savePendingCase runs the SAME validateQuizSubmission as submitQuiz —
            // if that's *why* submitQuiz just failed (bad email, oversized
            // narrative field, etc.), this call fails the identical way and a
            // 4xx never throws on its own. Without this check the payment goes
            // through with zero MDI trace anywhere and zero log line about it.
            if (!saveResp.ok) {
              throw new Error("savePendingCase responded " + saveResp.status);
            }
          } catch (saveErr) {
            // Non-fatal to the customer: the charge succeeded and Authorize.Net
            // holds the transaction record regardless. Ops needs this log line.
            console.error(
              "[CHECKOUT] savePendingCase ALSO failed — this payment has no MDI record anywhere:",
              saveErr,
            );
          }
        }
      }

      // ═══════════════════════════════════════════════════════
      // EVENT BINDING
      // ═══════════════════════════════════════════════════════

      document.addEventListener("DOMContentLoaded", function () {
        loadProductsFromSession();

        const consent = document.getElementById("consent-check");
        if (consent) {
          consent.addEventListener("change", function () {
            enableCheckout();
            if (this.checked) {
              this.parentElement.style.border = "";
              this.parentElement.style.background = "";
            }
          });
        }

        const checkoutBtn = document.getElementById("checkout-btn");
        if (checkoutBtn) {
          checkoutBtn.addEventListener("click", processPayment);
        }

        document.querySelectorAll("._field").forEach((el) => {
          el.addEventListener("input", function () {
            this.style.borderColor = "";
            const errorEl = document.getElementById("patient-info-error");
            if (errorEl) errorEl.style.display = "none";
          });
        });

        const cardInput = document.getElementById("an-card-number");
        if (cardInput) {
          cardInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 16) val = val.slice(0, 16);
            const parts = val.match(/.{1,4}/g);
            if (parts) {
              this.value = parts.join(" ");
            } else {
              this.value = val;
            }
            this.style.borderColor = "";
          });
        }

        const expInput = document.getElementById("an-exp");
        if (expInput) {
          expInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 4) val = val.slice(0, 4);
            if (val.length >= 2) {
              this.value = val.slice(0, 2) + "/" + val.slice(2);
            } else {
              this.value = val;
            }
            this.style.borderColor = "";
          });
        }

        const cvcInput = document.getElementById("an-cvc");
        if (cvcInput) {
          cvcInput.addEventListener("input", function () {
            let val = this.value.replace(/\D/g, "");
            if (val.length > 4) val = val.slice(0, 4);
            this.value = val;
            this.style.borderColor = "";
          });
        }

        enableCheckout();
      });

      // Expose functions globally for inline onclick
      window.selectPlan = selectPlan;
      window.setCheckoutCompound = function (type) {
        selectedCompound = type;
      };
      window.loadProductFromQuiz = loadProductsFromSession;
    </script>
</body>

</html>