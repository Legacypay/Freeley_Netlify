---
// ABOUT — rebuilt in the /prototype design language, following
// how-it-works.astro as the structural/CSS-token template (wl- prefix).
//
// Fixed while rebuilding:
//  - Fonts/colors were Playfair Display + hardcoded hex (#004C27/#008262/
//    #C5984E), not /prototype's tokens (Source Serif 4 / Archivo,
//    --brand/--gold/--green). aboutstyle.css is no longer linked.
//  - Hero H1 had a typo: "Healthcare thatfits" (missing space) -> "Healthcare
//    that fits".
//  - Two closing CTAs stacked back to back (a "cta--sec"/"cta--sec-home-mobile"
//    banner with its own copy, immediately followed by the real "Feel better,
//    starting today" footer band). The first banner is removed; the second is
//    kept and re-skinned as the one capsule-drift wl-close band every other
//    rebuilt page ends with (same ctaPills array, same copy already used
//    site-wide).
//  - id="start-assessment" removed from the footer CTA (reserved by
//    public/style/script.js for the mobile sticky-bar pin) — it now just
//    carries the .js-start-quiz trigger class.
//  - "Built to be different" swiper reuses card1.png as both slide 1 and 4:
//    confirmed via a glob of public/assets/about/ that no 4th unique image
//    exists, so the duplicate is kept as-is rather than inventing new art.
//  - No FAQ section exists on this page, so the FAQ copy-paste bug pattern
//    doesn't apply here.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const differentiators = [
  'Same price regardless of dosage',
  'All medications compounded in licensed pharmacies',
  'No algorithms — only human physicians prescribe',
  'Quarterly lab monitoring included',
];

const stats = [
  { n: '2,400+', l: 'Patients served' },
  { n: '4.9', l: 'Average rating' },
  { n: '4', l: 'Treatment categories' },
  { n: '50', l: 'States licensed' },
];

const values = [
  {
    icon: '/assets/icons/radical.png',
    title: 'Radical Transparency',
    desc: 'No hidden fees, no bait-and-switch pricing, no surprise charges. Every cost is disclosed upfront before you commit.',
  },
  {
    icon: '/assets/icons/clanical.png',
    title: 'Clinical Integrity',
    desc: "If a treatment isn't right for you, your physician will say so. We never push products over patient safety.",
  },
  {
    icon: '/assets/icons/accessible.png',
    title: 'Accessible Premium Care',
    desc: 'World-class compounded medications at accessible, transparent pricing, with the same clinical oversight and quality.',
  },
];

// "Built to be different" cards — card1.png is intentionally reused for slide
// 4 (see note above), same as the pre-rebuild markup.
const differentCards = [
  '/assets/about/card1.png',
  '/assets/about/card2.png',
  '/assets/about/card3.png',
  '/assets/about/card1.png',
];

// Decorative capsule drift behind the closing CTA — same 11-pill array used
// on every rebuilt page (how-it-works.astro, longevity.astro, ...).
const ctaPills = [
  { w: 218, h: 76, x: -46, edge: 'top', y: -26, rot: -28, c1: 'var(--cream)', c2: 'var(--brand)', dur: 11, dly: 0 },
  { w: 172, h: 60, x: 128, edge: 'bottom', y: -30, rot: -24, c1: 'var(--gold)', c2: 'var(--green-deep)', dur: 13, dly: -2 },
  { w: 98, h: 35, x: 46, edge: 'bottom', y: 34, rot: -26, c1: 'var(--cream)', c2: 'var(--gold)', dur: 12, dly: -5 },
  { w: 124, h: 44, x: 236, edge: 'top', y: 30, rot: -31, c1: '#fff', c2: '#2c6b4c', dur: 14, dly: -3 },
  { w: 56, h: 20, x: 96, edge: 'top', y: 8, rot: -28, c1: 'var(--brand)', c2: 'var(--cream)', dur: 10, dly: -6 },
  { w: 86, h: 31, x: 180, edge: 'bottom', y: 60, rot: -27, c1: 'var(--gold)', c2: 'var(--cream)', dur: 15, dly: -8 },
  { w: 74, h: 27, x: 344, edge: 'bottom', y: 16, rot: -28, dur: 12, dly: -7 },
  { w: 64, h: 23, x: 300, edge: 'top', y: 4, rot: -25, c1: 'var(--cream)', c2: '#2c6b4c', dur: 13, dly: -4 },
  { w: 148, h: 52, x: 392, edge: 'top', y: -18, rot: -29, c1: '#2c6b4c', c2: 'var(--cream)', dur: 16, dly: -9 },
  { w: 112, h: 40, x: 470, edge: 'bottom', y: -14, rot: -26, dur: 14, dly: -11 },
  { w: 130, h: 46, x: 556, edge: 'top', y: 20, rot: -28, dur: 17, dly: -13 },
];
---

<Layout title="About | Freeley">
  <Fragment slot="head">
    <style is:inline>
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-btn-ghost { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; cursor: pointer; transition: background .15s; }
      .wl-btn-ghost:hover { background: #faf8f2; color: var(--ink); }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }
      .wl-head { max-width: 660px; margin-bottom: 40px; }
      .wl-head h2 { font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.1; margin: 14px 0 12px; }
      .wl-head p { color: var(--muted); font-size: 15px; margin: 0; }

      /* ── Hero ─────────────────────────────────────────────────── */
      .ab-hero { background: linear-gradient(180deg, #eef1ec 0%, var(--cream) 100%); padding: 64px 0 56px; text-align: center; }
      .ab-hero__inner { max-width: 700px; margin: 0 auto; }
      .ab-hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.08; margin: 16px 0 18px; }
      .ab-hero p { color: var(--muted); font-size: 16px; max-width: 56ch; margin: 0 auto; }

      /* ── Philosophy: narrative + quote/matrix cards + stats ──────── */
      .ab-phil { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
      @media (min-width: 960px) { .ab-phil { grid-template-columns: 7fr 5fr; gap: 56px; } }
      .ab-phil__narrative h2 { margin: 14px 0 20px; font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.15; }
      .ab-phil__narrative p { font-family: var(--font-sans); font-size: 14.5px; line-height: 1.65; color: var(--muted); margin: 0 0 18px; }
      .ab-quote { background: var(--card); border-radius: 14px; padding: 26px 28px; margin-bottom: 20px; }
      .ab-quote p { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; line-height: 1.4; color: var(--ink); margin: 0 0 12px; }
      .ab-quote span { font-family: var(--font-sans); font-size: 12px; font-weight: 600; color: var(--muted); }
      .ab-matrix { background: linear-gradient(180deg, #eef1ec 0%, var(--cream) 100%); border-radius: 16px; padding: 26px 28px; }
      .ab-matrix h4 { font-family: var(--font-serif); font-weight: 600; font-size: 1.1rem; color: var(--ink); margin: 0 0 16px; }
      .ab-matrix ul { list-style: none; padding: 0; margin: 0; }
      .ab-matrix li { position: relative; padding-left: 32px; margin-bottom: 12px; font-family: var(--font-sans); font-size: 13.5px; font-weight: 500; color: var(--ink); }
      .ab-matrix li:last-child { margin-bottom: 0; }
      .ab-matrix li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
      .ab-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
      .ab-stat h3 { font-family: var(--font-sans); font-size: 30px; font-weight: 700; color: var(--green); margin: 0; }
      .ab-stat p { font-size: 13px; color: var(--muted); margin: 6px 0 0; }
      @media (max-width: 700px) { .ab-stats { grid-template-columns: repeat(2, 1fr); text-align: center; } }

      /* ── Process: "What we stand for" ───────────────────────────── */
      .ab-process__top { display: flex; flex-wrap: wrap-reverse; align-items: center; justify-content: space-between; gap: 32px; margin-bottom: 48px; }
      .ab-process__top h2 { margin: 14px 0 0; font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.15; }
      .ab-process__img { flex: 1 1 300px; max-width: 380px; }
      .ab-process__img img { width: 100%; border-radius: 20px; display: block; }
      .ab-process__items { display: grid; grid-template-columns: 1fr; gap: 32px; }
      @media (min-width: 820px) { .ab-process__items { grid-template-columns: repeat(3, 1fr); } }
      .ab-process__item img { width: 44px; height: 44px; margin-bottom: 12px; }
      .ab-process__item h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.15rem; color: var(--ink); margin: 0 0 8px; }
      .ab-process__item p { font-family: var(--font-sans); font-size: 13.5px; line-height: 1.6; color: var(--muted); margin: 0; }

      /* ── "Built to be different" cards carousel ─────────────────── */
      .ab-cards-swiper { padding-bottom: 10px; }
      .ab-cards-swiper .swiper-slide { width: 300px; }
      @media (min-width: 700px) { .ab-cards-swiper .swiper-slide { width: 340px; } }
      .ab-card { border-radius: 20px; overflow: hidden; transition: transform .3s ease; }
      .ab-card:hover { transform: translateY(-6px); }
      .ab-card img { width: 100%; display: block; }

      /* ── Closing band (same capsule treatment every rebuilt page uses) ── */
      .wl-close { position: relative; background: var(--green); color: #fff; overflow: hidden; }
      .wl-close__pills { --s: 1px; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
      .fpill {
        position: absolute; border-radius: 999px;
        width: calc(var(--w) * var(--s)); height: calc(var(--h) * var(--s));
        right: calc(var(--x) * var(--s));
        background-image: linear-gradient(90deg, var(--c1) 0 50%, var(--c2) 50% 100%);
        box-shadow: 0 16px 32px rgba(0, 0, 0, .3);
        transform: rotate(var(--rot));
      }
      .fpill--top { top: calc(var(--y) * var(--s)); }
      .fpill--bottom { bottom: calc(var(--y) * var(--s)); }
      .fpill::after { content: ''; position: absolute; inset: 17% 13% auto; height: 21%; border-radius: 999px; background: rgba(255, 255, 255, .26); }
      .fpill--ghost { background-image: none; border: 1.5px solid rgba(255, 255, 255, .3); box-shadow: none; }
      .fpill--ghost::after { display: none; }
      @media (prefers-reduced-motion: no-preference) {
        .fpill { animation: fpillDrift var(--dur) ease-in-out infinite; animation-delay: var(--dly); }
        .fpill:nth-child(even) { animation-direction: reverse; }
      }
      @keyframes fpillDrift {
        0%, 100% { transform: rotate(var(--rot)) translate(0, 0); }
        50% { transform: rotate(var(--rot)) translate(-9px, -13px); }
      }
      @media (max-width: 860px) {
        .wl-close__pills { --s: .62px; }
        .fpill:nth-child(n+4) { display: none; }
      }
      .wl-close::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, var(--green) 0%, var(--green) 38%, rgba(18,60,44,.55) 70%, rgba(18,60,44,.25) 100%); }
      .wl-close__grid { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 26px; padding-top: 56px; padding-bottom: 56px; }
      .wl-close h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.2vw, 2.5rem); margin: 0 0 10px; color: #fff; line-height: 1.12; }
      .wl-close h2 em { font-style: italic; color: #cdb98f; }
      .wl-close p { color: rgba(255,255,255,.65); font-size: 14.5px; margin: 0; max-width: 42ch; }
      .wl-close__feats { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 18px; }
      .wl-close__feats span { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.85); }

      .processing-loader { display: none; width: 34px; height: 34px; margin: 60px auto; border: 2.5px solid rgba(15, 107, 69, .18); border-top-color: var(--brand); border-radius: 50%; animation: wlSpin .8s linear infinite; }
      @keyframes wlSpin { to { transform: rotate(360deg); } }
    </style>
  </Fragment>

  <main class="wl-page">
    <Header />

    <!-- ═══ Hero ═══ -->
    <section class="ab-hero">
      <div class="wl-wrap ab-hero__inner">
        <span class="wl-eyebrow">About Freeley</span>
        <h1 class="wl-serif">Healthcare that <em>fits</em><br />your life</h1>
        <p>Healthcare transparency you can see. Clinical protocols you can trust. Nationwide coverage you can rely on.</p>
      </div>
    </section>

    <!-- ═══ Philosophy & statistics ═══ -->
    <section class="wl-sec">
      <div class="wl-wrap ab-phil">
        <div class="ab-phil__narrative">
          <span class="wl-eyebrow">How It Works</span>
          <h2 class="wl-serif">Real medicine,<br /><em>without the friction</em></h2>
          <p>At Freeley, we believe healthcare shouldn't be about rushed 15-minute appointments, waiting rooms, or fighting with insurance companies. It's about empowering you to achieve your best health — on your terms.</p>
          <p>Our telehealth infrastructure seamlessly connects you to customized, compounded treatments formulated specifically for your body and your goals. Every prescription is reviewed by a board-certified physician and filled by a licensed 503A pharmacy.</p>
        </div>
        <div>
          <div class="ab-quote">
            <p>"We don't just prescribe medication — we build treatment partnerships that evolve with our patients."</p>
            <span>— The Freeley Medical Team</span>
          </div>
          <div class="ab-matrix">
            <h4>What makes us different:</h4>
            <ul>
              {differentiators.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>
      <div class="wl-wrap ab-stats">
        {stats.map((s) => (
          <div class="ab-stat">
            <h3>{s.n}</h3>
            <p>{s.l}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ What we stand for ═══ -->
    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap ab-process__top">
        <div>
          <span class="wl-eyebrow">The Process</span>
          <h2 class="wl-serif">What we<br /><em>stand for</em></h2>
        </div>
        <div class="ab-process__img">
          <img src="/assets/about/dr.png" alt="A Freeley physician" />
        </div>
      </div>
      <div class="wl-wrap ab-process__items">
        {values.map((v) => (
          <div class="ab-process__item">
            <img src={v.icon} alt="" />
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ Built to be different ═══ -->
    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap">
        <div class="wl-head">
          <span class="wl-eyebrow">Why Freeley</span>
          <h2 class="wl-serif">Built to be<br /><em>different</em></h2>
        </div>
      </div>
      <div class="wl-wrap">
        {/* Only 4 real cards (card1.png doubles as slide 4 — no unique 4th
            image exists under /assets/about/), too few to loop cleanly across
            a wide viewport, so this uses rewind instead of loop:true. */}
        <div class="swiper ab-cards-swiper">
          <div class="swiper-wrapper">
            {differentCards.map((img) => (
              <div class="swiper-slide ab-card">
                <img src={img} alt="" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Closing band ═══ -->
    <section class="wl-close">
      <div class="wl-close__pills" aria-hidden="true">
        {ctaPills.map((p) => (
          <span
            class:list={['fpill', `fpill--${p.edge}`, !p.c1 && 'fpill--ghost']}
            style={`--w:${p.w};--h:${p.h};--x:${p.x};--y:${p.y};--rot:${p.rot}deg;--dur:${p.dur}s;--dly:${p.dly}s${p.c1 ? `;--c1:${p.c1};--c2:${p.c2}` : ''}`}
          ></span>
        ))}
      </div>
      <div class="wl-wrap wl-close__grid">
        <div>
          <h2 class="wl-serif">Feel better,<br /><em>starting today.</em></h2>
          <p>Personalized care for every part of you, from weight to skin, sleep to sexual health.</p>
          <div class="wl-close__feats">
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> No credit card required</span>
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Takes 2 minutes</span>
            <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Cancel anytime</span>
          </div>
        </div>
        <button type="button" class="wl-btn wl-btn--light js-start-quiz">
          Start Your Assessment <span class="wl-arw">→</span>
        </button>
      </div>
    </section>

    <!-- Quiz modal — opened by every .js-start-quiz trigger above -->
    <div id="quiz--modal" class="modal">
      <div class="modal-content">
        <span class="close" id="close--quiz"><img src="/assets/icons/close.png" alt="Close" /></span>
        <div class="processing-loader" id="loader"></div>
        <div id="quiz--container"></div>
      </div>
    </div>

    <Footer />
  </main>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
  <script is:inline>
    new Swiper('.ab-cards-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 24,
      rewind: true,
      grabCursor: true,
      autoplay: { delay: 5000, pauseOnMouseEnter: true, disableOnInteraction: false },
    });
  </script>

  <script is:inline>
    (function () {
      var modal = document.getElementById('quiz--modal');
      var loader = document.getElementById('loader');
      var quizContainer = document.getElementById('quiz--container');
      var quizIframe = null;

      document.querySelectorAll('#start-assessment-header, .js-start-quiz').forEach(function (button) {
        button.addEventListener('click', function () {
          if (quizIframe) { quizIframe.remove(); quizIframe = null; }

          modal.style.display = 'block';
          loader.style.display = 'block';
          quizContainer.innerHTML = '';

          quizIframe = document.createElement('iframe');
          quizIframe.style.width = '100%';
          quizIframe.style.height = 'min(780px, calc(100vh - 56px))';
          quizIframe.style.border = 'none';
          quizIframe.style.display = 'none';
          quizIframe.style.background = '#fff';
          quizIframe.src = '/assessment-quiz?t=' + Date.now();

          quizIframe.onload = function () {
            loader.style.display = 'none';
            quizIframe.style.display = 'block';
          };
          quizIframe.onerror = function () {
            loader.style.display = 'none';
            quizContainer.innerHTML = '<p>Unable to load quiz.</p>';
          };

          quizContainer.appendChild(quizIframe);
        });
      });

      function closeQuiz() {
        modal.style.display = 'none';
        if (quizIframe) {
          try {
            quizIframe.src = 'about:blank';
            quizIframe.contentWindow.document.write('');
            quizIframe.contentWindow.document.clear();
          } catch (e) {}
          quizIframe.remove();
          quizIframe = null;
        }
        quizContainer.innerHTML = '';
        loader.style.display = 'none';
      }

      document.getElementById('close--quiz').addEventListener('click', closeQuiz);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.style.display === 'block') closeQuiz();
      });
      window.addEventListener('click', function (e) {
        if (e.target === modal) closeQuiz();
      });
    })();
  </script>

  <!--Start of Tawk.to Script-->
  <script type="text/javascript" is:inline>
    var Tawk_API = Tawk_API || {},
      Tawk_LoadStart = new Date();
    (function () {
      var s1 = document.createElement('script'),
        s0 = document.getElementsByTagName('script')[0];
      s1.async = true;
      s1.src = 'https://embed.tawk.to/6a454f1fb271bd1d477e9990/1jsfbq5mb';
      s1.charset = 'UTF-8';
      s1.setAttribute('crossorigin', '*');
      s0.parentNode.insertBefore(s1, s0);
    })();
  </script>
  <!--End of Tawk.to Script-->
</Layout>
