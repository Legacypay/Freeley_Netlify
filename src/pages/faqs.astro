---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Faqs">
  <Fragment slot="head">
    <!-- Font playfair display embed -->
    <link rel="stylesheet" href="/style/faqsstyle.css" />
  </Fragment>

    <main>

        <!-- Header -->
        <Header />



        <section class="faq-section py-12">
            <div class="container custom-container text-center">

                <!-- Top Category Mini Tag Badge -->
                <div class="bordered--heading inline-block px-4">
                    <span class="uppercase">HELP CENTER</span>
                </div>
                <!-- Main Serif Headers -->
                <div class="max-w-header mx-auto mb-6">
                    <h2 class="serif-heading">Frequently asked <span class="italic-tan">questions</span></h2>
                    <p class="section-subtitle mt-4">
                        Everything you need to know about Freeley — from getting started to managing your treatment.
                    </p>
                </div>

                <!-- Horizontal Category Filter Rows (TABS - FULLY FUNCTIONAL) -->
                <div class="filter-pills-container flex flex-wrap justify-center gap-2 mb-12" id="faqTabContainer">
                    <button class="pill-filter active" data-category="general">General</button>
                    <button class="pill-filter" data-category="treatments">Treatments</button>
                    <button class="pill-filter" data-category="pricing">Pricing &amp; Billing</button>
                    <button class="pill-filter" data-category="shipping">Shipping</button>
                    <button class="pill-filter" data-category="account">Account</button>
                </div>

                <!-- FAQ Blocks Container Layout - DYNAMIC CONTENT UPDATED BY TABS -->
                <div class="faq-blocks-wrapper text-left mx-auto" id="faqContentContainer">
                    <!-- Content will be injected by JavaScript (no CSS alterations) -->
                </div>

            </div>
        </section>


        <section>
            <div id="quiz--modal" class="modal">
                <div class="modal-content">
                    <span class="close" id="close--quiz"><img src="/assets/icons/close.png" /></span>
                    <div class="processing-loader" id="loader"></div>
                    <div id="quiz--container"></div>
                </div>
            </div>
        </section>

        <section class="cta--green bg--green py-12 mb-1">
            <div class="container py-12 ">
                <h2 class="serif-heading text-white text-center">Still have questions?</h2>
                <p class="text-white text-center py-4">Our care team is available Monday–Saturday and responds within 2 hours.</p>
                <div class="cta--buttons flex flex-col md:flex-row justify-start gap-4">
                    <a href="javascript:void(0)" class="global--qua--button bg-white px-4 pr-2 w-full">
                        <img class="btn--icon" src="/assets/home/icons/icon-right-green.svg"> Contact Us
                    </a>
                    <a href="javascript:void(0)" class="global--qua--button transparent px-4 pr-2 w-full">

                            See if you Quality
                </a>
                </div>
            </div>
        </section>


        <!-------------------------------------
        ************** FOOTER ******************
        -------------------------------------->
        <div class="container-fluid">
<div class="footer--header grid grid-cols-1 md:grid-cols-12 items-center pb-12 gap-y-6">
                    <div class="md:col-span-6 flex flex-col gap-4">
                        <h2 class="text-5xl leading-tight mb-0 font-normal">
                            Feel better,<br />
                            <span class="italic">starting today</span>
                        </h2>
                        <p class="text-white/50 text-14-inter">
                            Personalized care for every part of you from weight to skin, sleep to sexual health.
                        </p>
                    </div>

                    <div class="md:col-span-6 flex flex-col items-start md:items-end gap-6">
                        <div>
                            <a href="javascript:void(0)" id="start-assessment" class="global--qua--button bg-white px-4 pr-2 w-full">
                                <img class="btn--icon" src="/assets/home/icons/icon-right-green.svg" /> Start Your Assessment
                            </a>
                        </div>

                        <div class="flex flex-wrap justify-start md:justify-end gap-4 text-white/50 text-sm">
                            <div class="flex text-white items-center gap-1 text-14-inter">
                                <span class="text-white"><svg
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z"
                        fill="white"
                      />
                    </svg>
                  </span> No credit card required
                            </div>
                            <div class="flex text-white items-center gap-1 text-14-inter">
                                <span class=""><svg
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z"
                        fill="white"
                      />
                    </svg>
                  </span> Takes 2 minutes
                            </div>
                            <div class="flex text-white items-center gap-1 text-14-inter">
                                <span class="text-white"><svg
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z"
                        fill="white"
                      />
                    </svg>
                  </span> Cancel anytime
                            </div>
                        </div>
                    </div>
                </div>
</div>

<Footer />
    </main>

    <script src="/style/script.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
    <script is:inline>
        // ==================== FAQ TABS & ACCORDIONS ====================
        // Complete FAQ data sets for each category
        const faqData = {
            general: {
                title: "General questions",
                items: [{
                    q: "What is Freeley?",
                    a: "Freeley is a comprehensive digital health platform designed to streamline weight management and clinical wellness by safely connecting you with licensed healthcare specialists and accredited pharmacy programs."
                }, {
                    q: "Are the physicians real doctors?",
                    a: "Yes, absolutely. All healthcare providers within our clinical network are independently licensed, board-certified physicians based in the US, specializing in metabolic health and internal medicine fields."
                }, {
                    q: "Is Freeley safe?",
                    a: "Patient safety is our primary focus. Our protocols are designed around evidence-based science, thorough health assessments, and ongoing clinical supervision from dedicated professionals."
                }, {
                    q: "What states do you serve?",
                    a: "We support and operate in a vast majority of US states through our network partner pharmacies and state-regulated medical infrastructure providers."
                }]
            },
            treatments: {
                title: "Treatment questions",
                items: [{
                    q: "What treatments do you offer?",
                    a: "We facilitate medical access to personalized metabolic profiles and customized compounded prescription options tailored strictly to your evaluation outcomes."
                }, {
                    q: "What are compounded medications?",
                    a: "Compounded medications are customized pharmaceutical solutions mixed by specialized state-licensed facilities to align precisely with specific dosage and presentation requests."
                }, {
                    q: "How long until I see results?",
                    a: "Individual physiological baselines vary, but many users observe incremental improvements within the first few weeks when aligned with clinical guidance."
                }, {
                    q: "Can I switch treatments or adjust my dosage?",
                    a: "Yes, adjustments are handled directly by your consulting provider based on check-ins, updates, and regular progress monitoring cycles."
                }]
            },
            pricing: {
                title: "Pricing & Billing",
                items: [{
                    q: "How much does Freeley cost?",
                    a: "Our pricing is transparent and membership-based starting at competitive rates. Detailed pricing information is available during your consultation."
                }, {
                    q: "Is there a consultation fee?",
                    a: "Initial assessments are typically included in your first-month membership. You'll see full cost breakdown before any commitment."
                }, {
                    q: "What payment methods do you accept?",
                    a: "We accept all major credit cards, HSA/FSA cards, and offer flexible payment options."
                }, {
                    q: "Can I cancel anytime?",
                    a: "Absolutely. You can cancel your subscription at any time with no hidden fees or penalties."
                }]
            },
            shipping: {
                title: "Shipping & Delivery",
                items: [{
                    q: "How quickly will I receive my order?",
                    a: "Orders are typically processed within 3-5 business days and shipped via discreet packaging with tracking information."
                }, {
                    q: "Do you ship to all 50 states?",
                    a: "Yes, we partner with pharmacies that ship nationwide across all 50 U.S. states."
                }, {
                    q: "Is shipping free?",
                    a: "Shipping is included in your membership plan. No extra fees for standard delivery."
                }, {
                    q: "What if my package is delayed or lost?",
                    a: "Contact our support team immediately and we'll work with the pharmacy to resolve the issue promptly."
                }]
            },
            account: {
                title: "Account Management",
                items: [{
                    q: "How do I create an account?",
                    a: "Simply click 'Start Your Assessment' and follow the registration process. It takes less than 2 minutes."
                }, {
                    q: "How do I update my personal information?",
                    a: "Log into your dashboard and navigate to profile settings to update your details."
                }, {
                    q: "What if I forget my password?",
                    a: "Use the 'Forgot Password' link on the login page to reset your credentials securely."
                }, {
                    q: "Can I have multiple treatment plans?",
                    a: "Yes, you can manage multiple health concerns under one account with separate care plans."
                }]
            }
        };

        // Get references
        const faqTabs = document.querySelectorAll('.pill-filter');
        const faqContainer = document.getElementById('faqContentContainer');

        // Function to generate accordion HTML with unique IDs per tab and item
        function renderFaqContent(categoryKey) {

            const category = faqData[categoryKey];
            if (!category) {
                faqContainer.innerHTML = '<p class="text-center text-red-600">Category not found</p>';
                return;
            }


            // Generate a unique ID base to avoid conflicts between tab switches
            const uniqueId = `faqAccordion_${categoryKey}_${Date.now()}`;
            let accordionItemsHtml = '';

            category.items.forEach((item, idx) => {
                const collapseId = `${uniqueId}_collapse_${idx}`;
                const headerId = `${uniqueId}_heading_${idx}`;
                accordionItemsHtml += `
            <div class="accordion-item">
                <h2 class="accordion-header" id="${headerId}">
                    <button class="accordion-button collapsed" type="button" aria-expanded="false">
                        ${escapeHtml(item.q)}
                    </button>
                </h2>
                <div id="${collapseId}" class="accordion-collapse">
                    <div class="accordion-body">
                        ${escapeHtml(item.a)}
                    </div>
                </div>
            </div>
        `;
            });

            const fullHtml = `
        <div class="faq-category-card rounded-[2rem] p-6 md:p-12 mb-12">
            <h3 class="category-serif-title text-center mb-6">${escapeHtml(category.title)}</h3>
            <div class="accordion custom-faq-accordion" id="${uniqueId}">
                ${accordionItemsHtml}
            </div>
        </div>
    `;

            faqContainer.innerHTML = fullHtml;
        }

        // Accordion toggle (vanilla JS replacement for the old collapse-component JS):
        // one open panel per accordion group, plain class + aria-expanded toggle.
        faqContainer.addEventListener('click', function(e) {
            const button = e.target.closest('.accordion-button');
            if (!button) return;

            const item = button.closest('.accordion-item');
            const collapseEl = item.querySelector('.accordion-collapse');
            const accordion = button.closest('.accordion');
            const willOpen = !collapseEl.classList.contains('show');

            // Close every panel in the group first (single-open-at-a-time behavior)
            accordion.querySelectorAll('.accordion-item').forEach(otherItem => {
                otherItem.querySelector('.accordion-button').classList.add('collapsed');
                otherItem.querySelector('.accordion-button').setAttribute('aria-expanded', 'false');
                otherItem.querySelector('.accordion-collapse').classList.remove('show');
            });

            if (willOpen) {
                button.classList.remove('collapsed');
                button.setAttribute('aria-expanded', 'true');
                collapseEl.classList.add('show');
            }
        });

        // Simple XSS protection
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        // Tab click handler: update active class, render content
        faqTabs.forEach(tab => {
            tab.addEventListener('click', function(e) {
                console.log('Tab clicked:', this.textContent); // Debug log

                // Update active class on tabs
                faqTabs.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');

                // Get category from data-category attribute
                const category = this.getAttribute('data-category');
                console.log('Category from attribute:', category); // Debug log

                if (category && faqData[category]) {
                    renderFaqContent(category);
                } else {
                    console.warn('Invalid category, falling back to general');
                    renderFaqContent('general');
                }
            });
        });


        // Initial load: render General category (active by default)
        renderFaqContent('general');
    </script>

    <script is:inline>
        const modal = document.getElementById('quiz--modal');
        const loader = document.getElementById('loader');
        const quizContainer = document.getElementById('quiz--container');
        let quizIframe = null;

        document.querySelectorAll(
            '#start-assessment, #start-full-assessment, #start-assessment-header'
        ).forEach(button => {
            button.addEventListener('click', () => {
                // If iframe exists, remove it first
                if (quizIframe) {
                    quizIframe.remove();
                    quizIframe = null;
                }

                modal.style.display = 'block';
                loader.style.display = 'block';
                quizContainer.innerHTML = '';

                // Create new iframe
                quizIframe = document.createElement('iframe');
                quizIframe.style.width = '100%';
                quizIframe.style.height = '605px';
                quizIframe.style.border = 'none';
                quizIframe.style.borderRadius = '0';
                quizIframe.style.display = 'none';
                quizIframe.style.background = '#0000004D';

                // Load with cache-busting
                quizIframe.src = '/assessment-quiz?t=' + Date.now();

                quizIframe.onload = function() {
                    loader.style.display = 'none';
                    quizIframe.style.display = 'block';

                    // Apply styles to iframe body (if you have access)
                    try {
                        const iframeDoc = quizIframe.contentDocument || quizIframe.contentWindow.document;
                        if (iframeDoc) {
                            const style = iframeDoc.createElement('style');
                            style.textContent = `
                            body {
                                background: #0000004D !important;
                                border: 0 !important;
                                border-radius: 0 !important;
                                height: 100vh;
                                margin: 0;
                            }
                        `;
                            iframeDoc.head.appendChild(style);
                        }
                    } catch (e) {
                        // Cross-origin restrictions may prevent this
                        console.log('Cannot style iframe body due to CORS');
                    }
                };

                quizIframe.onerror = function() {
                    loader.style.display = 'none';
                    quizContainer.innerHTML = '<p>Unable to load quiz.</p>';
                };

                quizContainer.appendChild(quizIframe);
            });
        });

        function closeQuiz() {
            // Hide modal
            modal.style.display = 'none';

            // Remove iframe completely
            if (quizIframe) {
                // Clear iframe content
                try {
                    quizIframe.src = 'about:blank';
                    quizIframe.contentWindow.document.write('');
                    quizIframe.contentWindow.document.clear();
                } catch (e) {}

                // Remove from DOM
                quizIframe.remove();
                quizIframe = null;
            }

            // Clear container
            quizContainer.innerHTML = '';
            loader.style.display = 'none';
        }

        document
            .getElementById('close--quiz')
            .addEventListener('click', closeQuiz);

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.style.display === 'block') {
                closeQuiz();
            }
        });

        // Close when clicking outside
        window.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeQuiz();
            }
        });
    </script>

