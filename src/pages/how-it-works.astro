---
// HOW IT WORKS — rebuilt in the /prototype design language. Unlike the
// vertical pages, this one is a single scroll-storytelling experience (a
// 6-step timeline that lights up as you scroll) rather than a set of stock
// sections, so it keeps its own structure instead of the wl- vertical
// skeleton. All step/feature/safety images are the page's own existing
// assets under /assets/howItsWork/ — kept as-is, only laid out and styled.
//
// Fixed while rebuilding:
//  - Fonts/colors were Playfair Display + hardcoded hex, not /prototype's
//    actual tokens (Source Serif 4 / Archivo, --brand/--gold/--green).
//  - The "Physician Messaging" platform card had the Ongoing-Care-&-Refills
//    copy pasted into it — wrong feature, wrong page section. Rewritten.
//  - The pharmacy spec card embedded a live Google Map of "Florida" under
//    "Medication specifications" — unrelated to medication specs. Removed.
//  - Two closing CTAs stacked back to back (a cta-girl.png banner, then a
//    second "Feel better, starting today" band). Consolidated into the one
//    capsule-drift closing band every other rebuilt page uses.
//  - Both swipers manually cloned their slides 3x in JS to fake a loop;
//    replaced with Swiper's native loop:true + pagination dots.
//  - id="start-assessment" is the anchor public/style/script.js uses to pin
//    a bar to the viewport top on mobile scroll — this page never used that
//    behavior, so triggers use classes only (.js-start-quiz), not that id.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const steps = [
  {
    n: '1',
    title: 'Complete Your Health Intake',
    text: "Answer a brief, HIPAA-secure health questionnaire on any device. We ask about your goals, symptoms, medical history, current medications, and lifestyle preferences. No appointment. No waiting room.",
    tipLabel: 'Tip:',
    tip: 'Have your current medication list handy if applicable — it speeds up physician review.',
    img: '/assets/howItsWork/Complete_Your_Health_Intake.png',
  },
  {
    n: '2',
    title: 'Physician Reviews Your Profile',
    text: 'A board-certified physician licensed in your state reviews your intake, evaluates your eligibility, and designs your personalized treatment protocol. They may request additional information or labs before finalizing your plan.',
    tipLabel: 'Note:',
    tip: 'All decisions are made by licensed physicians — never an algorithm or AI replacement.',
    img: '/assets/howItsWork/Physician_Reviews_Your_Profile.png',
  },
  {
    n: '3',
    title: 'You Receive Your Treatment Plan',
    text: "Once approved, your physician's treatment plan is sent to your Freeley account. This includes your diagnosis, prescribed medication, dosage, titration schedule, and care instructions. You can message your physician with any questions before agreeing.",
    tipLabel: 'Your plan includes:',
    tip: 'Medication name, dose, delivery format, titration schedule, and refill cadence.',
    img: '/assets/howItsWork/You_Receive_Your_Treatment_Plan.png',
  },
  {
    n: '4',
    title: 'Pharmacy Compounds Your Medication',
    text: 'Your prescription is routed to one of our 503B-licensed compounding pharmacy partners. Your medication is compounded fresh from pharmaceutical-grade ingredients to exact specifications. Quality tested and verified before shipment.',
    tipLabel: 'Quality standard:',
    tip: 'USP 797 compliant. Tested for potency, sterility, and purity.',
    img: '/assets/howItsWork/Pharmacy%20Compounds%20Your%20Medication.png',
  },
  {
    n: '5',
    title: 'Delivered to Your Door',
    text: "Your medication ships in discreet, climate-controlled packaging with detailed instructions, supplies (if applicable), and your physician's contact for follow-up. Track your shipment in real time through your Freeley account.",
    tipLabel: 'Packaging:',
    tip: 'Unmarked exterior. No indication of pharmaceutical contents on the outside of the package.',
    img: '/assets/howItsWork/Delivered_to_Your_Door.png',
  },
  {
    n: '6',
    title: 'Ongoing Care & Automatic Refills',
    text: "Your physician monitors your progress, adjusts your dosage as needed, and refills automatically so you never run out. Monthly check-ins keep your treatment optimized. Quarterly labs ensure you're always in a safe and effective range.",
    tipLabel: 'Included:',
    tip: 'Monthly check-ins, dosage adjustments, lab monitoring, and unlimited physician messaging.',
    img: '/assets/howItsWork/Ongoing_Care_&_Automatic_Refills.png',
  },
];

// The platform features carousel — icon art is the page's own ghost-icon
// PNGs (already tuned gradients/offsets below, kept from the prior build).
const feats = [
  {
    title: 'Physician Messaging',
    // ⚠️ Was showing the Ongoing-Care-&-Refills paragraph — wrong feature.
    desc: 'Message your physician directly through your Freeley account. Ask questions about your treatment, report side effects, or request an adjustment — most messages get a response within 24 hours.',
    gradient: 'linear-gradient(119.47deg, #D2CBC2 3.65%, #F0E9E0 109.47%)',
    icon: '/assets/howItsWork/Physician%20Messaging.png',
    iconSize: '120%',
    iconPos: 'center -300px',
  },
  {
    title: 'Progress Dashboard',
    desc: 'Track your weight, lab values, and treatment history over time. Visual charts make it easy to see your progress and share with your physician.',
    gradient: 'linear-gradient(180deg, #E7EAF0 0%, #F3F4EF 100%)',
    icon: '/assets/howItsWork/Progress%20Dashboard.png',
    iconSize: '100%',
    iconPos: 'center -50px',
  },
  {
    title: 'Smart Reminders',
    desc: 'Dosing reminders, refill notifications, and lab scheduling alerts — all configurable to your preferences. Never miss a dose or a check-in.',
    gradient: 'radial-gradient(160.98% 160.98% at 50% 100%, #F6EEE0 0%, #FFDAAD 100%)',
    icon: '/assets/howItsWork/Smart%20Reminders.png',
    iconSize: '200%',
    iconPos: '-235px -160px',
  },
  {
    title: 'Document Vault',
    desc: 'All your prescriptions, lab results, and physician notes are securely stored and accessible anytime. Export and share with your PCP as needed.',
    gradient: 'radial-gradient(171.32% 171.32% at 50.12% 100%, #F8FEFF 0%, #C7D0E4 100%)',
    icon: '/assets/howItsWork/Document%20Vault.png',
    iconSize: '200%',
    iconPos: 'center -295px',
  },
];

const pharmacyBadges = ['503A Licensed', 'USP 797 Compliant', 'State Board Approved', 'PCAB Accredited', 'Third-Party Tested', 'Cold Chain Verified'];

const specs = [
  { label: 'Active Ingredient', value: 'Pharmaceutical-grade USP' },
  { label: 'Potency Testing', value: '98–102% verified' },
  { label: 'Sterility Testing', value: 'Passed before shipment' },
  { label: 'Endotoxin Testing', value: 'USP threshold compliant' },
  { label: 'Storage temp', value: '2–8°C cold chain' },
  { label: 'Expiry', value: 'Per batch CoA documentation' },
];

// Already fully baked (photo + heading + copy) full-card exports — shown as
// images, not overlaid with our own text.
const safetyCards = [
  { img: '/assets/howItsWork/yourSafety1.png', alt: 'Physician Gating — no medication ships without an active prescription' },
  { img: '/assets/howItsWork/yourSafety2.png', alt: 'HIPAA-Compliant Infrastructure — your data is encrypted and never sold' },
  { img: '/assets/howItsWork/yourSafety3.png', alt: 'Adverse Event Monitoring — physicians are notified of any reported side effects' },
];

// Decorative capsule drift behind the closing CTA — /prototype's final
// section, same arrangement every rebuilt page uses.
const ctaPills = [
  { w: 218, h: 76, x: -46, edge: 'top', y: -26, rot: -28, c1: 'var(--cream)', c2: 'var(--brand)', dur: 11, dly: 0 },
  { w: 172, h: 60, x: 128, edge: 'bottom', y: -30, rot: -24, c1: 'var(--gold)', c2: 'var(--green-deep)', dur: 13, dly: -2 },
  { w: 98, h: 35, x: 46, edge: 'bottom', y: 34, rot: -26, c1: 'var(--cream)', c2: 'var(--gold)', dur: 12, dly: -5 },
  { w: 124, h: 44, x: 236, edge: 'top', y: 30, rot: -31, c1: '#fff', c2: '#2c6b4c', dur: 14, dly: -3 },
  { w: 56, h: 20, x: 96, edge: 'top', y: 8, rot: -28, c1: 'var(--brand)', c2: 'var(--cream)', dur: 10, dly: -6 },
  { w: 86, h: 31, x: 180, edge: 'bottom', y: 60, rot: -27, c1: 'var(--gold)', c2: 'var(--cream)', dur: 15, dly: -8 },
  { w: 74, h: 27, x: 344, edge: 'bottom', y: 16, rot: -28, dur: 12, dly: -7 },
  { w: 64, h: 23, x: 300, edge: 'top', y: 4, rot: -25, c1: 'var(--cream)', c2: '#2c6b4c', dur: 13, dly: -4 },
  { w: 148, h: 52, x: 392, edge: 'top', y: -18, rot: -29, c1: '#2c6b4c', c2: 'var(--cream)', dur: 16, dly: -9 },
  { w: 112, h: 40, x: 470, edge: 'bottom', y: -14, rot: -26, dur: 14, dly: -11 },
  { w: 130, h: 46, x: 556, edge: 'top', y: 20, rot: -28, dur: 17, dly: -13 },
];
---

<Layout title="How It Works | Freeley">
  <Fragment slot="head">
    <style is:inline>
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-btn-ghost { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; cursor: pointer; transition: background .15s; }
      .wl-btn-ghost:hover { background: #faf8f2; color: var(--ink); }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }
      .wl-head { max-width: 660px; margin-bottom: 40px; }
      .wl-head h2 { font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.1; margin: 14px 0 12px; }
      .wl-head p { color: var(--muted); font-size: 15px; margin: 0; }

      /* ── Hero (text-only, no side photo needed on this page) ─── */
      .wl-hiw-hero { background: linear-gradient(180deg, #eef1ec 0%, var(--cream) 100%); padding: 64px 0 56px; text-align: center; }
      .wl-hiw-hero__inner { max-width: 700px; margin: 0 auto; }
      .wl-hiw-hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.08; margin: 16px 0 18px; }
      .wl-hiw-hero p { color: var(--muted); font-size: 16px; max-width: 56ch; margin: 0 auto 28px; }

      /* ── Scroll-storytelling timeline ───────────────────────── */
      .wl-tl { position: relative; padding: 60px 0 10px; }
      .wl-tl__line {
        position: absolute; left: 50%; top: 0; bottom: 60px; width: 2px; transform: translateX(-50%); z-index: 1;
        background: repeating-linear-gradient(to bottom, var(--brand) 0px, var(--brand) 16px, transparent 16px, transparent 38px);
      }
      .wl-tl__row { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 48px; }
      .wl-tl__row:last-child { margin-bottom: 0; }
      @media (min-width: 900px) {
        .wl-tl__row { grid-template-columns: 1fr 84px 1fr; align-items: center; gap: 0; margin-bottom: 88px; }
        .wl-tl__row--rev .wl-tl__text { order: 3; }
        .wl-tl__row--rev .wl-tl__num { order: 2; }
        .wl-tl__row--rev .wl-tl__img { order: 1; }
      }
      .wl-tl__num { display: none; }
      @media (min-width: 900px) {
        .wl-tl__num {
          display: flex; width: 46px; height: 46px; border-radius: 999px; background: #fff; border: 2px solid var(--line);
          align-items: center; justify-content: center; font-family: var(--font-sans); font-weight: 700; font-size: 15px;
          color: var(--brand); margin: 0 auto; transition: background .35s ease, border-color .35s ease, color .35s ease; position: relative; z-index: 3;
        }
        .wl-tl__num.is-active { background: var(--green); border-color: var(--green); color: #fff; }
      }
      .wl-tl__num--mobile {
        display: inline-flex; width: 32px; height: 32px; border-radius: 999px; background: var(--green); color: #fff;
        align-items: center; justify-content: center; font-family: var(--font-sans); font-weight: 700; font-size: 13px; margin-bottom: 14px;
      }
      @media (min-width: 900px) { .wl-tl__num--mobile { display: none; } }
      .wl-tl__text h2 { font-family: var(--font-serif); font-weight: 600; font-size: clamp(1.4rem, 2.6vw, 1.7rem); margin: 0 0 12px; color: var(--ink); line-height: 1.2; }
      @media (min-width: 900px) { .wl-tl__row:not(.wl-tl__row--rev) .wl-tl__text { padding-right: 40px; } .wl-tl__row--rev .wl-tl__text { padding-left: 40px; } }
      .wl-tl__text p { font-family: var(--font-sans); font-size: 14.5px; color: var(--muted); line-height: 1.6; margin: 0 0 16px; }
      .wl-tl__tip { background: rgba(15,107,69,.08); border-radius: 12px; padding: 14px 18px; font-size: 13px; color: var(--green-deep, #0d3122); line-height: 1.5; }
      .wl-tl__tip strong { display: block; margin-bottom: 4px; font-weight: 700; }
      .wl-tl__img { border-radius: 18px; overflow: hidden; background: var(--card); aspect-ratio: 4 / 3; }
      .wl-tl__img img { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* ── Platform features carousel ─────────────────────────── */
      .wl-feat-swiper { padding-bottom: 46px; }
      .wl-feat-swiper .swiper-slide { width: 280px; }
      @media (min-width: 700px) { .wl-feat-swiper .swiper-slide { width: 320px; } }
      .wl-feat__card { position: relative; border-radius: 20px; overflow: hidden; height: 380px; padding: 26px 24px; display: flex; flex-direction: column; justify-content: flex-end; }
      .wl-feat__icon { position: absolute; inset: 0; background-repeat: no-repeat; }
      .wl-feat__body { position: relative; z-index: 1; }
      .wl-feat__body h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.3rem; margin: 0 0 10px; color: var(--ink); line-height: 1.2; }
      .wl-feat__body p { font-family: var(--font-sans); font-size: 13.5px; color: rgba(23,34,42,.68); margin: 0; line-height: 1.55; }
      .wl-swiper-dots.swiper-pagination { position: static; margin-top: 4px; }
      .wl-swiper-dots .swiper-pagination-bullet { background: var(--line); opacity: 1; width: 7px; height: 7px; }
      .wl-swiper-dots .swiper-pagination-bullet-active { background: var(--brand); }

      /* ── Pharmacy standards ──────────────────────────────────── */
      .wl-pharm { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 1000px) { .wl-pharm { grid-template-columns: 1fr 1fr; gap: 64px; } }
      .wl-pharm__badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
      .wl-pharm__badges span { background: rgba(15,107,69,.08); color: var(--green); font-family: var(--font-sans); font-size: 13px; font-weight: 600; padding: 8px 16px; border-radius: 999px; }
      .wl-spec { background: var(--card); border-radius: 22px; padding: 34px 32px; }
      .wl-spec h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.4rem; margin: 0 0 18px; }
      .wl-spec__row { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--line); }
      .wl-spec__row:last-child { border-bottom: none; }
      .wl-spec__label { font-size: 12.5px; color: var(--muted); }
      .wl-spec__value { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--ink); text-align: right; }

      /* ── Safety carousel ─────────────────────────────────────── */
      .wl-safety-swiper { padding-bottom: 46px; }
      .wl-safety-swiper .swiper-slide { width: 260px; }
      @media (min-width: 700px) { .wl-safety-swiper .swiper-slide { width: 300px; } }
      .wl-safety__card { border-radius: 20px; overflow: hidden; box-shadow: 0 20px 44px rgba(23,34,42,.14); }
      .wl-safety__card img { width: 100%; display: block; }

      /* ── Closing band (same capsule treatment every rebuilt page uses) ── */
      .wl-close { position: relative; background: var(--green); color: #fff; overflow: hidden; }
      .wl-close__pills { --s: 1px; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
      .fpill {
        position: absolute; border-radius: 999px;
        width: calc(var(--w) * var(--s)); height: calc(var(--h) * var(--s));
        right: calc(var(--x) * var(--s));
        background-image: linear-gradient(90deg, var(--c1) 0 50%, var(--c2) 50% 100%);
        box-shadow: 0 16px 32px rgba(0, 0, 0, .3);
        transform: rotate(var(--rot));
      }
      .fpill--top { top: calc(var(--y) * var(--s)); }
      .fpill--bottom { bottom: calc(var(--y) * var(--s)); }
      .fpill::after { content: ''; position: absolute; inset: 17% 13% auto; height: 21%; border-radius: 999px; background: rgba(255, 255, 255, .26); }
      .fpill--ghost { background-image: none; border: 1.5px solid rgba(255, 255, 255, .3); box-shadow: none; }
      .fpill--ghost::after { display: none; }
      @media (prefers-reduced-motion: no-preference) {
        .fpill { animation: fpillDrift var(--dur) ease-in-out infinite; animation-delay: var(--dly); }
        .fpill:nth-child(even) { animation-direction: reverse; }
      }
      @keyframes fpillDrift {
        0%, 100% { transform: rotate(var(--rot)) translate(0, 0); }
        50% { transform: rotate(var(--rot)) translate(-9px, -13px); }
      }
      @media (max-width: 860px) {
        .wl-close__pills { --s: .62px; }
        .fpill:nth-child(n+4) { display: none; }
      }
      .wl-close::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, var(--green) 0%, var(--green) 38%, rgba(18,60,44,.55) 70%, rgba(18,60,44,.25) 100%); }
      .wl-close__grid { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 26px; padding-top: 56px; padding-bottom: 56px; }
      .wl-close h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.2vw, 2.5rem); margin: 0 0 10px; color: #fff; line-height: 1.12; }
      .wl-close h2 em { font-style: italic; color: #cdb98f; }
      .wl-close p { color: rgba(255,255,255,.65); font-size: 14.5px; margin: 0; max-width: 42ch; }
      .wl-close__feats { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 18px; }
      .wl-close__feats span { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.85); }

      .processing-loader { display: none; width: 34px; height: 34px; margin: 60px auto; border: 2.5px solid rgba(15, 107, 69, .18); border-top-color: var(--brand); border-radius: 50%; animation: wlSpin .8s linear infinite; }
      @keyframes wlSpin { to { transform: rotate(360deg); } }
    </style>
  </Fragment>

  <main class="wl-page">
    <Header />

    <!-- ═══ Hero ═══ -->
    <section class="wl-hiw-hero">
      <div class="wl-wrap wl-hiw-hero__inner">
        <span class="wl-eyebrow">How It Works</span>
        <h1 class="wl-serif">From your couch<br />to your <em>doorstep</em></h1>
        <p>The entire Freeley experience — from your first visit to your first refill — is designed to be effortless, fast, and fully remote.</p>
        <button type="button" class="wl-btn js-start-quiz">See if You Qualify <span class="wl-arw">→</span></button>
      </div>
    </section>

    <!-- ═══ Scroll-storytelling timeline ═══ -->
    <section class="wl-sec">
      <div class="wl-wrap wl-tl">
        <div class="wl-tl__line" aria-hidden="true"></div>
        {steps.map((s, i) => (
          <div class={`wl-tl__row ${i % 2 === 1 ? 'wl-tl__row--rev' : ''}`}>
            <div class="wl-tl__text">
              <span class="wl-tl__num--mobile">{s.n}</span>
              <h2>{s.title}</h2>
              <p>{s.text}</p>
              <div class="wl-tl__tip"><strong>{s.tipLabel}</strong>{s.tip}</div>
            </div>
            <div class="wl-tl__num">{s.n}</div>
            <div class="wl-tl__img">
              <img src={s.img} alt={s.title} loading="lazy" />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ Platform features ═══ -->
    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap">
        <div class="wl-head">
          <span class="wl-eyebrow">The Platform</span>
          <h2 class="wl-serif">Everything managed<br /><em>in one place</em></h2>
        </div>
      </div>
      <div class="wl-wrap">
        <div class="swiper wl-feat-swiper">
          <div class="swiper-wrapper">
            {/* Rendered twice: with only 4 real cards, Swiper's loop needs
                more slides than fit twice across a wide viewport to clone
                from cleanly. Pagination dots are skipped for this carousel
                (autoplay + drag is enough) so the duplication doesn't show
                up as a confusing doubled dot count. */}
            {[...feats, ...feats].map((f) => (
              <div class="swiper-slide wl-feat__card" style={`background:${f.gradient}`}>
                <div class="wl-feat__icon" style={`background-image:url('${f.icon}'); background-size:${f.iconSize}; background-position:${f.iconPos}`}></div>
                <div class="wl-feat__body">
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Pharmacy standards ═══ -->
    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap wl-pharm">
        <div>
          <span class="wl-eyebrow">Pharmacy Standards</span>
          <h2 class="wl-serif" style="margin:14px 0 12px; font-size:clamp(2rem,3.8vw,2.7rem); line-height:1.1;">Only the best<br /><em>pharmacy partners</em></h2>
          <p style="color:var(--muted); font-size:15px; margin:0; max-width:48ch;">We only partner with 503A-licensed compounding pharmacies that meet the highest standards of quality, safety, and compliance.</p>
          <div class="wl-pharm__badges">
            {pharmacyBadges.map((b) => <span>{b}</span>)}
          </div>
        </div>
        <div class="wl-spec">
          <h3>Medication specifications</h3>
          {specs.map((s) => (
            <div class="wl-spec__row">
              <span class="wl-spec__label">{s.label}</span>
              <span class="wl-spec__value">{s.value}</span>
