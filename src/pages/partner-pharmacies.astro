---
// PARTNER PHARMACIES — reskinned onto the .wl- design system (design.md),
// same content and section order as before (hero → transparency/contact →
// dispensing locations → closing CTA → footer). The legacy #quiz--modal
// div/script pair is gone, replaced by the shared <QuizModal /> component
// every #start-assessment* trigger now opens, same migration hair-loss.astro
// and weight-loss.astro already did.
//
// Known pre-existing issue, left alone (design.md): the 9 location cards
// below are real content, not placeholders — the same "Gilbert, AZ" address
// repeated 9x is a data bug upstream of this redesign, out of scope here.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import QuizModal from '../components/QuizModal.astro';

const locations = [
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
  { city: 'Gilbert, AZ', type: 'Sterile & Non-Sterile', address: '1275 E Baseline Rd, Ste 104', cityState: 'Gilbert, AZ 85233', phone: '(855) 453-2500', tel: '18554532500' },
];
---

<Layout title="Partner Pharmacies | Freeley">
  <Fragment slot="head">
    <style is:inline>
      /* Design tokens already declared in public/style/style.css :root
         (--green, --cream, --font-serif, …) — see design.md. Scoped to
         wl- classes so none of the legacy global.css/style.css cascade
         (or the old partnerstyle.css, now removed) reaches this markup. */
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }

      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-foot { font-size: 11.5px; color: var(--muted); margin-top: 16px; }
      .wl-head { max-width: 640px; margin: 0 0 32px; }

      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }

      /* ── Hero ───────────────────────────────────────────────── */
      .wl-pp-hero { padding-top: 56px; padding-bottom: 36px; text-align: center; }
      .wl-pp-hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.08; margin: 10px 0 0; }

      /* ── Transparency + Strive contact panel ───────────────── */
      .wl-pp-trust { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 900px) { .wl-pp-trust { grid-template-columns: 1.1fr 1fr; } }
      .wl-pp-trust p { color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0 0 16px; }
      .wl-pp-panel {
        position: relative; overflow: hidden; border-radius: 20px; border: 1px solid var(--line);
        padding: 40px 32px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
        min-height: 320px;
        background: linear-gradient(180deg, #E7EAF0 0%, #F3F4EF 100%), url('/assets/pp/gradient.svg');
        background-size: cover; background-position: center; background-repeat: no-repeat;
      }
      .wl-pp-panel__img { display: flex; justify-content: center; }
      .wl-pp-panel__img img { width: 220px; height: auto; }
      .wl-pp-panel h4 { font-family: var(--font-serif); font-weight: 600; font-size: 1.15rem; margin: 0 0 12px; color: var(--ink); }
      .wl-pp-panel p { color: var(--ink); font-size: 14.5px; margin: 0 0 8px; }
      .wl-pp-panel a { color: var(--brand); font-weight: 600; text-decoration: none; }
      .wl-pp-panel a:hover { text-decoration: underline; }

      /* ── Dispensing locations ─────────────────────────────── */
      .wl-pp-locations { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .wl-pp-locations { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 980px) { .wl-pp-locations { grid-template-columns: repeat(3, 1fr); } }
      .wl-pp-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
      .wl-pp-card h4 { font-family: var(--font-serif); font-weight: 600; font-size: 1.15rem; margin: 0 0 6px; color: var(--ink); }
      .wl-pp-card .wl-pp-type { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); margin: 0 0 18px; }
      .wl-pp-card .wl-pp-address { color: var(--muted); font-size: 14.5px; line-height: 1.5; margin: 0 0 12px; }
      .wl-pp-card .wl-pp-phone { font-size: 14.5px; margin: 0; }
      .wl-pp-card .wl-pp-phone a { color: var(--ink); font-weight: 600; text-decoration: none; }
      .wl-pp-card .wl-pp-phone a:hover { color: var(--brand); }

      /* ── Motion, gated exactly as the rest of the .wl- system ── */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .wl-pp-card, .wl-pp-panel { animation: wlRise linear both; animation-timeline: view(); animation-range: entry 6% cover 24%; }
          @keyframes wlRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
        }
      }
    </style>
  </Fragment>

  <main class="wl-page">
    <Header />

    <section class="wl-sec wl-pp-hero" style="padding-bottom:36px;">
      <div class="wl-wrap">
        <span class="wl-eyebrow">Freeley Network</span>
        <h1 class="wl-serif">Partner <em>Pharmacies</em></h1>
      </div>
    </section>

    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap wl-pp-trust">
        <div>
          <h2 class="wl-serif" style="font-size:clamp(1.8rem,3.2vw,2.4rem); margin:0 0 16px;">
            Our Commitment to <em>Transparency &amp; Quality</em>
          </h2>
          <p>Freeley is committed to providing the highest quality healthcare experience. As a telehealth platform, we partner with fully licensed, US-based 503A compounding pharmacies to fulfill prescribed medications. All partner pharmacies are held to rigorous quality and safety standards.</p>
          <p style="margin-bottom:0;">Together with our partner Strive Pharmacy, we are proud to serve patients nationwide across all 50 U.S. states.</p>
        </div>
        <div class="wl-pp-panel">
          <div class="wl-pp-panel__img">
            <img src="/assets/strive.png" alt="Strive Pharmacy" loading="lazy" />
          </div>
          <div>
            <h4>Strive Pharmacy Contacts</h4>
            <p>Central Contact Number: <a href="tel:+18554532500">+1 (855) 453-2500</a></p>
            <p style="margin-bottom:0;">Email: <a href="mailto:INFO@STRIVEPHARMACY.COM">INFO@STRIVEPHARMACY.COM</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="wl-sec" style="padding-top:0;">
      <div class="wl-wrap">
        <div class="wl-head">
          <h2 class="wl-serif">Dispensing <em>Locations</em></h2>
          <p style="color:var(--muted); margin-top:10px;">Medications prescribed through the Freeley platform may be fulfilled and dispensed by one of the following licensed Strive Pharmacy locations based on the patient's state of residence and specific medication needs:</p>
        </div>
        <div class="wl-pp-locations">
          {locations.map((l) => (
            <div class="wl-pp-card">
              <h4>{l.city}</h4>
              <p class="wl-pp-type">{l.type}</p>
              <p class="wl-pp-address">{l.address}<br />{l.cityState}</p>
              <p class="wl-pp-phone">Phone: <a href={`tel:${l.tel}`}>{l.phone}</a></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCta features={['503A-licensed pharmacies', 'Physician-reviewed prescriptions', 'Nationwide shipping']}>
      Feel better,<br /><em>starting today.</em>
      <Fragment slot="subheading">Personalized care for every part of you, from weight to skin, sleep to sexual health.</Fragment>
      <a href="/assessment-quiz" class="wl-btn wl-btn--light" id="start-assessment6" slot="cta">
        Start Your Assessment <span class="wl-arw">→</span>
      </a>
    </FinalCta>

    <Footer />
    <QuizModal />
  </main>
</Layout>
