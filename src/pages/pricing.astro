---
// PRICING — rebuilt in the /prototype design language (see how-it-works.astro
// for the shared token block this page copies its <style is:inline> from).
//
// Fixed while rebuilding:
//  - Fonts/colors were Playfair Display + Inter + hardcoded hex (#004C27,
//    #C5984E, #008262), not /prototype's actual tokens. pricestyle.css is no
//    longer linked — everything it defined is replaced by wl- scoped rules
//    below, same pattern as weight-loss.astro / how-it-works.astro.
//  - AOS (external CDN library) dropped in favor of the native
//    @supports (animation-timeline: view()) scroll-reveal every other
//    rebuilt page already uses — one less network dependency, same effect.
//  - The 4 FAQ answers were all the identical GLP-1 side-effects paragraph,
//    copy-pasted from the weight-loss FAQ — wrong content for a pricing
//    page. Rewritten from facts already stated elsewhere on this page (the
//    hero's "covers your physician, pharmacy, and delivery", the comparison
//    table's insurance/fees/cancellation rows) plus the flat-price-regardless
//    -of-dosage fact called out in the rebuild brief. No new claim invented.
//  - Two closing CTAs stacked back to back (a cta-girl.png banner, then a
//    second "Feel better, starting today" band). Consolidated into the one
//    capsule-drift closing band every other rebuilt page uses.
//  - id="start-assessment" is the anchor public/style/script.js uses to pin
//    a bar to the viewport top on mobile scroll — removed from the footer
//    CTA; every quiz trigger on this page now uses .js-start-quiz instead of
//    the old start-assessment / start-assessment-header / start-full-
//    assessment / start-full-assessment-cta id soup (all fired the same
//    modal open handler anyway).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import QuizModal from '../components/QuizModal.astro';

const plans = [
  {
    img: '/products-imgs/image-18.webp',
    title: 'GLP-1 Weight Loss',
    features: [
      'Compounded GLP-1 receptor agonist',
      'Average 15% body weight loss',
      'Starts as low as $179 on the 24-month plan',
    ],
    price: '$179*',
  },
  {
    img: '/products-imgs/image-19.webp',
    title: 'Sexual Wellness',
    features: [
      'Dissolves under the tongue (Sublingual)',
      'Sildenafil + Tadalafil + Apomorphine',
      'Physician consultation & fast shipping included',
    ],
    price: '$59',
  },
  {
    img: '/products-imgs/image-20.webp',
    title: 'Hair Loss',
    features: [
      'Synergistic 2-in-1 compounded formula',
      'Choose between Oral Pill or Topical Spray',
      'Precision-dosed by licensed physicians',
    ],
    price: '$49',
  },
  {
    img: '/products-imgs/image-21.webp',
    title: 'Longevity & Peptides',
    features: [
      'Sourced from 503A US pharmacies',
      'Customized stack tailored to you',
      'Physician review & expedited cold-shipping',
    ],
    price: '$79',
  },
];

// Comparison table — real distinctive content, kept row-for-row.
const compareRows = [
  { label: 'Board-certified physician oversight', freeley: true, clinics: true, pharmacy: '–', telehealth: 'Varies' },
  { label: 'No in-person visit required', freeley: true, clinics: false, pharmacy: false, telehealth: true },
  { label: 'Compounded medication options', freeley: true, clinics: 'Rarely', pharmacy: false, telehealth: 'Some' },
  { label: 'Monthly price (GLP-1 weight loss)', priceRow: true, freeley: '$179/month', clinics: '$300-500+', pharmacy: 'Varies', telehealth: '$199-$399' },
  { label: 'Free shipping & discreet delivery', freeley: true, clinics: false, pharmacy: 'Varies', telehealth: true },
  { label: 'Compounded GLP-1 availability', freeley: true, clinics: true, pharmacy: true, telehealth: 'Some' },
  { label: 'Insurance not required', freeley: true, clinics: false, pharmacy: 'Varies', telehealth: true },
  { label: 'FSA / HSA eligible', freeley: true, clinics: true, pharmacy: true, telehealth: 'Some' },
  { label: 'No membership or hidden fees', freeley: true, clinics: false, pharmacy: true, telehealth: 'Varies' },
  { label: 'Cancel anytime — no contracts', freeley: true, clinics: 'N/A', pharmacy: 'N/A', telehealth: 'Varies' },
];

const promiseCards = [
  { title: 'Licensed Pharmacy', desc: 'All medications compounded by Strive Pharmacy, a PCAB-accredited, 503A-licensed U.S. pharmacy partner.', img: '/assets/strive.png' },
  { title: 'Physician Prescribed', desc: 'Every treatment is reviewed and prescribed by a board-certified, state-licensed physician.', img: '/assets/pricing/Physician-Prescribed.png' },
  { title: 'Third-Party Tested', desc: 'Every batch tested for potency, sterility, and purity by independent labs before shipping.', img: '/assets/pricing/Third-Party_Tested.png' },
];

// ⚠️ All 4 answers were the identical GLP-1 side-effects paragraph — wrong
// content for a pricing FAQ. Rewritten using only facts already stated
// elsewhere on this page (hero subtitle, comparison table rows) plus the
// flat-price-regardless-of-dosage billing fact called out in the brief.
const faqs = [
  {
    q: "What's included in the monthly price?",
    a: 'One flat monthly rate covers your physician consultation, your prescribed medication compounded at a licensed pharmacy, and delivery to your door — no separate visit fees, no pharmacy markups, no shipping charges.',
  },
  {
    q: 'Are there any signup or cancellation fees?',
    a: "No. There's no membership fee and no hidden fees to sign up, and you can cancel anytime with no contracts.",
  },
  {
    q: 'Is insurance accepted?',
    a: "Freeley doesn't require or bill insurance. You pay one flat monthly price directly, and plans are FSA/HSA eligible if you'd like to use those funds.",
  },
  {
    q: 'Why is the price the same across all dosages?',
    a: "Your monthly price is flat regardless of your prescribed dosage — as your physician titrates your treatment, you won't see a higher bill for a higher dose.",
  },
];
---

<Layout title="Pricing | Freeley">
  <Fragment slot="head">
    <style is:inline>
      /* Design tokens already declared in public/style/style.css :root
         (--green, --cream, --font-serif, …). Everything below is scoped to
         wl- classes so no legacy rule collides. */
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-btn--full { width: 100%; }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }
      .wl-head { max-width: 660px; margin-bottom: 40px; }
      .wl-head--center { margin-left: auto; margin-right: auto; text-align: center; }
      .wl-head h2 { font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.1; margin: 14px 0 12px; }
      .wl-head p { color: var(--muted); font-size: 15px; margin: 0; }

      /* ── Hero ─────────────────────────────────────────────────── */
      .wl-price-hero { background: linear-gradient(180deg, #eef1ec 0%, var(--cream) 100%); padding: 64px 0 44px; text-align: center; }
      .wl-price-hero__inner { max-width: 720px; margin: 0 auto; }
      .wl-price-hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.08; margin: 16px 0 18px; }
      .wl-price-hero p { color: var(--muted); font-size: 16px; max-width: 58ch; margin: 0 auto 28px; }
      .wl-toggle { display: inline-flex; gap: 6px; padding: 5px; background: var(--card); border-radius: 999px; margin-bottom: 30px; }
      .wl-toggle .btn { border: none; background: transparent; border-radius: 999px; padding: 11px 26px; font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--muted); cursor: pointer; transition: background .15s, color .15s; }
      .wl-toggle .btn.active-medication { background: var(--green); color: #fff; }
      .wl-price-hero__trust { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 28px; }
      .wl-price-hero__trust div { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink); }
      .wl-price-hero__trust svg { color: var(--brand); flex: none; }

      /* ── Precision Medicine cards ─────────────────────────────── */
      .wl-plans-grid { display: grid; gap: 20px; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .wl-plans-grid { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1100px) { .wl-plans-grid { grid-template-columns: repeat(4, 1fr); } }
      .wl-plancard { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 22px; display: flex; flex-direction: column; }
      .wl-plancard__img { aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden; background: var(--card); margin-bottom: 18px; display: grid; place-items: center; }
      .wl-plancard__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
      .wl-plancard h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.2rem; margin: 0 0 14px; line-height: 1.2; }
      .wl-plancard ul { list-style: none; margin: 0 0 18px; padding: 0; flex: 1; }
      .wl-plancard li { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 10px; font-size: 13.5px; color: var(--ink); line-height: 1.4; }
      .wl-plancard li svg { flex: none; width: 18px; height: 18px; margin-top: 1px; color: var(--brand); }
      .wl-plancard__price { display: flex; align-items: baseline; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--line); margin-bottom: 16px; }
      .wl-plancard__price .lbl { font-size: 12.5px; color: var(--muted); }
      .wl-plancard__price .amt { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 600; color: var(--gold); }
      .wl-plancard__price .amt small { font-family: var(--font-sans); font-size: 12px; color: var(--muted); font-weight: 500; }
      .wl-plancard__cancel { text-align: center; font-size: 11.5px; color: var(--muted); margin-top: 10px; }
      .wl-plans-foot { max-width: 820px; margin: 34px auto 0; text-align: center; }
      .wl-plans-foot p { font-size: 12px; color: var(--muted); margin: 0 0 8px; line-height: 1.5; }

      /* ── Comparison table ─────────────────────────────────────── */
      .wl-compare-wrap { overflow-x: auto; margin: 0 0 32px; border-radius: 18px; border: 1px solid var(--line); }
      .wl-compare { width: 100%; border-collapse: collapse; min-width: 680px; background: #fff; }
      .wl-compare th, .wl-compare td { padding: 16px 18px; font-size: 13.5px; text-align: center; border-bottom: 1px solid var(--line); }
      .wl-compare thead th { font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); background: var(--card); }
      .wl-compare thead th.hl { color: var(--green); }
      .wl-compare tbody td:first-child, .wl-compare thead th:first-child { text-align: left; font-weight: 600; color: var(--ink); }
      .wl-compare tbody tr:last-child td { border-bottom: none; }
      .wl-compare tbody tr:nth-child(even) td { background: rgba(15,107,69,.03); }
      .wl-compare td.price-cell { font-family: var(--font-serif); font-weight: 600; color: var(--gold); }
      .wl-compare .ico { display: inline-flex; width: 18px; height: 18px; }
      .wl-compare .ico--x { color: #c94a4a; }
      .wl-compare .ico--check { color: var(--brand); }
      .wl-steps-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; margin-top: 28px; }
      .wl-steps-row .step { display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 600; color: var(--ink); }
      .wl-steps-row .step span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: var(--green); color: #fff; font-size: 12px; }

      /* ── Savings calculator ───────────────────────────────────── */
      .wl-calc-panel {
        position: relative; overflow: hidden; border-radius: 28px; padding: 40px 32px;
        background: radial-gradient(120% 140% at 8% -10%, rgba(15,107,69,.10) 0%, rgba(15,107,69,0) 46%), var(--card);
      }
      @media (min-width: 700px) { .wl-calc-panel { padding: 48px; } }
      .wl-calc-grid { position: relative; display: grid; gap: 40px; grid-template-columns: 1fr; }
      @media (min-width: 900px) { .wl-calc-grid { grid-template-columns: 1fr 1fr; align-items: center; } }

      /* Active-treatment chip: icon + label swap with the select. */
      .wl-calc-chip { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px 8px 8px; margin: 28px 0 22px; }
      .wl-calc-chip__icon { flex: none; width: 30px; height: 30px; border-radius: 999px; background: var(--green); display: grid; place-items: center; }
      .wl-calc-chip__icon svg { width: 16px; height: 16px; color: #fff; }
      .wl-calc-chip__icon svg[hidden] { display: none; }
      .wl-calc-chip__label { font-family: var(--font-sans); font-size: 13px; font-weight: 700; color: var(--ink); }

      .wl-calc-form label { display: block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
      .wl-calc-form .field { margin-bottom: 16px; }
      .wl-calc-select { width: 100%; font-family: var(--font-sans); border: 1px solid var(--line); border-radius: 999px; padding: 14px 22px; font-size: 14px; font-weight: 500; color: var(--ink); background: #fff; cursor: pointer; }
      .wl-calc-select:focus { outline: 2px solid var(--brand); outline-offset: 2px; }

      .wl-calc-card { position: relative; background: #fff; border-radius: 22px; padding: 34px 34px 30px; box-shadow: 0 30px 60px -28px rgba(18,60,44,.35); }
      .wl-calc-card__body { position: relative; z-index: 1; }
      .wl-calc-card__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
      .wl-calc-badge { display: inline-block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); background: rgba(15,107,69,.08); border-radius: 999px; padding: 6px 14px; }
      .wl-calc-pct { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-sans); font-size: 12.5px; font-weight: 700; color: #fff; background: var(--brand); border-radius: 999px; padding: 5px 12px; white-space: nowrap; }
      .wl-calc-total { font-family: var(--font-serif); font-size: 2.9rem; font-weight: 600; color: var(--gold); line-height: 1; }
      .wl-calc-duration { font-size: 13.5px; color: var(--muted); margin: 8px 0 4px; }

      /* Savings-over-time chart: cumulative curve from the same monthly-
         savings math — the trend line is mathematically straight (fixed
         savings every month), so the stroke between real data points is
         drawn with a gentle wave instead of straight segments; the points
         themselves (and what a click reveals) stay exactly on the real
         numbers. Redrawn with a stroke "draw-in" animation on every
         recalculation. */
      .wl-calc-chart { position: relative; margin: 8px 0 18px; }
      .wl-calc-chart svg { display: block; width: 100%; height: 84px; overflow: visible; }
      .wl-calc-chart__grid { stroke: var(--line); stroke-width: 1; }
      .wl-calc-chart__area { fill: url(#wlCalcSavingsFill); opacity: 0; transition: opacity .5s ease .1s; }
      .wl-calc-chart__area.is-in { opacity: 1; }
      .wl-calc-chart__line { fill: none; stroke: var(--brand); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
      .wl-calc-chart__hit { fill: transparent; cursor: pointer; }
      .wl-calc-chart__dot { stroke: #fff; stroke-width: 2; fill: var(--brand); pointer-events: none; transition: r .15s ease; opacity: 0; transform: scale(0); transform-box: fill-box; transform-origin: center; transition: opacity .3s ease, transform .3s ease, r .15s ease; }
      .wl-calc-chart__dot.is-in { opacity: 1; transform: scale(1); }
      .wl-calc-chart__hit:hover + .wl-calc-chart__dot { r: 6; }
      .wl-calc-chart__labels { display: flex; justify-content: space-between; margin-top: 4px; }
      .wl-calc-chart__labels span { font-family: var(--font-condensed); font-size: 10.5px; color: var(--muted); }
      .wl-calc-chart__tooltip {
        position: absolute; transform: translate(-50%, calc(-100% - 12px));
        background: var(--green-deep); color: #fff; border-radius: 10px; padding: 7px 11px;
        font-family: var(--font-sans); font-size: 12px; font-weight: 600; white-space: nowrap;
        pointer-events: none; box-shadow: 0 8px 18px rgba(13,49,34,.28);
        transition: left .3s cubic-bezier(.22,.61,.36,1), top .3s cubic-bezier(.22,.61,.36,1);
      }
      .wl-calc-chart__tooltip b { display: block; font-family: var(--font-condensed); font-size: 9.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.65); margin-bottom: 1px; }
      .wl-calc-chart__tooltip::after {
        content: ''; position: absolute; left: 50%; top: 100%; transform: translateX(-50%);
        border: 5px solid transparent; border-top-color: var(--green-deep);
      }

      .wl-calc-compare { display: flex; flex-direction: column; gap: 12px; margin: 18px 0 20px; padding-top: 18px; border-top: 1px solid var(--line); }
      .wl-calc-compare__row { display: grid; grid-template-columns: 78px 1fr 78px; align-items: center; gap: 10px; }
      .wl-calc-compare__label { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      .wl-calc-compare__track { position: relative; height: 9px; border-radius: 999px; background: #f1ede3; overflow: hidden; }
      .wl-calc-compare__fill { position: absolute; inset: 0; border-radius: 999px; transition: width .5s cubic-bezier(.22,.61,.36,1); }
      .wl-calc-compare__fill--theirs { background: #cbb9a0; }
      .wl-calc-compare__fill--freeley { background: var(--brand); }
      .wl-calc-compare__value { font-family: var(--font-sans); font-size: 13px; font-weight: 700; color: var(--ink); text-align: right; }

      .wl-calc-savingsrow { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .wl-calc-savingsrow__label { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink); font-weight: 600; }
      .wl-calc-tick { flex: none; width: 20px; height: 20px; border-radius: 999px; background: var(--brand); display: grid; place-items: center; }
      .wl-calc-savingsrow__value { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600; color: var(--brand); }

      /* ── Freeley Promise ──────────────────────────────────────── */
      .wl-promise-grid { display: grid; gap: 28px; grid-template-columns: 1fr; }
      @media (min-width: 1000px) { .wl-promise-grid { grid-template-columns: 0.9fr repeat(3, 1fr); } }
      .wl-promise-lede p { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 14px 0 26px; max-width: 40ch; }
      .wl-legit { display: flex; align-items: center; gap: 14px; }
      .wl-legit img { width: 56px; height: auto; }
      .wl-legit span { font-family: var(--font-sans); font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--ink); }
      .wl-promise-card { position: relative; border-radius: 18px; overflow: hidden; min-height: 300px; background: var(--card); display: flex; align-items: flex-end; padding: 24px; }
      .wl-promise-card__bg { position: absolute; inset: 0; background-repeat: no-repeat; background-position: center 15px; }
      .wl-promise-card__body { position: relative; z-index: 1; }
      .wl-promise-card h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.15rem; margin: 0 0 10px; }
      .wl-promise-card p { font-size: 13px; color: var(--muted); margin: 0; line-height: 1.5; }

      /* ── FAQ (same pattern as every other rebuilt page) ───────── */
      .wl-faqs { max-width: 780px; margin: 0 auto; }
      .faq-item { border-bottom: 1px solid var(--line); }
      .faq-question { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; cursor: pointer; }
      .faq-question-text { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
      .faq-toggle-icon { flex: none; color: var(--green); transition: transform .25s ease; }
      .faq-item.open .faq-toggle-icon { transform: rotate(180deg); }
      .faq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease; }
      .faq-item.open .faq-answer { grid-template-rows: 1fr; }
      .faq-answer > div { overflow: hidden; }
      .faq-answer p { font-size: 14.5px; color: var(--muted); margin: 0 0 22px; max-width: 62ch; line-height: 1.6; }
      .wl-page .faq-question-text { color: var(--ink); }
      .wl-page .faq-item { background: transparent; border-radius: 0; }
      .wl-page .faq-item.open .faq-answer { display: grid; }
      .wl-page .faq-answer { padding: 0; margin-top: 0; }
      .wl-page .faq-answer p { font-family: var(--font-sans); }

      /* ── Motion, gated exactly as /prototype gates it ─────────── */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .wl-plancard, .wl-promise-card { animation: wlRise linear both; animation-timeline: view(); animation-range: entry 6% cover 24%; }
          @keyframes wlRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
        }
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .wl-plancard { transition: translate .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease; }
        .wl-plancard:hover { translate: 0 -6px; box-shadow: 0 20px 40px rgba(23,34,42,.14); }
      }

    </style>
  </Fragment>

  <main class="wl-page">
    <Header />

    <!-- ═══ Hero ═══ -->
    <section class="wl-price-hero">
      <div class="wl-wrap wl-price-hero__inner">
        <span class="wl-eyebrow">Pricing</span>
        <h1 class="wl-serif">Simple, <em>transparent</em><br />pricing</h1>
