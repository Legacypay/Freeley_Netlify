  <script is:inline>
    // ===================== SAVINGS CALCULATOR =====================
    document.addEventListener('DOMContentLoaded', function () {
      const SVG_NS = 'http://www.w3.org/2000/svg';
      const treatmentSelect = document.getElementById('treatmentSelect');
      const compareSelect = document.getElementById('compareSelect');
      const durationSelect = document.getElementById('durationSelect');
      const totalSavingsDisplay = document.getElementById('totalSavingsDisplay');
      const durationLabel = document.getElementById('durationLabel');
      const theirPriceDisplay = document.getElementById('theirPriceDisplay');
      const freeleyPriceDisplay = document.getElementById('freeleyPriceDisplay');
      const monthlySavingsDisplay = document.getElementById('monthlySavingsDisplay');
      const savingsPctDisplay = document.getElementById('savingsPctDisplay');
      const chipLabel = document.getElementById('wlCalcChipLabel');
      const monthEndLabel = document.getElementById('wlCalcMonthEndLabel');
      const theirBar = document.getElementById('wlCalcTheirBar');
      const freeleyBar = document.getElementById('wlCalcFreeleyBar');
      const areaPath = document.getElementById('wlCalcArea');
      const linePath = document.getElementById('wlCalcLine');
      const pointsGroup = document.getElementById('wlCalcPoints');
      const tooltip = document.getElementById('wlCalcTooltip');
      const tooltipMonth = document.getElementById('wlCalcTooltipMonth');
      const tooltipValue = document.getElementById('wlCalcTooltipValue');
      const chipIcons = {
        '179': document.getElementById('wlCalcIconGLP1'),
        '59': document.getElementById('wlCalcIconSexual'),
        '49': document.getElementById('wlCalcIconHair'),
        '79': document.getElementById('wlCalcIconLongevity'),
      };
      const chipLabels = {
        '179': 'GLP-1 Weight Loss', '59': 'Sexual Wellness', '49': 'Hair Loss', '79': 'Longevity & Peptides',
      };

      let activeMonth = null; // null = default to the last month (the running total)

      function animateNumber(element, target, prefix = '$', suffix = '') {
        const start = 0;
        const duration = 600;
        const startTime = performance.now();

        function update(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = start + (target - start) * eased;
          element.textContent = prefix + current.toFixed(2) + suffix;
          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            element.textContent = prefix + target.toFixed(2) + suffix;
          }
        }
        requestAnimationFrame(update);
      }

      // Draws an SVG <path> stroke left-to-right via stroke-dasharray, so
      // every recalculation redraws the line instead of just popping in.
      function drawIn(path) {
        const len = path.getTotalLength();
        path.style.transition = 'none';
        path.style.strokeDasharray = len;
        path.style.strokeDashoffset = len;
        path.getBoundingClientRect(); // force reflow
        path.style.transition = 'stroke-dashoffset .6s cubic-bezier(.22,.61,.36,1)';
        path.style.strokeDashoffset = '0';
      }

      function updateTooltip(pts, idx) {
        const p = pts[idx];
        tooltipMonth.textContent = idx === 0 ? 'Today' : 'Month ' + idx;
        const leftPct = Math.min(90, Math.max(10, p.x / 300 * 100));
        tooltip.style.left = leftPct + '%';
        tooltip.style.top = p.y + 'px';
        animateNumber(tooltipValue, p.cum, '$', '');
      }

      function updateCalculator() {
        const freeleyMonthly = parseFloat(treatmentSelect.value);
        const comparePrice = parseFloat(compareSelect.options[compareSelect.selectedIndex].dataset.price);
        const months = parseInt(durationSelect.value, 10);

        const monthlySavings = comparePrice - freeleyMonthly;
        const totalSavings = monthlySavings * months;
        const savingsPct = Math.round((monthlySavings / comparePrice) * 100);
        const maxPrice = Math.max(comparePrice, freeleyMonthly);

        animateNumber(totalSavingsDisplay, totalSavings, '$', '');
        durationLabel.textContent = `Over ${months} months`;
        theirPriceDisplay.textContent = `$${comparePrice.toFixed(2)}/mo`;
        freeleyPriceDisplay.textContent = `$${freeleyMonthly.toFixed(2)}/mo`;
        animateNumber(monthlySavingsDisplay, monthlySavings, '$', '/mo');
        savingsPctDisplay.textContent = `Save ${savingsPct}%`;
        monthEndLabel.textContent = `Month ${months}`;
        theirBar.style.width = Math.round((comparePrice / maxPrice) * 100) + '%';
        freeleyBar.style.width = Math.round((freeleyMonthly / maxPrice) * 100) + '%';

        Object.entries(chipIcons).forEach(([val, el]) => { el.hidden = val !== treatmentSelect.value; });
        chipLabel.textContent = chipLabels[treatmentSelect.value];

        // Cumulative savings curve — the trend is mathematically a
        // straight line (fixed savings every month), so connecting the
        // real data points with a gentle wave (instead of straight
        // segments) reads far less flat. Every point stays exactly on
        // its real value; only the stroke between them undulates.
        const w = 300, topPad = 8, bottomY = 74;
        const pts = [];
        for (let i = 0; i <= months; i++) {
          const cum = monthlySavings * i;
          const x = (i / months) * w;
          const y = totalSavings > 0 ? (bottomY - (cum / totalSavings) * (bottomY - topPad)) : bottomY;
          pts.push({ x, y, cum, month: i });
        }
        const waveAmp = 7;
        let line = 'M' + pts[0].x.toFixed(1) + ',' + pts[0].y.toFixed(1);
        for (let s = 0; s < pts.length - 1; s++) {
          const sp1 = pts[s], sp2 = pts[s + 1];
          const wave = (s % 2 === 0 ? -1 : 1) * waveAmp;
          const cx1 = sp1.x + (sp2.x - sp1.x) * 0.35, cy1 = sp1.y + wave;
          const cx2 = sp1.x + (sp2.x - sp1.x) * 0.65, cy2 = sp2.y + wave;
          line += ` C${cx1.toFixed(1)},${cy1.toFixed(1)} ${cx2.toFixed(1)},${cy2.toFixed(1)} ${sp2.x.toFixed(1)},${sp2.y.toFixed(1)}`;
        }
        const area = line + ` L${pts[pts.length - 1].x.toFixed(1)},${bottomY} L0,${bottomY} Z`;

        linePath.setAttribute('d', line);
        areaPath.setAttribute('d', area);
        drawIn(linePath);
        areaPath.classList.remove('is-in');
        void areaPath.getBoundingClientRect();
        areaPath.classList.add('is-in');

        // Clamp the active month (switching duration can leave a stale
        // index) and default to the last point — the running total.
        if (activeMonth === null || activeMonth > months) activeMonth = months;

        pointsGroup.innerHTML = '';
        pts.forEach((p) => {
          const isActive = p.month === activeMonth;
          const hit = document.createElementNS(SVG_NS, 'circle');
          hit.setAttribute('class', 'wl-calc-chart__hit');
          hit.setAttribute('r', '10');
          hit.setAttribute('cx', p.x.toFixed(1));
          hit.setAttribute('cy', p.y.toFixed(1));
          hit.addEventListener('click', () => {
            activeMonth = p.month;
            updateTooltip(pts, activeMonth);
            pointsGroup.querySelectorAll('.wl-calc-chart__dot').forEach((d, i) => {
              const active = i === activeMonth;
              d.setAttribute('r', active ? '6' : '3.5');
              d.setAttribute('fill', active ? '#c39a4e' : '#0f6b45');
            });
          });

          const dot = document.createElementNS(SVG_NS, 'circle');
          dot.setAttribute('class', 'wl-calc-chart__dot');
          dot.setAttribute('r', isActive ? '6' : '3.5');
          dot.setAttribute('cx', p.x.toFixed(1));
          dot.setAttribute('cy', p.y.toFixed(1));
          dot.setAttribute('fill', isActive ? '#c39a4e' : '#0f6b45');

          pointsGroup.appendChild(hit);
          pointsGroup.appendChild(dot);
          requestAnimationFrame(() => dot.classList.add('is-in'));
        });

        updateTooltip(pts, activeMonth);
      }

      treatmentSelect.addEventListener('change', updateCalculator);
      compareSelect.addEventListener('change', updateCalculator);
      durationSelect.addEventListener('change', () => { activeMonth = null; updateCalculator(); });

      updateCalculator();

      // Billing-frequency toggle pills — visual only, no page state depends on it.
      const toggleButtons = document.querySelectorAll('.wl-toggle .btn');
      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          toggleButtons.forEach((btn) => btn.classList.remove('active-medication'));
          button.classList.add('active-medication');
        });
      });
    });
  </script>

  <script src="/style/script.js" is:inline></script>
