---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Pricing" bodyClass="pricing">
  <Fragment slot="head">
    <!-- Font playfair display embed -->
    <link rel="stylesheet" href="/style/pricestyle.css" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js" is:inline></script>
  </Fragment>

    <main>
        <!-- Header -->
        <Header />
        <section class="hero-section text-center" style="margin-top: -93px;">
            <div class="container">
                <div class="bordered--heading inline-block px-4 mb-4">
                    <span class="uppercase">Pricing</span>
                </div>
                <h1 class="hero-title mt-4" data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000">Simple, <span>transparent</span><br>pricing</h1>
                <p class="hero-subtitle mx-auto mt-6" data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000">
                    No hidden fees. No insurance required. FSA/HSA accepted. One flat monthly rate that covers your physician, pharmacy, and delivery.
                </p>
                <div class="inline-flex p-2 rounded-full bg-gray-100 gap-2 mb-4 medication-toggle">
                    <button class="btn rounded-full text-white flex-1 active-medication">
                    Monthly
                  </button>

                    <button class="btn rounded-full bg-transparent border-0 flex-1">
                    Quarterly
                  </button>
                </div>
                <div class="hero_footer">
                    <div class="sec1-div">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z" fill="#004C27" />
                        </svg>
                        <span class=" mb-0">Zero Hidden Fees</span>
                    </div>
                    <div class="sec1-div">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z" fill="#004C27" />
                        </svg>
                        <span class=" mb-0">Cancel Anytime</span>
                    </div>
                    <div class="sec1-div">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 1.5C4.8675 1.5 1.5 4.8675 1.5 9C1.5 13.1325 4.8675 16.5 9 16.5C13.1325 16.5 16.5 13.1325 16.5 9C16.5 4.8675 13.1325 1.5 9 1.5ZM12.585 7.275L8.3325 11.5275C8.2275 11.6325 8.085 11.6925 7.935 11.6925C7.785 11.6925 7.6425 11.6325 7.5375 11.5275L5.415 9.405C5.1975 9.1875 5.1975 8.8275 5.415 8.61C5.6325 8.3925 5.9925 8.3925 6.21 8.61L7.935 10.335L11.79 6.48C12.0075 6.2625 12.3675 6.2625 12.585 6.48C12.8025 6.6975 12.8025 7.05 12.585 7.275Z" fill="#004C27" />
                        </svg>
                        <span class="mb-0">FSA / HSA Accepted</span>
                    </div>
                </div>
            </div>
        </section>
        <br>

        <section>
            <div id="quiz--modal" class="modal">
                <div class="modal-content">
                    <span class="close" id="close--quiz"><img src="/assets/icons/close.png" /></span>
                    <div class="processing-loader" id="loader"></div>
                    <div id="quiz--container"></div>
                </div>
            </div>
        </section>


        <!-- Precision Medicine Cards -->
        <section class="precision-medicine pb-12 md-pb-0">
            <div class="container">
                <div class="medicine-grid">
                    <!-- Card 1 -->
                    <div class="medicine-card" data-aos="zoom-in">
                        <div class="product-image">
                            <img src="/products-imgs/image-18.png" alt="GLP-1 Weight Loss">
                        </div>
                        <h3>GLP-1 Weight Loss</h3>
                        <ul class="feature-list mb-4">
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Compounded GLP-1 receptor agonist
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Average 15% body weight loss
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Starts as low as $99.29 for month one
                            </li>
                        </ul>
                        <div class="price flex justify-between">
                            <div class="text-14-inter dark">Starting at </div>
                            <div><span>$99*</span><small class="text-14-inter">/month</small></div>
                        </div>
                        <a href="javascript:void(0)" class="global--qua--button w-full">
                            <img class="btn--icon" src="/assets/icons/arrow-right.svg" /> See if you Quality
                        </a>
                        <div class="cancel-text">Cancel Anytime</div>
                    </div>
                    <!-- Card 2 -->
                    <div class="medicine-card" data-aos="zoom-in">
                        <div class="product-image">
                            <img src="/products-imgs/image-19.png" alt="Sexual Wellness">
                        </div>
                        <h3>Sexual Wellness</h3>
                        <ul class="feature-list mb-4">
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Dissolves under the tongue (Sublingual)
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Sildenafil + Tadalafil + Apomorphine
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Physician consultation &amp; fast shipping included
                            </li>
                        </ul>
                        <div class="price flex justify-between">
                            <div class="text-14-inter dark">Starting at </div>
                            <div><span>$59</span><small class="text-14-inter">/month</small></div>
                        </div>
                        <a href="javascript:void(0)" class="global--qua--button w-full">
                            <img class="btn--icon" src="/assets/icons/arrow-right.svg" /> See if you Quality
                        </a>
                        <div class="cancel-text">Cancel Anytime</div>
                    </div>
                    <!-- Card 3 -->
                    <div class="medicine-card" data-aos="zoom-in">
                        <div class="product-image">
                            <img src="/products-imgs/image-20.png" alt="Hair Loss">
                        </div>
                        <h3>Hair Loss</h3>
                        <ul class="feature-list mb-4">
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Synergistic 2-in-1 compounded formula
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Choose between Oral Pill or Topical Spray
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Precision-dosed by licensed physicians
                            </li>
                        </ul>
                        <div class="price flex justify-between">
                            <div class="text-14-inter dark">Starting at </div>
                            <div><span>$29</span><small class="text-14-inter">/month</small></div>
                        </div>
                        <a href="javascript:void(0)" class="global--qua--button w-full">
                            <img class="btn--icon" src="/assets/icons/arrow-right.svg" /> See if you Quality
                        </a>
                        <div class="cancel-text">Cancel Anytime</div>
                    </div>
                    <!-- Card 4 -->
                    <div class="medicine-card" data-aos="zoom-in">
                        <div class="product-image">
                            <img src="/products-imgs/image-21.png" alt="Longevity & Peptides">
                        </div>
                        <h3>Longevity & Peptides</h3>
                        <ul class="feature-list mb-4">
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Sourced from 503A US pharmacies
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Customized stack tailored to you
                            </li>
                            <li>
                                <span class="list-icon"><svg viewBox="0 0 24 24">
                      <path d="M9.5 15.5L5.8 11.8L4.4 13.2L9.5 18.3L19.6 8.2L18.2 6.8Z"></path></svg></span>Physician review &amp; expedited cold-shipping
                            </li>
                        </ul>
                        <div class="price flex justify-between">
                            <div class="text-14-inter dark">Starting at </div>
                            <div><span>$99</span><small class="text-14-inter">/month</small></div>
                        </div>
                        <a href="javascript:void(0)" class="global--qua--button w-full">
                            <img class="btn--icon" src="/assets/icons/arrow-right.svg" /> See if you Quality
                        </a>
                        <div class="cancel-text">Cancel Anytime</div>
                    </div>
                </div>
                <div class="medicine-footer-note">
                    <p>
                        *Price reflects the 12-month plan. 1-, 3-, and 6-month plan lengths available at higher monthly rates. See checkout for full pricing.
                    </p>
                    <p>
                        Freely does not manufacture compounded medications. Actual product appearance and labeling of the medication you receive will differ from website images.
                    </p>
                </div>
            </div>
        </section>
        <!-- Why Patience Switch -->
        <section class="comparison-section">
            <div class="container text-left md:text-center">
                <div class="comparison-header">
                    <div class="bordered--heading inline-block px-4 mb-4">
                        <span class="uppercase">THE DIFFERENCE</span>
                    </div>
                    <div class="section--title">
                        <h2>
                            Why patients choose<br><em><span class="highlight">Freeley</span></em>
                        </h2>
                    </div>
                    <p>
                        See how we compare to traditional clinics and other telehealth providers.
                    </p>
                </div>
                <div class="comparison-table-wrap">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="highlighted">Freeley</th>
                                <th>Traditional Clinics</th>
                                <th>Retail Pharmacy</th>
                                <th>Other Telehealth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="light-row">
                                <td>Board-certified physician oversight</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>–</td>
                                <td>Varies</td>
                            </tr>
                            <tr class="dark-row">
                                <td>No in-person visit required</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                            </tr>
                            <tr class="light-row">
                                <td>Compounded medication options</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>Rarely</td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td>Some</td>
                            </tr>
                            <tr class="dark-row">
                                <td>Monthly price (GLP-1 weight loss)</td>
                                <td class="price-cell">$99/month</td>
                                <td>$300-500+</td>
                                <td>Varies</td>
                                <td>$199-$399</td>
                            </tr>
                            <tr class="light-row">
                                <td>Free shipping & discreet delivery</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td>Varies</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                            </tr>
                            <tr class="dark-row">
                                <td>Compounded GLP-1 availability</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>Some</td>
                            </tr>
                            <tr class="light-row">
                                <td>Insurance not required</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td>Varies</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                            </tr>
                            <tr class="dark-row">
                                <td>FSA / HSA eligible</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>Some</td>
                            </tr>
                            <tr class="light-row">
                                <td>No membership or hidden fees</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td><span class="icon-cross"><img src="/assets/icons/table-cross.svg" /></span></td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>Varies</td>
                            </tr>
                            <tr class="dark-row">
                                <td>Cancel anytime — no contracts</td>
                                <td><span class="icon-check"><img src="/assets/icons/table-check.svg" /></span></td>
                                <td>N/A</td>
                                <td>N/A</td>
                                <td>Varies</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="javascript:void(0)" id="start-full-assessment" class="global--qua--button mt-12 md:mt-0"><img class="btn--icon" src="/assets/icons/arrow-right.svg" />Start Your Assessment</a>
                <div class="steps-row">
                    <div class="step-item"><span>1</span>2 Minute Intake</div>
                    <div class="step-item"><span>2</span>Physician Reviewed</div>
                    <div class="step-item"><span>3</span>Delivered in 48hrs</div>
                </div>
            </div>
        </section>
        <!-- SECTION 1: SAVINGS CALCULATOR (UPDATED) -->
        <section class="calculator-section py-12">
            <div class="container custom-container  rounded-[2rem] p-6 md:p-12">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- Left Control Form Panel -->
                    <div class="lg:col-span-6">
                        <div class="bordered--heading inline-block px-4">
                            <span class="uppercase">SAVINGS CALCULATOR</span>
                        </div>
                        <h2 class="section-title mb-4 mt-4">See how much <br><span class="italic-gold">you'll save</span></h2>
                        <form class="calc-form mt-12">
                            <div class="mb-4" data-aos="fade-up" data-aos-delay="200">
                                <label class="text-12 mb-4">TREATMENT</label>
                                <select class="form-select custom-select" id="treatmentSelect">
                                    <!-- UPDATED: Products from the page -->
                                    <option value="99" data-freeley="99">GLP-1 Weight Loss</option>
                                    <option value="59" data-freeley="59">Sexual Wellness</option>
                                    <option value="29" data-freeley="29">Hair Loss</option>
                                    <option value="99" data-freeley="99">Longevity & Peptides</option>
                                </select>
                            </div>
                            <div class="mb-4" data-aos="fade-up" data-aos-delay="200">
                                <label class="text-12 mb-4">COMPARED TO</label>
                                <select class="form-select custom-select" id="compareSelect">
                                    <option value="traditional" data-price="1000.00">Traditional Rx</option>
                                    <option value="competitor" data-price="650.00">Other Online Programs</option>
                                </select>
                            </div>
                            <div class="mb-4" data-aos="fade-up" data-aos-delay="200">
                                <label class="text-12 mb-4">DURATION</label>
                                <select class="form-select custom-select" id="durationSelect">
                                    <option value="3">3 Months</option>
                                    <option value="6" selected>6 Months</option>
                                    <option value="12">12 Months</option>
                                </select>
                            </div>
                        </form>
                    </div>
                    <!-- Right Output Statement Panel -->
                    <div class="lg:col-span-6" data-aos="fade-out" data-aos-delay="200">
                        <div class="calc-card position-relative overflow-hidden">
                            <!-- Subtle Background Decorative Currency Glyph -->
                            <div class="bg-currency-symbol">
