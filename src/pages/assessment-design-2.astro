---
import '../styles/tailwind.css';
---
<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/global.css" />
    <link rel="stylesheet" href="/style/style.css" />
    <link rel="stylesheet" href="/style/quiz2style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <title>Freeley Assessment</title>

</head>

<body>
    <div class="quiz-popup">
        <div class="quiz-card">
            <!-- Step 0 - Hero with equal 50/50 columns -->
            <div class="quiz-step active" data-step="0">
                <div class="step--content">
                    <div class="hero-with-image">
                        <div class="step-image-col flex-col text-center">

                            <span class="quiz-badge">MULTI STEP</span>
                            <div class="quiz-hero-content">
                                <h2>
                                    Start Your
                                    <span>Assessment</span>
                                </h2>
                            </div>

                        </div>
                        <div class="step-content-col">
                            <div class="logo-image">
                                <img src="/assets/mask-group5@2x.png" />
                            </div>
                            <div class="quiz-content">
                                <span class="quiz-badge quiz-badge-light"> FREE ASSESSMENT </span>
                                <h2 class="quiz-title">
                                    Let's see if Freeley
                                    <span class="highlight">Is right for you</span>
                                </h2>
                                <p class="quiz-subtitle">
                                    2 minutes. No commitment. • Free if you don't qualify.
                                </p>
                                <div class="features-grid">
                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.3 7.3L9 18.6L3.7 13.3" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                                        </div>
                                        <span class="feature-text">HIPAA Protected</span>
                                    </div>
                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.3 7.3L9 18.6L3.7 13.3" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                                        </div>
                                        <span class="feature-text">Reviewed by physicians</span>
                                    </div>
                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.3 7.3L9 18.6L3.7 13.3" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                                        </div>
                                        <span class="feature-text">Results in 24 hrs</span>
                                    </div>
                                </div>
                                <button class="quiz-start-btn" onclick="goToStep(1)">
                Start
                <span>
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.8223 4.44922L15.3748 9.00172L10.8223 13.5542" stroke="#FAF8F4" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M2.625 9H15.2475" stroke="#FAF8F4" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- Step 1 with equal 50/50 columns -->
            <div class="quiz-step" data-step="1">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>
                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(0)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">1/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:8%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        What brings you
                                        <span class="highlight">to Freeley?</span>
                                    </h2>
                                    <div class="options" data-required="true" data-single-select="true">
                                        <div class="option--item">
                                            <div class="option--title">Weight loss</div>
                                            <div class="option-details italic">GLP-1 medications, supervised</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">Sexual wellness</div>
                                            <div class="option-details italic">Performance, stamina, confidence</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">Hair loss</div>
                                            <div class="option-details italic">Prevent thinning, stimulate regrowth</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">Longevity & performance</div>
                                            <div class="option-details italic">Peptides, NAD+, anti-aging</div>
                                        </div>
                                    </div>
                                    <div class="error-message">Please select an option to continue</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateSelectionAndGo(1, 2)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="quiz-step" data-step="2">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>

                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(1)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">2/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:16%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        What's your biggest
                                        <span class="highlight">Obstacle?</span>
                                    </h2>
                                    <div class="options" data-required="true" data-single-select="true">
                                        <div class="option--item">
                                            <div class="option--title">Cravings & hunger</div>
                                            <div class="option-details italic">Hard to stop eating even when full</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">Slow metabolism</div>
                                            <div class="option-details italic">Weight doesn't move even with effort</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">No time</div>
                                            <div class="option-details italic">Too busy for meal prep or workouts</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">Low motivation</div>
                                            <div class="option-details italic">Hard to stay consistent long-term</div>
                                        </div>
                                    </div>
                                    <div class="error-message">Please select an option to continue</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateSelectionAndGo(2, 3)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="quiz-step" data-step="3">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>

                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(2)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">3/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:25%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        How quickly do you hope
                                        <span class="highlight">see results?</span>
                                    </h2>
                                    <div class="options" data-required="true" data-single-select="true">
                                        <div class="option--item">
                                            <div class="option--title">As fast as possible</div>
                                            <div class="option-details italic">I'm ready to commit fully</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">1–3 months</div>
                                            <div class="option-details italic">Steady, sustainable progress</div>
                                        </div>
                                        <div class="option--item">
                                            <div class="option--title">No rush</div>
                                            <div class="option-details italic">I want to do this the right way</div>
                                        </div>
                                    </div>
                                    <div class="error-message">Please select an option to continue</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateSelectionAndGo(3, 4)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="quiz-step" data-step="4">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>

                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(3)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">4/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:33%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        How old
                                        <span class="highlight">are you?</span>
                                    </h2>
                                    <p class="mb-12">Your age helps us tailor dosing recommendations.</p>
                                    <div class="text--input">
                                        <input type="number" name="age" placeholder="e.g. 34" id="ageInput" required min="18" max="100" />
                                    </div>
                                    <div class="error-message" id="ageError">Please enter a valid age (18-100)</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateAndGo(4, 5)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 5 -->
            <div class="quiz-step" data-step="5">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>
                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(4)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">5/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:41%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        What's your
                                        <span class="highlight">biological sex?</span>
                                    </h2>
                                    <p class="mb-12">Used only for clinical screening purposes.</p>
                                    <div class="options flex text-center gap-2" data-required="true" data-single-select="true">
                                        <div class="option--item mb-0 flex-1">
                                            <div class="option--title">Male</div>
                                            <div class="option-details italic">
                                                <svg width="41" height="41" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M38.852 0H26.708C25.476 0 24.508 0.968 24.508 2.2C24.508 3.432 25.476 4.4 26.708 4.4H33.484L25.388 12.496C19.14 7.832 10.252 8.272 4.62 13.904C-1.54 20.064 -1.54 30.184 4.62 36.344C10.78 42.504 20.9 42.504 27.06 36.344C32.692 30.712 33.22 21.736 28.468 15.576L36.564 7.48V14.344C36.564 15.576 37.532 16.544 38.764 16.544C39.996 16.544 40.964 15.576 40.964 14.344V2.2C41.052 0.968 40.084 0 38.852 0ZM24.068 33.264C19.58 37.752 12.276 37.752 7.788 33.264C3.3 28.776 3.3 21.472 7.788 16.984C12.276 12.496 19.58 12.496 24.068 16.984C28.556 21.472 28.556 28.776 24.068 33.264Z" fill="#008262"/>
                          </svg>
                                            </div>
                                        </div>
                                        <div class="option--item mb-0 flex-1">
                                            <div class="option--title">Female</div>
                                            <div class="option-details italic">
                                                <svg width="30" height="44" viewBox="0 0 30 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M24.9446 24.9368C30.6435 19.2397 30.6435 9.96991 24.9446 4.27286C19.2457 -1.42429 9.97309 -1.42429 4.27415 4.27286C-1.42471 9.96991 -1.42471 19.2397 4.27415 24.9368C6.68641 27.3483 9.739 28.7387 12.8897 29.1087V34.0005H9.45068C8.50098 34.0005 7.73115 34.7702 7.73115 35.7195C7.73115 36.6689 8.50098 37.4385 9.45068 37.4385H12.8897V42.2809C12.8898 43.2303 13.6596 44 14.6094 44C15.5591 44 16.3289 43.2303 16.3289 42.2809V37.4385H19.7681C20.7178 37.4385 21.4876 36.6689 21.4876 35.7195C21.4876 34.7702 20.7178 34.0005 19.7681 34.0005H16.3289V29.1088C19.4798 28.7387 22.5323 27.3483 24.9446 24.9368ZM6.706 22.5057C2.34803 18.1491 2.34803 11.0605 6.706 6.70386C11.0639 2.34743 18.1547 2.34717 22.5128 6.70386C26.8708 11.0605 26.8708 18.1491 22.5128 22.5057C18.1549 26.8622 11.064 26.8622 6.706 22.5057Z" fill="#008262"/>
                          </svg>
                                            </div>
                                        </div>
                                        <div class="option--item mb-0 flex-1">
                                            <div class="option--title"><small>Prefer not to say</small></div>
                                            <div class="option-details italic">
                                                <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M34.7122 0V2.69388H37.751L31.8228 8.31497C29.7241 6.16739 26.7977 4.83192 23.5649 4.83192C19.2162 4.83192 15.4216 7.2478 13.4512 10.8076C13.2824 10.8002 13.1128 10.7957 12.9421 10.7957C6.57257 10.7957 1.39062 15.9777 1.39062 22.3473C1.39062 28.2611 5.858 33.1505 11.5951 33.8198V37.3997H7.56231V40.0935H11.5953V44H14.2892V40.0935H18.4981V37.3996H14.2892V33.8197C18.0659 33.3791 21.292 31.1098 23.0559 27.923C23.2247 27.9304 23.3942 27.9348 23.5648 27.9348C29.9344 27.9348 35.1164 22.7529 35.1164 16.3834C35.1164 14.2189 34.5175 12.1919 33.4775 10.4585L39.9158 4.35368V7.69948H42.6097V0H34.7122ZM12.9423 31.2048C8.05817 31.2048 4.08468 27.2313 4.08468 22.3471C4.08468 17.6533 7.75464 13.8013 12.3757 13.5082C12.1393 14.4277 12.0134 15.3911 12.0134 16.3834C12.0134 21.5795 15.4623 25.9848 20.191 27.4317C18.5869 29.7119 15.9358 31.2048 12.9423 31.2048ZM21.4025 24.9734C17.5603 24.0058 14.7074 20.5217 14.7074 16.3834C14.7074 15.4694 14.8466 14.5872 15.1049 13.757C18.9471 14.7247 21.7999 18.2089 21.7999 22.3472C21.7999 23.2612 21.6606 24.1433 21.4025 24.9734ZM24.1316 25.2222C24.368 24.3027 24.4938 23.3394 24.4938 22.3471C24.4938 17.151 21.045 12.7456 16.3163 11.2987C17.9204 9.01863 20.5716 7.52563 23.5651 7.52563C28.4493 7.52563 32.4227 11.4991 32.4227 16.3833C32.4226 21.0771 28.7526 24.9292 24.1316 25.2222Z" fill="#008262"/>
                          </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="error-message">Please select an option to continue</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateSelectionAndGo(5, 6)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 6 -->
            <div class="quiz-step" data-step="6">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>
                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(5)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">6/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:50%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        What's your
                                        <span class="highlight">height?</span>
                                    </h2>
                                    <p class="mb-12">Used to calculate your BMI and medication dosing.</p>
                                    <div class="text--input">
                                        <input type="text" name="height" placeholder="e.g. 5.9" id="heightInput" required />
                                    </div>
                                    <div class="error-message" id="heightError">Please enter your height (e.g., 5.9)</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateAndGo(6, 7)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 7 -->
            <div class="quiz-step" data-step="7">
                <div class="step--content">
                    <div class="step-with-image">
                        <div class="step-image-col">
                            <h2 class="step--text text-white">Give $50, Get $50</h2>
                            <p>Share Freeley with a friend. When they start their plan, you both save $50 on your next month.</p>
                        </div>
                        <div class="step-content-col">
                            <div class="quiz-content">
                                <div class="quiz-header flex items-end flex-wrap gap-4">
                                    <div class="step-back" onclick="goToStep(6)">
                                        <span class="arrow-back"></span>&nbsp;Back
                                    </div>
                                    <div class="step-navigator">
                                        <div class="flex flex-wrap justify-between">
                                            <span class="step-progress italic">Progress</span>
                                            <span class="current-step">7/15</span>
                                        </div>
                                        <div class="bar">
                                            <div class="progress" style="width:58%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-body">
                                    <h2 class="mb-6">
                                        What's your
                                        <span class="highlight">goal weight?</span>
                                    </h2>
                                    <p class="mb-12">In pounds (lbs). Even a realistic estimate helps us personalize your plan.</p>
                                    <div class="text--input">
                                        <input type="text" name="goalWeight" placeholder="e.g. 175 lbs" id="goalWeightInput" required />
                                    </div>
                                    <div class="error-message" id="goalWeightError">Please enter your goal weight</div>
                                </div>
                                <div class="quiz-buttons">
                                    <button class="quiz-btn quiz-btn-primary" onclick="validateAndGo(7, 8)">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
