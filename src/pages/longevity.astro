---
// LONGEVITY — rebuilt in the /prototype design language, same treatment
// /weight-loss, /hair-loss and /sexual-wellness already got (see /weight-loss
// for the direction contract; this page inherits it wholesale). All images
// are the page's own existing assets under /assets/l/.
//
// EVERY DOM hook in public/assets/js/longevity.js is preserved verbatim,
// except the quiz modal: that div/script pair is gone, replaced by the
// shared <QuizModal /> component every #start-assessment* trigger now opens.
//   gallery    #mainProductImageL #prevBtnL #nextBtnL
//              #dotContainerL #thumbnailsContainerL #featuresListL
//   toggle     .medication-toggle .btn[data-medication] .active-medication
//   live text  .product-title .product-current-price .popular-badge
//   swiper     .brand--grid--hero.swiper
//   accordion  .faq-item > .faq-question   (public/style/script.js toggles .open)
//
// Deliberately NO id="start-assessment" anywhere: that id is the anchor
// public/style/script.js uses to pin a band to the viewport top on mobile
// scroll, and the new-design pages opt out (script.js is null-guarded).
//
// The wl- class prefix is the shared vertical-landing namespace: it exists
// to keep the legacy global.css / style.css cascade off this markup.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import QuizModal from '../components/QuizModal.astro';

// Peptide-goal doors — quiz-modal triggers longevity.js binds.
const goals = [
  { id: 'start-assessment1', label: 'Energy' },
  { id: 'start-assessment2', label: 'Recovery' },
  { id: 'start-assessment3', label: 'Anti-aging' },
];

// The old page's three plan cards all showed the same flat $99 — that was a
// placeholder, not real per-tier pricing. pricing.json is now the source of
// truth for every tier (longevity.default), including the new 24-month rate,
// so the ladder is rebuilt from those real numbers instead.
const plans = [
  { term: '1-month', price: '$129', save: null },
  { term: '3-month', price: '$115', save: 'Save 11%' },
  { term: '6-month', price: '$99', save: 'Save 23%' },
  { term: '12-month', price: '$89', save: 'Save 31%' },
  { term: '24-month', price: '$79', save: 'Save 39%', best: true },
];

const trustPoints = [
  'Board-Certified Physicians',
  '503A Licensed Pharmacy',
  'HIPAA Compliant',
  'HSA/FSA Accepted',
  'Free Shipping',
  'Cancel Anytime',
];

// "What's inside" cards — copy from the old page's desktop-only cards, now
// used at every breakpoint with the page's own photography.
const mechanisms = [
  {
    title: 'Cellular Energy & Repair',
    desc: 'NAD+ treatments work on the mitochondrial level to restore DNA, boost cognitive clarity, and eliminate "brain fog" mid-day.',
    img: '/assets/l/Cellular_Energy.png',
    // This photo's subjects sit lower in frame than the other two cards' —
    // default object-position:top would crop their heads out.
    pos: 'center 40%',
    tint: '#DCE5DD',
  },
  {
    title: 'Deep, Restorative Sleep',
    desc: 'Secretagogues like Sermorelin trigger your pituitary gland to naturally produce growth hormones, promoting incredibly deep sleep patterns.',
    img: '/assets/l/Deep,Restorative%20Sleep.png',
    tint: '#D6DEE8',
  },
  {
    title: 'Detox & Immunity',
    desc: 'Glutathione and customized stacks neutralize free radicals, optimize mitochondrial function, and repair DNA to promote a youthful healthspan.',
    img: '/assets/l/Detox_&_Immunity.png',
    tint: '#E4DDD4',
  },
];

// "6+ Custom Peptide Protocols" — the old page's second card row.
const proofCards = [
  { title: 'Sermorelin (Youthful markers)', img: '/assets/l/Sermorelin_(Youthful_markers).png', tint: '#E4DDD4' },
  { title: 'NAD+ (Cellular engine repair)', img: '/assets/l/NAD+_(Cellular_engine_repair).png', tint: '#D1D9DC' },
  { title: 'Glutathione (Immunity & Detox)', img: '/assets/l/Glutathione_(Immunity_&_Detox).png', tint: '#F6EEE0' },
];

// "What's Included" / "Key Benefits" — copy transcribed verbatim from
// public/assets/l/wl.png and kb.png (byte-identical to
// public/assets/brand/slide_lg_whats_included.png and slide_lg_benefits.png),
// the same "unreadable infographic slide baked into the image carousel" bug
// already fixed on weight-loss.astro and hair-loss.astro. Pulled out into
// real HTML below the product gallery instead of re-embedding the image.
const included = [
  { title: 'Sermorelin, NAD+ or Glutathione', desc: 'Premium peptide therapies' },
  { title: 'Licensed Provider Consultation', desc: 'Personalized protocol design' },
  { title: 'Monthly Supply Shipped', desc: 'Pharmaceutical-grade compounds' },
  { title: 'Ongoing Optimization', desc: 'Dosage refinement & monitoring' },
];

const keyBenefits = [
  { title: 'Enhanced Recovery', desc: 'Faster muscle & tissue repair' },
  { title: 'Improved Sleep Quality', desc: 'Deeper, more restorative rest' },
  { title: 'Increased Energy', desc: 'Natural vitality boost' },
  { title: 'Cellular Health', desc: 'Anti-aging at the molecular level' },
  { title: 'Immune Support', desc: 'Strengthened natural defenses' },
];

const press = [
  { src: '/assets/brands/bloomberg.svg', name: 'Bloomberg' },
  { src: '/assets/brands/forbes.svg', name: 'Forbes' },
  { src: '/assets/brands/new_york.svg', name: 'The New York Times' },
  { src: '/assets/brands/tech_crunch.svg', name: 'TechCrunch' },
];

// Timeline. x/y are graph.svg's own node coordinates (1143x494 viewBox) —
// longevity reuses the same flattened export hair-loss does, so the line
// geometry and stop percentages below are shared with that page verbatim.
// Copy comes from the old page's mobile-only hardcoded timeline; phase
// labels are new, short summaries of that same copy (nothing invented).
const timeline = [
  {
    x: 37,
    y: 345,
    badge: 'Weeks 1-2',
    phase: 'Sleep & Steadier Energy',
    desc: 'The earliest changes are usually noticeable in sleep depth and dream vividness. Energy levels slowly stabilize throughout the day.',
  },
  {
    x: 335,
    y: 199,
    badge: 'Weeks 3-6',
    phase: 'Faster Recovery, Sharper Focus',
    desc: 'Faster recovery from physical exertion, improved mental sharpness, and a general feeling of youthful stamina begin to establish as a new baseline.',
  },
  {
    x: 871,
    y: 66,
    badge: 'Month 3+',
    phase: 'A New Baseline',
    desc: 'Visible changes in body composition (improved proportions, reduced fat), improved skin elasticity, and sustained biological markers.',
  },
];

// Named testimonials, added after owner sign-off 2026-08-04 to expand the
// testimonial pool beyond weight-loss (MEETING-PLAN-2026-08-03.md).
// Experience-based only — no invented numeric outcomes.
const testimonials = [
  { quote: 'My doctor walked me through exactly what each peptide does before I committed to anything — no pressure, just information.', name: 'Diane F.', tag: 'Peptide therapy patient' },
  { quote: 'I’ve tried other longevity clinics that felt like a sales pitch. Freeley’s intake actually felt like medicine.', name: 'Robert C.', tag: 'Longevity patient' },
  { quote: 'Everything ships right to my door and the instructions were clear enough that I felt confident from day one.', name: 'Angela W.', tag: 'Verified patient' },
  { quote: 'The physician follow-ups are the reason I stuck with it — someone’s actually paying attention to how I’m doing.', name: 'Kevin J.', tag: 'Peptide therapy patient' },
];

// ⚠️ The old page shipped three FAQs whose answers were ALL the same
// GI-side-effects paragraph, lifted from the GLP-1 page — wrong drug class,
// wrong page. Rewritten from general peptide-therapy facts only; no medical
// claim here is invented. Flagged for owner review.
const faqs = [
  {
    q: 'What are peptides?',
    a: 'Peptides are short chains of amino acids that signal specific processes in the body — like triggering the pituitary gland to release growth hormone, or supporting cellular repair and antioxidant activity, depending on the peptide prescribed.',
  },
  {
    q: 'Are these steroids?',
    a: 'No. Peptides work differently than anabolic steroids — they signal pathways your body already has rather than introducing synthetic hormones directly. A licensed physician determines what, if anything, is appropriate during your assessment.',
  },
  {
    q: 'How are these administered?',
    a: 'Most peptide protocols are self-administered as a small subcutaneous injection at home. Your care team provides dosing instructions and supplies after your prescription is written.',
  },
];

---

<Layout title="Longevity & Peptide Therapy | Freeley">
  <Fragment slot="head">
    <style is:inline>
      /* Design tokens come from public/style/style.css :root. Everything
         below is scoped to wl- classes so no legacy rule collides. */
      .wl-page { background: var(--cream); color: var(--ink); font-family: var(--font-sans); line-height: 1.55; overflow-x: clip; }
      .wl-page img { max-width: 100%; }
      .wl-wrap { max-width: 1200px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }

      .wl-serif { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
      .wl-serif em { font-style: italic; font-weight: 600; color: #2c6b4c; }
      .wl-eyebrow { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brand); }
      .wl-price { font-family: var(--font-serif); color: var(--gold); font-weight: 600; }
      .wl-foot { font-size: 11.5px; color: var(--muted); margin-top: 16px; }

      /* ── Testimonials (named quotes, non-swiper scroll row) ───── */
      .wl-ba__grid { display: flex; gap: 20px; padding-top: 6px; padding-bottom: 16px; overflow-x: auto; }
      .wl-ba__card { background: var(--card); border-radius: 18px; padding: 16px; height: 100%; flex: 0 0 320px; }
      @media (min-width: 700px) { .wl-ba__card { flex-basis: 400px; } }
      .wl-testi__stars { color: var(--gold); font-size: 15px; letter-spacing: 2px; margin-bottom: 14px; }
      .wl-testi__quote { font-family: var(--font-serif); font-size: 1.15rem; font-style: italic; line-height: 1.45; color: var(--ink); margin: 0 0 20px; }
      .wl-testi__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .wl-testi__name { font-family: var(--font-condensed); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
      .wl-testi__tag { font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--brand); background: rgba(15,107,69,.08); border-radius: 999px; padding: 3px 9px; }

      /* Buttons — same two shapes /prototype uses. */
      .wl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; padding: 14px 24px; cursor: pointer; text-decoration: none; transition: background .15s; }
      .wl-btn:hover { background: var(--green-deep); color: #fff; }
      .wl-btn .wl-arw { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: rgba(255,255,255,.16); }
      .wl-btn--light { background: #fff; color: var(--green); border: 1px solid var(--line); }
      .wl-btn--light:hover { background: #faf8f2; color: var(--green); }
      .wl-btn--light .wl-arw { background: var(--green); color: #fff; }
      .wl-btn-ghost { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; cursor: pointer; transition: background .15s; }
      .wl-btn-ghost:hover { background: #faf8f2; color: var(--ink); }
      .wl-btn-ghost .wl-arw { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: var(--green); color: #fff; }
      .wl-page a:focus-visible, .wl-page button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 8px; }

      /* ── Hero ───────────────────────────────────────────────── */
      .wl-hero { position: relative; overflow: hidden; }
      .wl-hero__img { display: none; }
      @media (min-width: 1024px) {
        .wl-hero__img {
          display: block; position: absolute; bottom: 0;
          right: max(0px, calc(50% - 600px));
          height: min(92%, 700px); width: auto; max-width: 44%;
          object-fit: contain; object-position: right bottom;
          -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%);
          mask-image: linear-gradient(to right, transparent 0%, #000 22%);
        }
      }
      .wl-hero__inner { position: relative; z-index: 2; padding-top: 40px; padding-bottom: 64px; }
      .wl-hero__col { max-width: 560px; }
      @media (min-width: 1024px) { .wl-hero__col { max-width: 54%; } }
      .wl-hero__img-mob { display: block; width: auto; height: auto; max-height: 320px; margin: 10px auto 28px; }
      @media (min-width: 1024px) { .wl-hero__img-mob { display: none; } }
      .wl-hero h1 { font-size: clamp(2.6rem, 5.4vw, 4.2rem); line-height: 1.04; margin: 18px 0 20px; }
      .wl-hero__sub { font-size: 1.05rem; color: var(--muted); margin: 0 0 26px; max-width: 46ch; }

      .wl-badgeline { display: inline-flex; align-items: center; gap: 8px; background: rgba(15,107,69,.06); border: 1px solid rgba(15,107,69,.16); border-radius: 999px; padding: 6px 14px 6px 10px; }
      .wl-badgeline img { width: 16px; height: auto; }
      .wl-badgeline span { font-family: var(--font-condensed); font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); }

      /* Goal doors */
      .wl-goals { display: grid; gap: 10px; grid-template-columns: 1fr; margin: 0 0 14px; }
      @media (min-width: 560px) { .wl-goals { grid-template-columns: repeat(3, 1fr); } }
      .wl-goal { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 13px 18px; font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer; transition: border-color .15s, transform .15s; }
      .wl-goal:hover { border-color: var(--brand); }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) { .wl-goal:hover { transform: translateY(-2px); } }
      .wl-goal svg { flex: none; color: var(--brand); }
      .wl-notsure { font-size: 14px; color: var(--muted); margin: 0 0 6px; }
      .wl-notsure button, .wl-notsure a { background: none; border: none; padding: 0; font: inherit; font-weight: 600; color: var(--brand); cursor: pointer; text-decoration: none; }
      .wl-notsure button:hover, .wl-notsure a:hover { text-decoration: underline; }
      .wl-hero__fineprint { font-family: var(--font-condensed); font-size: 12.5px; color: var(--muted); margin: 0 0 22px; }

      .wl-hero__from { font-size: 1rem; margin: 0 0 8px; }
      .wl-hero__from .wl-price { font-size: 1.7rem; }
      .wl-hero__qual { font-family: var(--font-condensed); font-size: 12.5px; color: var(--muted); display: block; margin-top: 2px; }

      /* Plan strip — the old page's 1/3/6-month cards, restyled. Now 5 tiers
         (added 12/24-month); the 3-column grid wraps the extra two onto a
         second row rather than needing a layout change. Cards are real
         <button>s (clickable/selectable), so the reset below undoes the
         browser's default button chrome. */
      .wl-plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 4px 0 26px; }
      .wl-plans__item { display: block; width: 100%; font: inherit; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 10px; text-align: center; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
      .wl-plans__item--best { border-color: var(--brand); box-shadow: 0 6px 20px rgba(15,107,69,.10); }
      .wl-plans__item.is-selected { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand) inset; }
      .wl-plans__price { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 600; color: var(--gold); }
      .wl-plans__price span { font-size: .68rem; color: var(--muted); font-family: var(--font-sans); }
      .wl-plans__meta { display: flex; flex-direction: column; gap: 2px; margin-top: 4px; }
      .wl-plans__meta span { font-family: var(--font-condensed); font-size: 11px; color: var(--muted); }
      .wl-plans__meta b { font-size: 11px; color: var(--brand); font-weight: 700; }

      /* ── Trust bar ──────────────────────────────────────────── */
      .wl-trustbar { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .wl-trustbar ul { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; list-style: none; margin: 0; padding-top: 20px; padding-bottom: 20px; }
      @media (min-width: 900px) { .wl-trustbar ul { grid-template-columns: repeat(6, auto); justify-content: space-between; } }
      .wl-trustbar li { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 500; }
      .wl-trustbar svg { color: var(--brand); flex: none; }
      .wl-certs { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; padding-top: 18px; padding-bottom: 18px; }
      .wl-certs > span { font-family: var(--font-condensed); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .wl-certs img { height: 40px; width: auto; }

      /* ── Section furniture ──────────────────────────────────── */
      .wl-sec { padding-top: 64px; padding-bottom: 64px; }
      .wl-head { max-width: 660px; margin-bottom: 40px; }
      .wl-head--center { text-align: center; margin-left: auto; margin-right: auto; }
      .wl-head h2 { font-size: clamp(2rem, 3.8vw, 2.7rem); line-height: 1.1; margin: 14px 0 12px; }
      .wl-head p { color: var(--muted); font-size: 15px; margin: 0; }

      /* ── Inline CTA band ────────────────────────────────────── */
      .wl-band { background: var(--green); color: #fff; border-radius: 22px; padding: 34px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px; }
      .wl-band h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.6vw, 2rem); color: #fff; margin: 0 0 6px; line-height: 1.15; }
      .wl-band p { color: rgba(255,255,255,.75); font-size: 14px; margin: 0; }
      .wl-band p b { color: var(--gold); font-family: var(--font-serif); font-size: 1.15rem; }

      /* ── Mechanism / proof cards ────────────────────────────── */
      .wl-mech { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 780px) { .wl-mech { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .wl-mech__card { display: flex; flex-direction: column; height: 100%; border-radius: 18px; overflow: hidden; background: var(--card); }
      .wl-mech__img { aspect-ratio: 4 / 3; overflow: hidden; }
      .wl-mech__img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
      .wl-mech__body { padding: 20px 22px 24px; }
      .wl-mech__body h3 { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 600; margin: 0 0 8px; line-height: 1.25; }
      .wl-mech__body p { font-size: 13.5px; color: var(--muted); margin: 0; }

      /* ── Care team ──────────────────────────────────────────── */
      .wl-team__img { width: 160px; height: 160px; margin: 0 auto; border-radius: 999px; overflow: hidden; }
      .wl-team__img img { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* ── Product showcase (longevity.js-driven) ─────────────── */
      .wl-prod { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: start; }
      @media (min-width: 900px) { .wl-prod { grid-template-columns: 1fr 1fr; gap: 56px; } }
      .wl-prod__stage { background: var(--card); border-radius: 22px; padding: 22px; }
      .popular-badge { display: inline-block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; background: var(--gold); color: #fff; border-radius: 999px; padding: 5px 12px; }
      .wl-prod__frame { display: grid; place-items: center; padding: 26px 0 18px; min-height: 280px; position: relative; }
      .wl-prod__frame img { max-height: 260px; width: auto; transition: opacity .2s ease; }
      .wl-prod__frame img.fade-out { opacity: 0; }
      .wl-prod__frame img.fade-in { opacity: 1; }
      .wl-prod__nav { display: flex; align-items: center; justify-content: space-between; }
      .wl-navbtn { background: #fff; border: 1px solid var(--line); border-radius: 999px; width: 42px; height: 42px; display: grid; place-items: center; cursor: pointer; color: var(--green); transition: border-color .15s; }
      .wl-navbtn:hover { border-color: var(--brand); }
      #dotContainerL { display: flex; align-items: center; gap: 7px; }
      #dotContainerL .dot-indicator { width: 18px; height: 6px; border-radius: 999px; background: var(--line); cursor: pointer; transform: scaleX(.34); transition: transform .2s ease, background .15s ease; }
      #dotContainerL .dot-indicator.active { background: var(--brand); transform: scaleX(1); }
      #thumbnailsContainerL { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
      #thumbnailsContainerL .thumb-box { border: 1px solid var(--line); border-radius: 12px; padding: 5px; cursor: pointer; background: #fff; transition: border-color .15s; }
      #thumbnailsContainerL .thumb-box.active { border-color: var(--brand); }
      /* Label-style thumb for the 2 info slides below — same box, text
         instead of a photo since there's no product shot to preview. */
      #thumbnailsContainerL .thumb-box--label { padding: 5px 12px; display: grid; place-items: center; font-family: var(--font-condensed); font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      #thumbnailsContainerL .thumb-box--label.active { color: var(--brand); }

      /* ── Info slides — What's Included / Peptide Therapy Advantages, now
         real HTML slides INSIDE the gallery (same dots/prev/next as the
         product photos) instead of 2 extra sections stacked below the
         showcase. Only one of {img, .wl-prod__info} is visible at a time —
         see longevity.js's goTo(). ── */
      .wl-prod__info { display: none; width: 100%; padding: 0 6px; text-align: left; transition: opacity .2s ease; }
      .wl-prod__info.is-active { display: block; }
      .wl-prod__info.fade-out { opacity: 0; }
      .wl-prod__info.fade-in { opacity: 1; }
      .wl-prod__info-eyebrow { display: block; font-family: var(--font-condensed); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); margin-bottom: 14px; }
      .wl-prod__info-list { display: flex; flex-direction: column; gap: 14px; }
      .wl-prod__info-item { display: flex; align-items: flex-start; gap: 12px; }
      .wl-prod__info-item .wl-tick { margin-top: 1px; }
      .wl-prod__info-item h4 { font-size: 13.5px; font-weight: 600; margin: 0 0 3px; }
      .wl-prod__info-item p { font-size: 12.5px; color: var(--muted); margin: 0; line-height: 1.4; }

      .wl-trustpilot { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
      .wl-trustpilot span { font-family: var(--font-condensed); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
      .wl-trustpilot img { height: 18px; width: auto; }
      .product-title { font-family: var(--font-serif); font-size: clamp(1.7rem, 3vw, 2.2rem); font-weight: 600; margin: 0 0 8px; line-height: 1.15; }
      .wl-prod__lede { font-size: 14.5px; color: var(--muted); margin: 0 0 20px; }

