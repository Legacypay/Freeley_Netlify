---
import '../styles/tailwind.css';

interface Props {
  title: string;
  bodyClass?: string;
}
const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <!-- Fonts: every family the shared CSS uses (Playfair Display, Inter,
         Poppins; plus the Impeccable chrome faces Source Serif 4 + Archivo /
         Archivo Narrow from 2026-07-23), self-hosted from Google's own files by
         scripts/self-host-google-fonts.mjs (FRLY-9). It used to be four
         render-blocking stylesheets on fonts.googleapis.com, Playfair twice;
         same 94 @font-face rules and woff2 files, now same-origin. -->
    <link rel="stylesheet" href="/fonts/google/fonts.css" />
    <!-- Swiper 11.2.10, self-hosted (public/vendor/) instead of cdn.jsdelivr.net: one less origin to connect to before first paint. -->
    <link rel="stylesheet" href="/vendor/swiper-11.2.10/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/global.css" />
    <link rel="stylesheet" href="/style/style.css" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Freeley" />
    <meta property="og:image" content="https://freeley.com/assets/og/freeley-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content="https://freeley.com/assets/og/freeley-og.jpg" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
