---
import '../styles/tailwind.css';

interface Props {
  title: string;
  bodyClass?: string;
}
const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <!-- Font playfair display embed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    <!-- Font inter embed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    <!-- Font poppins embed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
    <!-- Impeccable direction (2026-07-23), site-wide chrome (Header/Footer):
         Source Serif 4 (display) + Archivo / Archivo Narrow (text/condensed),
         same faces as /prototype, loaded via CDN link here rather than
         Astro's self-hosted <Font/> — that stays opt-in per page. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400..700;1,400..700&family=Archivo:wght@400..700&family=Archivo+Narrow:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/global.css" />
    <link rel="stylesheet" href="/style/style.css" />
    <style is:global>
      /* ponytail: Tawk's minimized chat launcher renders too small on
         mobile. Widget size is normally a Tawk.to dashboard setting
         (Widget Appearance > Advanced > Mobile widget settings), not
         something in our code — the widget is a cross-origin iframe
         we can't reach into. This forces it larger via CSS on the
         outer iframe element itself, using the one selector Tawk has
         kept stable (title contains "chat"). Unsupported by Tawk;
         could stop matching on any Tawk-side widget update. Upgrade
         path: fix widget size properly in the Tawk dashboard and
         remove this. */
      @media (max-width: 767.98px) {
        iframe[title*="chat" i] {
          transform: scale(1.35);
          transform-origin: bottom right;
        }
      }
    </style>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      if (window.location.pathname.startsWith('/preview')) {
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a');
          if (!a) return;
          var href = a.getAttribute('href');
          // /assessment-quiz is excluded: QuizModal.astro attaches its own
          // click handler directly to these anchors (preventDefault + open
          // the modal). That listener runs first, but this document-level
          // listener is a SEPARATE listener and still fired afterward,
          // navigating to /preview/assessment-quiz out from under the
          // modal it had just opened. QuizModal fetches /assessment-quiz
          // directly for its content and never needs the /preview prefix.
          if (href && href.startsWith('/') && !href.startsWith('//') && !href.startsWith('/preview') && !href.startsWith('/assessment-quiz') && !href.startsWith('mailto:') && !href.startsWith('tel:')) {
            e.preventDefault();
            window.location.href = '/preview' + (href === '/' ? '' : href);
          }
        });
      }
    </script>
  </body>
</html>
